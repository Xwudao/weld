package __modname__

import (
	"context"
	"fmt"
	"strings"
	"sync"
)

// Service is the business logic the HTTP handler and the generated command group
// share. It is a small interface so a test can inject a fake and a real
// implementation can replace the demo without touching the HTTP layer.
type Service interface {
	Greet(ctx context.Context, req Request) (Response, error)
	Create(ctx context.Context, req CreateRequest) (Item, error)
}

// NewService returns the default in-memory Service.
//
// It is a replaceable development demo, not persistence: it holds no state
// across restarts and needs no database. It is the seam the Loom server graph
// binds (`loom.Provide(__modname__.NewService)`), so you may change its
// signature to take the dependencies your implementation needs, such as the
// repository the db capability declares. This package's own tests build the
// demo through NewDemoService instead, so they keep compiling after the
// signature changes. Keep the Service interface and this symbol stable.
func NewService() Service {
	return NewDemoService()
}

// NewDemoService returns the built-in in-memory demo Service.
//
// It always takes no arguments, so this package's tests keep compiling after
// NewService gains a dependency for the Loom graph. Replace NewService instead
// when you want your own implementation.
func NewDemoService() Service {
	return &demoService{}
}

// demoService is the default example implementation.
type demoService struct {
	mu   sync.Mutex
	next int
}

func (*demoService) Greet(_ context.Context, req Request) (Response, error) {
	name := strings.TrimSpace(req.Name)
	if name == "" {
		name = "world"
	}
	return Response{Module: Name, Message: fmt.Sprintf("Hello, %s!", name)}, nil
}

func (s *demoService) Create(_ context.Context, req CreateRequest) (Item, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.next++
	return Item{ID: fmt.Sprintf("%s-%d", Name, s.next), Name: req.Name}, nil
}
