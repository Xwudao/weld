// Package __modname__ is a generated HTTP business module for __name__.
//
// weld generated this package once, when `weld add module __modname__` ran, and
// recorded every file in weld.json. It is a small, replaceable example: typed
// requests and responses, a Service seam, and the routes declared in one place.
// Editing it is expected; weld never regenerates it, so your changes survive
// later `weld add` commands.
//
// The default Service is an in-memory demo. It keeps no state across restarts
// and is not persistence; replace the body of NewService in service.go with your
// own implementation, or change its signature to take a dependency (the Loom
// server graph binds it through loom.Provide, which follows the signature).
// NewDemoService is the built-in demo constructor, used by this package's own
// tests so they keep compiling after NewService changes.
//
// Every route goes through internal/httpx. A typed handler receives the bound
// request and returns the response or an error, and httpx writes the shared
// {code,msg,data} envelope: httpx.JSON for a success and httpx.Error, or a
// returned *httpx.HTTPError, for a failure. A request type that implements
// Validate runs its rules after binding. Use the router's raw route methods
// (router.Get, router.Post, ...) with httpx.RawText, httpx.Bytes or httpx.RawJSON
// for a response that must stay unwrapped; a raw route still runs the mount's
// policies, so it is not a way around the guard.
//
// The module declares only relative paths; the composition root owns the mount
// prefix, so the same module can serve /api/v1/__modname__ and /api/v2/__modname__
// without an edit here. Administrator routes carry httpx.Policy, a named policy
// the composition root defines once; this package never implements a guard, so
// authorization policy lives in one place.
//
// The handlers themselves live in handler.go, and this file is the route table:
// one statement per route, with the handler named rather than inlined, so the
// module's surface can be read at a glance and a handler is a function with a
// name of its own in a stack trace. A handler that needs the Service is a small
// constructor over it (handleGreet(service)); one that needs nothing is the bare
// function (handleHealth).
//
// Wiring is entirely through the generated internal/di graph: the server graph
// provides __modname__.NewService, mounts this module under the versioned prefix
// and defines its policies. A module added after Loom appears in the graph
// without weld editing any file here.
//
// Keep the Service interface and the NewService and NewDemoService symbols
// stable when you replace the demo.
package __modname__

import (
	nethttp "net/http"

	"__module__/internal/httpx"
)

// Name is the module's package name and URL segment. The composition root mounts
// the module under its own prefix (see internal/httpserver.ModulePrefix), so this
// package declares only relative paths.
const Name = "__modname__"

// adminPolicy is the named policy the module's administrator routes require. The
// composition root defines what the policy does (see the generated server graph
// and internal/httpserver); this package only references the name. Referencing
// an undefined policy fails at startup rather than serving the route unguarded.
const adminPolicy = "admin"

// Register installs the module's routes on router.
//
// Each route is declared once: the method, the relative path, the handler and
// any policy are together, so there is no separate route table to keep in sync.
// The handler is named rather than inlined — its body lives in handler.go — so
// this function reads as the module's route table.
//
// It takes the Service rather than constructing one, so the caller owns the
// module's dependencies and a test can inject a fake. The Loom server graph
// calls it with the Service it provides and a router mounted at the API prefix.
//
// A module whose routes span more than one prefix — a public /v1/<resource> and
// an administrator /admin/v1/<resource>, say — mounts one group per prefix
// instead, so every route stays relative and the prefix lives in one place; the
// composition root then mounts the module at the root through
// httpserver.ModulePrefix:
//
//	public := router.Group("/v1/widget")
//	public.Get("/all", handler)
//	admin := router.Group("/admin/v1/widget").Require(adminPolicy)
//	admin.Post("/create", handler)
func Register(router *httpx.Router, service Service) {
	// GET {prefix}/ — public, no input.
	httpx.NoInput(router, nethttp.MethodGet, "", handleIndex(service))

	// GET {prefix}/greet?name=Ada — public, query binding.
	httpx.Get(router, "/greet", handleGreet(service))

	// POST {prefix}/admin/items — administrator. The named policy rejects an
	// unauthenticated caller before the handler runs; the JSON body is bound and
	// validated, then handleCreateItem creates the item.
	httpx.Post(router, "/admin/items", handleCreateItem(service), httpx.Policy(adminPolicy), httpx.WithStatus(nethttp.StatusCreated))

	// GET {prefix}/health — the raw escape hatch: a response that must not be
	// wrapped in the JSON envelope. The raw Get method keeps the method out of the
	// path, so the path stays a plain constant.
	router.Get("/health", handleHealth)
}
