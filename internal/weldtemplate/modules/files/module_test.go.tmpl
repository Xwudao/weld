package __modname__

import (
	"encoding/json"
	nethttp "net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"__module__/internal/httpx"
)

// testPrefix is the prefix the tests mount the module under. The module itself
// declares only relative paths, so the test owns the prefix.
const testPrefix = "/api/" + Name

// envelope is the decoded {code,msg,data} response body.
type envelope struct {
	Code int             `json:"code"`
	Msg  string          `json:"msg"`
	Data json.RawMessage `json:"data"`
}

// newTestMux mounts the module and defines its admin policy with a test guard,
// so the routes are exercised in process with no socket and no database.
func newTestMux() *nethttp.ServeMux {
	mux := nethttp.NewServeMux()
	router := httpx.NewRouter(mux).
		WithPolicy(adminPolicy, testAdminGuard).
		Group(testPrefix)
	Register(router, NewDemoService())
	return mux
}

// testAdminGuard mirrors the shipped placeholder policy: a non-empty bearer
// token is accepted and anything else is rejected before the handler runs.
func testAdminGuard(next nethttp.Handler) nethttp.Handler {
	return nethttp.HandlerFunc(func(w nethttp.ResponseWriter, r *nethttp.Request) {
		authorization := r.Header.Get("Authorization")
		if !strings.HasPrefix(authorization, "Bearer ") || strings.TrimSpace(strings.TrimPrefix(authorization, "Bearer ")) == "" {
			httpx.Error(w, nethttp.StatusUnauthorized, "authentication required")
			return
		}
		next.ServeHTTP(w, r)
	})
}

func serve(t *testing.T, method, target, body string) *httptest.ResponseRecorder {
	t.Helper()
	var request *nethttp.Request
	if body == "" {
		request = httptest.NewRequest(method, target, nil)
	} else {
		request = httptest.NewRequest(method, target, strings.NewReader(body))
		request.Header.Set("Content-Type", "application/json")
	}
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, request)
	return recorder
}

func decode(t *testing.T, recorder *httptest.ResponseRecorder) envelope {
	t.Helper()
	var body envelope
	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode envelope: %v (%s)", err, recorder.Body)
	}
	return body
}

// TestPublicGetGreetsWorldByDefault proves the no-input route answers without a
// query parameter and writes the shared success envelope.
func TestPublicGetGreetsWorldByDefault(t *testing.T) {
	recorder := serve(t, nethttp.MethodGet, testPrefix, "")
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET %s = %d: %s", testPrefix, recorder.Code, recorder.Body)
	}
	body := decode(t, recorder)
	if body.Code != nethttp.StatusOK || body.Msg != httpx.SuccessMsg {
		t.Fatalf("envelope = %+v", body)
	}
	var response Response
	if err := json.Unmarshal(body.Data, &response); err != nil {
		t.Fatalf("decode data: %v", err)
	}
	if response.Module != "__modname__" || response.Message != "Hello, world!" {
		t.Fatalf("response = %+v, want the default greeting", response)
	}
}

// TestPublicGetBindsQuery proves the query-oriented route binds ?name= into the
// typed request before the handler runs.
func TestPublicGetBindsQuery(t *testing.T) {
	recorder := serve(t, nethttp.MethodGet, testPrefix+"/greet?name=Ada", "")
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET greet = %d: %s", recorder.Code, recorder.Body)
	}
	var response Response
	if err := json.Unmarshal(decode(t, recorder).Data, &response); err != nil {
		t.Fatalf("decode data: %v", err)
	}
	if response.Message != "Hello, Ada!" {
		t.Fatalf("message = %q, want it to greet Ada", response.Message)
	}
}

// TestAdminPolicyRejectsUnauthenticated proves the named policy refuses the
// request with 401 before the handler or the body binder runs.
func TestAdminPolicyRejectsUnauthenticated(t *testing.T) {
	recorder := serve(t, nethttp.MethodPost, testPrefix+"/admin/items", `{"name":"widget"}`)
	if recorder.Code != nethttp.StatusUnauthorized {
		t.Fatalf("status = %d, want 401: %s", recorder.Code, recorder.Body)
	}
	body := decode(t, recorder)
	if body.Code != nethttp.StatusUnauthorized || body.Msg == "" {
		t.Fatalf("envelope = %+v, want the policy's message", body)
	}
}

// TestAdminValidatesBody proves the request's Validate runs after binding: an
// empty name is a 400 envelope.
func TestAdminValidatesBody(t *testing.T) {
	request := httptest.NewRequest(nethttp.MethodPost, testPrefix+"/admin/items", strings.NewReader(`{"name":"  "}`))
	request.Header.Set("Content-Type", "application/json")
	request.Header.Set("Authorization", "Bearer test-token")
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, request)
	if recorder.Code != nethttp.StatusBadRequest {
		t.Fatalf("status = %d, want 400: %s", recorder.Code, recorder.Body)
	}
	if body := decode(t, recorder); body.Msg != "name must not be empty" {
		t.Fatalf("envelope = %+v, want the validation message", body)
	}
}

// TestAdminCreatesItem proves a valid authenticated request binds the JSON body,
// passes validation and writes the 201 the route configured.
func TestAdminCreatesItem(t *testing.T) {
	request := httptest.NewRequest(nethttp.MethodPost, testPrefix+"/admin/items", strings.NewReader(`{"name":"widget"}`))
	request.Header.Set("Content-Type", "application/json")
	request.Header.Set("Authorization", "Bearer test-token")
	recorder := httptest.NewRecorder()
	newTestMux().ServeHTTP(recorder, request)
	if recorder.Code != nethttp.StatusCreated {
		t.Fatalf("status = %d, want 201: %s", recorder.Code, recorder.Body)
	}
	body := decode(t, recorder)
	if body.Code != nethttp.StatusCreated {
		t.Fatalf("code = %d, want 201", body.Code)
	}
	var item Item
	if err := json.Unmarshal(body.Data, &item); err != nil {
		t.Fatalf("decode data: %v", err)
	}
	if item.ID == "" || item.Name != "widget" {
		t.Fatalf("item = %+v", item)
	}
}

// TestHealthStaysRaw proves the raw escape hatch writes an unwrapped response.
func TestHealthStaysRaw(t *testing.T) {
	recorder := serve(t, nethttp.MethodGet, testPrefix+"/health", "")
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("status = %d, want 200", recorder.Code)
	}
	if recorder.Body.String() != "ok" {
		t.Fatalf("body = %q, want the raw text", recorder.Body.String())
	}
	if strings.Contains(recorder.Body.String(), "code") {
		t.Fatalf("the raw response was wrapped: %s", recorder.Body)
	}
}
