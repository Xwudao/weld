package __modname__

import (
	"encoding/json"
	nethttp "net/http"
	"net/http/httptest"
	"reflect"
	"sort"
	"strings"
	"testing"

	"__module__/internal/httpx"
	"__module__/internal/openapi"
)

// envelope is the decoded {code,msg,data} response body.
type envelope struct {
	Code int             `json:"code"`
	Msg  string          `json:"msg"`
	Data json.RawMessage `json:"data"`
}

// TestRegisterServesGreeting exercises the module handler in process with
// net/http/httptest: no socket and no database. It builds the service through
// NewDemoService, the always zero-argument demo constructor, so it keeps
// compiling after NewService gains a dependency for the Loom graph. It also
// pins the shared response envelope.
func TestRegisterServesGreeting(t *testing.T) {
	mux := nethttp.NewServeMux()
	Register(mux, NewDemoService())

	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, RoutePrefix+"?name=Ada", nil))
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET %s = %d: %s", RoutePrefix, recorder.Code, recorder.Body)
	}
	var body envelope
	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	if body.Code != nethttp.StatusOK || body.Msg != httpx.SuccessMsg {
		t.Fatalf("envelope = %+v", body)
	}
	var response Response
	if err := json.Unmarshal(body.Data, &response); err != nil {
		t.Fatalf("decode data: %v", err)
	}
	if response.Module != "__modname__" || response.Message != "Hello, Ada!" {
		t.Fatalf("response = %+v, want the module greeting", response)
	}
}

// TestRegisterGreetsWorldByDefault checks the endpoint works without the
// optional query parameter, so an unconfigured deployment still answers.
func TestRegisterGreetsWorldByDefault(t *testing.T) {
	mux := nethttp.NewServeMux()
	Register(mux, NewDemoService())

	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, RoutePrefix, nil))
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET %s = %d", RoutePrefix, recorder.Code)
	}
}

// TestContractMatchesRoute proves the route table and the OpenAPI contract
// agree: every operation Register installs on the mux is registered with the
// shared internal/openapi contract under the same method and path, so the
// document cannot claim an endpoint the module does not serve.
func TestContractMatchesRoute(t *testing.T) {
	registered := map[string]openapi.Operation{}
	for _, operation := range openapi.Operations() {
		registered[operation.Method+" "+operation.Path] = operation
	}
	for _, op := range operations() {
		contract, ok := registered[op.method+" "+op.path]
		if !ok {
			t.Errorf("%s %s is served but not registered in the shared openapi contract", op.method, op.path)
			continue
		}
		if contract.OperationID == "" || contract.SuccessStatus == 0 || contract.Success == nil {
			t.Errorf("%s %s contract is incomplete: %+v", op.method, op.path, contract)
		}
	}
}

// TestContractDocumentsTheResponseDTO guards against drift between the module's
// Response DTO and the documented success schema: the schema must name exactly
// the DTO's JSON fields, so changing one without the other turns this red.
func TestContractDocumentsTheResponseDTO(t *testing.T) {
	contract := greetingContract()
	if contract.Success == nil {
		t.Fatal("the greeting contract documents no success response")
	}
	schema, err := contract.Success()
	if err != nil {
		t.Fatalf("success schema: %v", err)
	}
	got := schemaFieldNames(schema)
	want := jsonFieldNames(Response{})
	if strings.Join(got, ",") != strings.Join(want, ",") {
		t.Fatalf("documented success fields = %v, Response JSON fields = %v", got, want)
	}
}

// jsonFieldNames returns the JSON names of a struct's fields, sorted.
func jsonFieldNames(value any) []string {
	typ := reflect.TypeOf(value)
	names := make([]string, 0, typ.NumField())
	for i := 0; i < typ.NumField(); i++ {
		name := strings.Split(typ.Field(i).Tag.Get("json"), ",")[0]
		if name == "" || name == "-" {
			continue
		}
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

// schemaFieldNames returns an object schema's property names, sorted.
func schemaFieldNames(schema *openapi.Schema) []string {
	names := make([]string, 0, len(schema.Properties))
	for name := range schema.Properties {
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}
