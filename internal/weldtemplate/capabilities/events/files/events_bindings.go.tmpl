package di

import (
	"fmt"

	"__module__/internal/events"
)

// NewEventListenerDispatcher exposes the publisher's underlying dispatcher for
// business listener wiring. It never creates a second dispatcher. Keeping this
// adapter separate from NewEventDispatcher lets consumer services also publish,
// and works with the existing stable events_provider.go seam in older projects.
func NewEventListenerDispatcher(publisher events.Publisher) (*events.Dispatcher, error) {
	dispatcher, ok := events.DispatcherOf(publisher)
	if !ok {
		return nil, fmt.Errorf("events: publisher %T does not support in-process listeners", publisher)
	}
	return dispatcher, nil
}
