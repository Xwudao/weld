func TestStopDrainsBufferedEvents(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	var delivered atomic.Int64
	On(inner, func(context.Context, orderPaid) error {
		delivered.Add(1)
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(16))
	async.Start(context.Background())

	const total = 8
	for i := 0; i < total; i++ {
		if err := async.Publish(context.Background(), orderPaid{ID: "x"}); err != nil {
			t.Fatalf("Publish: %v", err)
		}
	}
	if err := async.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	if got := delivered.Load(); got != total {
		t.Fatalf("delivered %d of %d events before Stop returned", got, total)
	}
}

func TestStopReturnsWhenAListenerOverruns(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	entered := make(chan struct{})
	release := make(chan struct{})
	On(inner, func(context.Context, orderPaid) error {
		close(entered)
		<-release
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(1))
	async.Start(context.Background())
	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	<-entered

	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if err := async.Stop(ctx); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("Stop = %v, want context.DeadlineExceeded", err)
	}

	close(release)
	if err := async.Stop(context.Background()); err != nil {
		t.Fatalf("second Stop: %v", err)
	}
}

func TestPublishAfterStopIsRejected(t *testing.T) {
	t.Parallel()
	async := NewAsync(New(nil), nil)
	async.Start(context.Background())
	if err := async.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); !errors.Is(err, ErrStopped) {
		t.Fatalf("Publish after Stop = %v, want ErrStopped", err)
	}
	if err := async.TryPublish(orderPaid{ID: "1"}); !errors.Is(err, ErrStopped) {
		t.Fatalf("TryPublish after Stop = %v, want ErrStopped", err)
	}
}

func TestAsyncNilSafety(t *testing.T) {
	t.Parallel()
	var absent *Async
	if err := absent.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("nil Async Publish: %v", err)
	}
	if err := absent.TryPublish(orderPaid{ID: "1"}); err != nil {
		t.Fatalf("nil Async TryPublish: %v", err)
	}
	absent.Start(context.Background())
	if err := absent.Stop(context.Background()); err != nil {
		t.Fatalf("nil Async Stop: %v", err)
	}
	if got := absent.Stats(); got.Capacity != 0 {
		t.Fatalf("nil Async Stats = %+v", got)
	}

	async := NewAsync(New(nil), nil)
	if err := async.Publish(context.Background(), nil); err != nil {
		t.Fatalf("Publish(nil event): %v", err)
	}
	if err := async.TryPublish(nil); err != nil {
		t.Fatalf("TryPublish(nil event): %v", err)
	}
}

func TestNewAsyncRejectsNonPositiveCapacityAndWorkers(t *testing.T) {
	t.Parallel()
	for name, option := range map[string]AsyncOption{
		"capacity": WithCapacity(0),
		"workers":  WithWorkers(0),
	} {
		func() {
			defer func() {
				if recover() == nil {
					t.Errorf("NewAsync accepted %s of zero", name)
				}
			}()
			NewAsync(New(nil), nil, option)
		}()
	}
}

func TestStatsReportDeliveryAndRefusal(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	blocked := make(chan struct{})
	entered := make(chan struct{})
	On(inner, func(context.Context, orderPaid) error {
		close(entered)
		<-blocked
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(1))
	async.Start(context.Background())
	defer func() {
		close(blocked)
		async.Stop(context.Background())
	}()

	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	<-entered
	if err := async.Publish(context.Background(), orderPaid{ID: "2"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	if err := async.TryPublish(orderPaid{ID: "3"}); !errors.Is(err, ErrQueueFull) {
		t.Fatalf("TryPublish = %v, want ErrQueueFull", err)
	}

	stats := async.Stats()
	if stats.Capacity != 1 || stats.Workers != 1 {
		t.Fatalf("Stats capacity/workers = %d/%d", stats.Capacity, stats.Workers)
	}
	if stats.Published != 2 || stats.Refused != 1 {
		t.Fatalf("Stats published/refused = %d/%d, want 2/1", stats.Published, stats.Refused)
	}
}

// TestAsyncIsSafeUnderConcurrentUse exercises the documented guards with the
// race detector: registrations, publishes, TryPublishes and stats at once.
func TestAsyncIsSafeUnderConcurrentUse(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	On(inner, func(context.Context, orderPaid) error { return nil })
	async := NewAsync(inner, nil, WithCapacity(4), WithWorkers(2))
	async.Start(context.Background())

	var wg sync.WaitGroup
	for i := 0; i < 8; i++ {
		wg.Add(3)
		go func() {
			defer wg.Done()
			for j := 0; j < 50; j++ {
				_ = async.Publish(context.Background(), orderPaid{ID: "1"})
			}
		}()
		go func() {
			defer wg.Done()
			for j := 0; j < 50; j++ {
				_ = async.TryPublish(orderPaid{ID: "2"})
			}
		}()
		go func() {
			defer wg.Done()
			for j := 0; j < 50; j++ {
				_ = async.Stats()
			}
		}()
	}
	wg.Wait()
	if err := async.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
}

