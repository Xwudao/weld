// waitFor polls until condition holds or the deadline passes. Delivery is
// asynchronous, so a test synchronizes on the effect rather than on a sleep.
func waitFor(t *testing.T, condition func() bool) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		if condition() {
			return
		}
		time.Sleep(time.Millisecond)
	}
	t.Fatal("condition was never met")
}

func TestAsyncDeliversThroughTheDispatcher(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	var delivered atomic.Int64
	On(inner, func(_ context.Context, event orderPaid) error {
		if event.ID == "1" {
			delivered.Add(1)
		}
		return nil
	})
	async := NewAsync(inner, nil)
	async.Start(context.Background())
	defer async.Stop(context.Background())

	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	waitFor(t, func() bool { return delivered.Load() == 1 })
}

// TestAsyncListenerContextIsNotThePublishContext proves the request context is
// not propagated: the publish context is cancelled right after Publish returns,
// and the listener must still observe a live context. A bare goroutine that
// reused the request context would fail this.
func TestAsyncListenerContextIsNotThePublishContext(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	observed := make(chan error, 1)
	On(inner, func(ctx context.Context, _ orderPaid) error {
		observed <- ctx.Err()
		return nil
	})
	async := NewAsync(inner, nil)
	async.Start(context.Background())
	defer async.Stop(context.Background())

	ctx, cancel := context.WithCancel(context.Background())
	if err := async.Publish(ctx, orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	cancel()

	select {
	case err := <-observed:
		if err != nil {
			t.Fatalf("the listener context was cancelled by the publish context: %v", err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("the listener never ran")
	}
}

func TestTryPublishReportsAFullQueue(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	blocked := make(chan struct{})
	entered := make(chan struct{})
	On(inner, func(context.Context, orderPaid) error {
		close(entered)
		<-blocked
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(1))
	async.Start(context.Background())
	defer func() {
		close(blocked)
		async.Stop(context.Background())
	}()

	// First event occupies the worker, second fills the one-slot buffer.
	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	<-entered
	if err := async.Publish(context.Background(), orderPaid{ID: "2"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	if err := async.TryPublish(orderPaid{ID: "3"}); !errors.Is(err, ErrQueueFull) {
		t.Fatalf("TryPublish = %v, want ErrQueueFull", err)
	}
}

func TestPublishBlocksWhileFullAndUnblocksWhenDrained(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	release := make(chan struct{})
	delivered := make(chan string, 3)
	On(inner, func(_ context.Context, event orderPaid) error {
		delivered <- event.ID
		<-release
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(1))
	async.Start(context.Background())
	defer async.Stop(context.Background())

	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	<-delivered // the worker is now inside the listener
	if err := async.Publish(context.Background(), orderPaid{ID: "2"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}

	published := make(chan error, 1)
	go func() { published <- async.Publish(context.Background(), orderPaid{ID: "3"}) }()
	select {
	case err := <-published:
		t.Fatalf("Publish returned %v while the queue was full", err)
	case <-time.After(25 * time.Millisecond):
	}

	close(release)
	select {
	case err := <-published:
		if err != nil {
			t.Fatalf("Publish after drain: %v", err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("Publish stayed blocked after the queue drained")
	}
}

func TestPublishRespectsItsContextWhileFull(t *testing.T) {
	t.Parallel()
	inner := New(nil)
	blocked := make(chan struct{})
	entered := make(chan struct{})
	On(inner, func(context.Context, orderPaid) error {
		close(entered)
		<-blocked
		return nil
	})
	async := NewAsync(inner, nil, WithCapacity(1))
	async.Start(context.Background())
	defer func() {
		close(blocked)
		async.Stop(context.Background())
	}()

	if err := async.Publish(context.Background(), orderPaid{ID: "1"}); err != nil {
		t.Fatalf("Publish: %v", err)
	}
	<-entered
	if err := async.Publish(context.Background(), orderPaid{ID: "2"}); err != nil {
