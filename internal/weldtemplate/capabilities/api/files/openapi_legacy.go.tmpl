package openapi

import "net/http"

// LegacyResponse describes the HTTP-200 business-code envelope shared by the
// migrated modules. Transport errors remain HTTP 200; the code distinguishes
// a successful response from a bind/validation/repository failure.
func LegacyResponse(data *Schema, failureMessages ...string) Response {
	messages := make([]any, 0, len(failureMessages))
	for _, message := range failureMessages {
		messages = append(messages, message)
	}
	return Response{
		Description: "Legacy envelope: HTTP 200; code 200 on success or 0 on failure.",
		Schema: &Schema{OneOf: []*Schema{
			envelope(200, []any{"请求成功"}, data),
			envelope(0, messages, &Schema{Enum: []any{nil}, Nullable: true}),
		}},
	}
}

// LegacyForbiddenResponse matches the shared admin guard's 403 envelope; it
// never contains the user's token or a sensitive configuration value.
func LegacyForbiddenResponse() Response {
	return Response{
		Description: "Missing, invalid, banned or non-administrator access token.",
		Schema: envelope(http.StatusForbidden,
			[]any{"please login first", "账号已被封禁", "you don't have permission to do this"},
			&Schema{Enum: []any{nil}, Nullable: true}),
	}
}

func envelope(code int, messages []any, data *Schema) *Schema {
	return &Schema{
		Type: "object",
		Properties: map[string]*Schema{
			"code": {Type: "integer", Enum: []any{code}},
			"msg":  {Type: "string", Enum: messages},
			"data": data,
		},
		Required: []string{"code", "msg", "data"},
	}
}
