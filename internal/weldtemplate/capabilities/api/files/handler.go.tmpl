package api

import (
	"context"
	"errors"
	nethttp "net/http"

	"__module__/internal/httpx"
)

// maxBodyBytes bounds a JSON request body. It is the shared default, so every
// generated handler binds bodies the same way.
const maxBodyBytes = httpx.DefaultMaxBytes

// Handler returns the API as a plain http.Handler with the given service.
//
// It mounts the API at the default /api prefix and is the injectable seam for
// tests: build a Handler with a fake Service and exercise it with
// net/http/httptest, with no socket and no database. The generated server graph
// mounts the API itself with Register, so a project can change the prefix.
func Handler(service Service) nethttp.Handler {
	mux := nethttp.NewServeMux()
	Register(httpx.NewRouter(mux).Group(defaultPrefix), service)
	return mux
}

// defaultPrefix is the mount Handler uses. The server graph passes its own
// prefix (see internal/httpserver.APIPrefix) so the surface can be versioned.
const defaultPrefix = "/api"

// Register installs every API route on router.
//
// The caller owns the mount prefix, so the same routes can serve /api/v1/items
// and /api/v2/items without changing this package. Each route is declared once:
// the method, the relative path, the request binding and the handler are one
// statement, so there is no separate route table to keep in sync.
func Register(router *httpx.Router, service Service) {
	// GET {prefix}/items?limit=...
	httpx.Get(router, "/items", func(ctx context.Context, query ListItemsQuery) ([]ItemResponse, error) {
		limit := defaultLimit
		if query.Limit != nil {
			limit = *query.Limit
		}
		return service.List(ctx, limit)
	})

	// POST {prefix}/items
	httpx.Post(router, "/items", func(ctx context.Context, request CreateItemRequest) (ItemResponse, error) {
		return service.Create(ctx, request)
	}, httpx.WithStatus(nethttp.StatusCreated), httpx.WithMaxBytes(maxBodyBytes))

	// GET {prefix}/items/{id}
	httpx.Get(router, "/items/{id}", func(ctx context.Context, request GetItemRequest) (ItemResponse, error) {
		item, err := service.Get(ctx, request.ID)
		if errors.Is(err, ErrNotFound) {
			// Map the domain sentinel to a transport status and a client-safe
			// message; every other error stays a generic 500.
			return ItemResponse{}, httpx.NotFound(err.Error())
		}
		return item, err
	})
}
