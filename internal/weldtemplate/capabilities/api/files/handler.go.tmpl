package api

import (
	"errors"
	"net/http"

	"github.com/Xwudao/go-validate"

	"__module__/internal/httpx"
)

// openAPIPath is the endpoint that serves the generated document.
const openAPIPath = "/api/openapi.json"

// maxBodyBytes bounds a JSON request body. It is the shared default, so every
// generated handler binds bodies the same way.
const maxBodyBytes = httpx.DefaultMaxBytes

// Handler returns the API as a plain http.Handler with the given service.
//
// It is the injectable seam for tests: build a Handler with a fake Service and
// exercise it with net/http/httptest, with no socket and no database.
func Handler(service Service) http.Handler {
	mux := http.NewServeMux()
	Register(mux, service)
	return mux
}

// Register installs every API route on mux, including the OpenAPI endpoint.
//
// Routes come from operations(), the same table the document is built from, so
// a route cannot exist undocumented and an operation cannot exist unrouted.
func Register(mux *http.ServeMux, service Service) {
	for _, operation := range operations() {
		mux.HandleFunc(operation.route(), operation.handle(service))
	}
	mux.HandleFunc("GET "+openAPIPath, openAPIHandler)
}

// speced is a DTO that declares its go-validate Spec. The Spec is the single
// source for both runtime validation and the OpenAPI constraints.
type speced interface {
	Spec() validate.Spec
}

// decodeBody decodes and validates a JSON request body using the shared binding
// helper and the same Spec used for documentation.
//
// httpx owns the transport checks — content type, body size, JSON syntax, a
// second value or unknown field — and maps each to a real transport status; the
// Spec is passed as the code-first validator callback, so this package keeps
// its go-validate dependency while httpx stays free of it. Any failure is
// written to w and reported false.
func decodeBody[T speced](w http.ResponseWriter, r *http.Request) (T, bool) {
	var zero T
	body, err := httpx.DecodeJSON(r, maxBodyBytes, func(value T) error {
		return value.Spec().Validate()
	})
	if err != nil {
		httpx.WriteError(w, err)
		return zero, false
	}
	return body, true
}

func createItemHandler(service Service) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		request, ok := decodeBody[CreateItemRequest](w, r)
		if !ok {
			return
		}
		item, err := service.Create(r.Context(), request)
		if err != nil {
			writeServiceError(w, err)
			return
		}
		httpx.JSON(w, http.StatusCreated, item)
	}
}

func listItemsHandler(service Service) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		query := listItemsQuery{}
		limit, present, err := httpx.QueryInt(r, "limit")
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if present {
			query.Limit = &limit
		}
		if err := query.Spec().Validate(); err != nil {
			httpx.Error(w, http.StatusBadRequest, err.Error())
			return
		}
		effective := defaultLimit
		if present {
			effective = limit
		}
		items, err := service.List(r.Context(), effective)
		if err != nil {
			writeServiceError(w, err)
			return
		}
		httpx.JSON(w, http.StatusOK, items)
	}
}

func getItemHandler(service Service) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		item, err := service.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			writeServiceError(w, err)
			return
		}
		httpx.JSON(w, http.StatusOK, item)
	}
}

// openAPIHandler serves the OpenAPI 3.1 document. It is rebuilt per request so
// a contract error surfaces as a 500 rather than a silently stale document.
//
// The document is a complete artifact for tooling to consume, so it is written
// raw with httpx.RawJSON and is deliberately not wrapped in the response
// envelope: a spec generator must receive the OpenAPI document itself.
func openAPIHandler(w http.ResponseWriter, _ *http.Request) {
	document, err := Document()
	if err != nil {
		httpx.Error(w, http.StatusInternalServerError, "openapi document unavailable")
		return
	}
	httpx.RawJSON(w, http.StatusOK, document)
}

// writeServiceError maps a Service error to a response envelope. ErrNotFound is
// a 404; every other error is a generic 500 and never leaks the internal
// message.
func writeServiceError(w http.ResponseWriter, err error) {
	if errors.Is(err, ErrNotFound) {
		httpx.Error(w, http.StatusNotFound, err.Error())
		return
	}
	httpx.Error(w, http.StatusInternalServerError, "internal error")
}
