	// weld:api:installed __version__
	// kin-openapi validates the generated document in tests only. It is pinned
	// to the newest release that supports OpenAPI 3.1 without raising the Go
	// toolchain floor of the generated project.
	require github.com/Xwudao/go-validate v0.2.0
	require github.com/getkin/kin-openapi v0.128.0
