// Package api is the JSON HTTP contract of __name__.
//
// It owns the typed request and response DTOs, the go-validate Spec that
// validates them, the explicit route table, and the OpenAPI 3.1 document
// derived from the very same declarations. The HTTP surface is a plain
// http.Handler, so it is exercised with net/http/httptest and an injected
// Service; it opens no socket and needs no database.
//
// The DTOs carry JSON serialization tags only. Validation rules live in one
// place, the Spec method, which feeds both runtime validation and the OpenAPI
// constraints. Responses are wrapped in the shared {code,msg,data} envelope by
// internal/httpx; request bodies are the DTOs themselves, unwrapped.
package api

import (
	"github.com/Xwudao/go-validate"
)

// ItemStatus is the closed set of item states.
//
// Go has no native enum, so the convention is a defined string type plus named
// constants. The OpenAPI enum is exported from the very same Spec that
// validates the field, so the allowed values are declared once. If this
// boilerplate repeats across many resources, a future `weld add enum` step (or
// go-enum code generation) could produce the alias, constants and values
// function; this capability deliberately does not grow its own enum framework.
type ItemStatus string

const (
	ItemStatusDraft    ItemStatus = "draft"
	ItemStatusActive   ItemStatus = "active"
	ItemStatusArchived ItemStatus = "archived"
)

// itemStatuses lists every valid status. Append here and both runtime
// validation and the OpenAPI enum follow.
var itemStatuses = []ItemStatus{ItemStatusDraft, ItemStatusActive, ItemStatusArchived}

// itemStatusValues returns the status values as the plain strings go-validate
// accepts, so the enum is sourced from the named constants above.
func itemStatusValues() []string {
	values := make([]string, len(itemStatuses))
	for i, status := range itemStatuses {
		values[i] = string(status)
	}
	return values
}

// CreateItemRequest is the POST /api/items request body.
type CreateItemRequest struct {
	Name     string     `json:"name"`
	Quantity int        `json:"quantity"`
	Status   ItemStatus `json:"status"`
}

// Spec declares the request rules once. Validate enforces them and Schema
// exports the same constraints to the OpenAPI document.
func (r CreateItemRequest) Spec() validate.Spec {
	return validate.Spec{
		validate.String("name", r.Name, validate.NonEmpty(), validate.MaxRunes(100)),
		validate.Int("quantity", r.Quantity, validate.MinValue(1), validate.MaxValue(1000)),
		// The enum is sourced from the named constants, so an invalid status is
		// rejected and the same values are documented. go-validate's Spec
		// constructors are typed to the built-in string kind, so the defined
		// type is cast here, at the DTO boundary; a generic
		// validate.StringField[T ~string] would remove the cast, which is a
		// future go-validate improvement rather than something to fork here.
		validate.String("status", string(r.Status), validate.Enum(itemStatusValues()...)),
	}
}

// ItemResponse is the representation returned for an item.
type ItemResponse struct {
	ID       string     `json:"id"`
	Name     string     `json:"name"`
	Quantity int        `json:"quantity"`
	Status   ItemStatus `json:"status"`
}

// Spec is the response field contract. It is the same metadata that describes
// the success response body in the OpenAPI document.
func (r ItemResponse) Spec() validate.Spec {
	return validate.Spec{
		validate.String("id", r.ID, validate.NonEmpty()),
		validate.String("name", r.Name, validate.NonEmpty()),
		validate.Int("quantity", r.Quantity, validate.MinValue(1)),
		validate.String("status", string(r.Status), validate.Enum(itemStatusValues()...)),
	}
}

// List limits for GET /api/items.
const (
	minLimit     = 1
	maxLimit     = 100
	defaultLimit = 20
)

// listItemsQuery is the query contract for GET /api/items. It has no JSON body;
// the tag keeps the field name identical to the query and Spec name.
type listItemsQuery struct {
	Limit *int `json:"limit"`
}

// Spec validates the optional limit with the same metadata that documents the
// limit query parameter. A nil limit means the parameter was absent.
func (q listItemsQuery) Spec() validate.Spec {
	return validate.Spec{
		validate.OptionalInt("limit", q.Limit, validate.MinValue(minLimit), validate.MaxValue(maxLimit)),
	}
}
