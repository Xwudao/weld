// Package api is the JSON HTTP contract of __name__.
//
// It owns the typed request and response DTOs, the validation each request
// performs before it reaches the Service, and the routes that expose them. The
// HTTP surface is a plain http.Handler, so it is exercised with
// net/http/httptest and an injected Service; it opens no socket and needs no
// database.
//
// Routes are registered with internal/httpx. A typed handler receives the bound
// request and returns the response or an error, and httpx writes the shared
// {code,msg,data} envelope; a DTO that implements Validate runs its rules
// automatically after binding, so the handler never repeats them.
package api

import (
	"fmt"

	"github.com/Xwudao/go-validate"
)

// ItemStatus is the closed set of item states.
//
// Go has no native enum, so the convention is a defined string type plus named
// constants. The allowed values are declared once here and reused by the
// request validation.
type ItemStatus string

const (
	ItemStatusDraft    ItemStatus = "draft"
	ItemStatusActive   ItemStatus = "active"
	ItemStatusArchived ItemStatus = "archived"
)

// itemStatuses lists every valid status. Append here and validation follows.
var itemStatuses = []ItemStatus{ItemStatusDraft, ItemStatusActive, ItemStatusArchived}

// itemStatusValues returns the status values as the plain strings go-validate
// accepts, so the enum is sourced from the named constants above.
func itemStatusValues() []string {
	values := make([]string, len(itemStatuses))
	for i, status := range itemStatuses {
		values[i] = string(status)
	}
	return values
}

// CreateItemRequest is the POST /api/items request body.
type CreateItemRequest struct {
	Name     string     `json:"name"`
	Quantity int        `json:"quantity"`
	Status   ItemStatus `json:"status"`
}

// Validate enforces the request rules with go-validate. internal/httpx calls it
// after binding, so a failure becomes a 400 envelope without a manual check and
// the rules live next to the fields they describe.
func (r CreateItemRequest) Validate() error {
	// go-validate's Spec constructors are typed to the built-in string kind, so
	// the defined type is cast at the DTO boundary.
	return validate.Spec{
		validate.String("name", r.Name, validate.NonEmpty(), validate.MaxRunes(100)),
		validate.Int("quantity", r.Quantity, validate.MinValue(1), validate.MaxValue(1000)),
		validate.String("status", string(r.Status), validate.Enum(itemStatusValues()...)),
	}.Validate()
}

// ItemResponse is the representation returned for an item.
type ItemResponse struct {
	ID       string     `json:"id"`
	Name     string     `json:"name"`
	Quantity int        `json:"quantity"`
	Status   ItemStatus `json:"status"`
}

// List limits for GET /api/items.
const (
	minLimit     = 1
	maxLimit     = 100
	defaultLimit = 20
)

// ListItemsQuery is the query contract for GET /api/items.
//
// The query tag is what internal/httpx binds: a field is bound only when it
// declares a query tag, so the wire contract is explicit. Limit is a pointer, so
// an absent parameter is distinguishable from an explicit zero.
type ListItemsQuery struct {
	Limit *int `query:"limit"`
}

// Validate checks the optional limit. A nil limit means the parameter was
// absent, so it is valid and the handler applies the default.
func (q ListItemsQuery) Validate() error {
	if q.Limit == nil {
		return nil
	}
	if *q.Limit < minLimit || *q.Limit > maxLimit {
		return fmt.Errorf("limit must be between %d and %d", minLimit, maxLimit)
	}
	return nil
}

// GetItemRequest is the path contract for GET /api/items/{id}.
type GetItemRequest struct {
	ID string `path:"id"`
}
