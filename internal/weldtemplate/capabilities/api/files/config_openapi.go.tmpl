package config

// OpenAPI documentation access: the deployment environment and the explicit
// enable switch that gate GET /api/openapi.json.
//
// The gate is fail-closed and decided in configuration, not in the handler's
// local default, so one configuration path decides it everywhere. The document
// is served only when the environment is an explicit development environment
// (development or local) AND openapi.enabled is true. A production environment
// is refused even when enabled was misconfigured to true, and an unconfigured or
// unrecognized environment is refused too.
//
// This file belongs to the config package so it can define methods on Config.
// The Config struct fields and the loader call into this file are added by
// marker patches to internal/config/config.go; those regions are weld-managed
// and stay untouched outside their markers.
//
// Cross-repo contract, mirrored by the weld template's own safety gate so the
// two never diverge: the YAML keys are `environment` and `openapi.enabled`, the
// environment variables are APP_ENV and OPENAPI_ENABLED, the recognized
// environments are development, local and production, and the DI seam passes
// the resolved decision into the API layer as a plain bool
// (api.Register/api.Handler's serveOpenAPI), not the config struct, so the
// template reuses the same names and the same fail-closed decision table.

import (
	"fmt"
	"strconv"
	"strings"
)

// OpenAPI environment variable names. The environment overrides the YAML file;
// neither is required.
const (
	// EnvAppEnv names the deployment environment (for example development or
	// production).
	EnvAppEnv = "APP_ENV"
	// EnvOpenAPIEnabled is the documentation endpoint's explicit enable switch.
	EnvOpenAPIEnabled = "OPENAPI_ENABLED"
)

// Environment names the deployment environment. The OpenAPI document's access
// gate is its only consumer today; it is a named type so a later capability can
// reuse it rather than re-deriving the environment from a raw string.
//
// The recognized names are an open set: an unconfigured or unrecognized value is
// simply never a development environment, which is the fail-closed outcome.
type Environment string

// The recognized environments. Only the development environments may serve the
// documentation; production is the environment the gate must never expose.
const (
	EnvironmentDevelopment Environment = "development"
	EnvironmentLocal       Environment = "local"
	EnvironmentProduction  Environment = "production"
)

// OpenAPI holds the documentation endpoint's explicit enable switch.
//
// Enabled has no default and is false in a zero Config, so the document stays
// off unless the operator explicitly turns it on for a development environment.
type OpenAPI struct {
	Enabled bool `yaml:"enabled"`
}

// applyOpenAPIEnv overrides the environment section with the environment. An
// enable value that is not a boolean is an error rather than a silent fallback,
// so a typo cannot be mistaken for "off". An unrecognized environment name is
// left as-is and fails closed in OpenAPIDocumentEnabled.
func (c *Config) applyOpenAPIEnv(lookupEnv LookupEnvFunc) error {
	if value, ok := lookupEnv(EnvAppEnv); ok {
		c.Environment = Environment(strings.TrimSpace(value))
	}
	if value, ok := lookupEnv(EnvOpenAPIEnabled); ok {
		enabled, err := strconv.ParseBool(strings.TrimSpace(value))
		if err != nil {
			return fmt.Errorf("config: %s is not a boolean", EnvOpenAPIEnabled)
		}
		c.OpenAPI.Enabled = enabled
	}
	return nil
}

// OpenAPIDocumentEnabled reports whether GET /api/openapi.json may serve the
// generated document. It is fail-closed: it returns true only when
// openapi.enabled is explicitly true AND the environment is an explicit
// development environment (development or local).
//
// Every other combination returns false, in particular:
//
//   - an unconfigured or unrecognized APP_ENV, treated as not development, so a
//     forgotten or misspelled environment label cannot expose the schema;
//   - an explicit production environment, refused even when openapi.enabled was
//     misconfigured to true.
func (c *Config) OpenAPIDocumentEnabled() bool {
	if !c.OpenAPI.Enabled {
		return false
	}
	switch c.Environment {
	case EnvironmentDevelopment, EnvironmentLocal:
		return true
	default:
		return false
	}
}
