# weld:api:installed __version__
# Deployment environment and OpenAPI document access. The document served at
# GET /api/openapi.json is off unless the environment is an explicit development
# environment (development or local) AND openapi.enabled is true. A production
# environment is always refused, even if enabled is set, and an unconfigured or
# unrecognized environment is refused too. Override with APP_ENV and
# OPENAPI_ENABLED in the environment. See internal/config/openapi.go.
environment: ""
openapi:
  enabled: false
