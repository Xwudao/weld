// Package logging defines the project's logging contract and its default slog implementation.
// Loggers are injected; no process-wide default logger is installed.
package logging

import (
	"context"
	"io"
	"log/slog"
	"os"
	"runtime"
	"strconv"
	"strings"
	"time"

	"github.com/lmittmann/tint"
)

// Logger writes structured records. Arguments are alternating string keys and
// values, or Fields. Implementations must be safe for concurrent use, preserve
// the caller's source location, and resolve Valuer values before encoding.
// With and WithGroup return derived loggers without modifying the receiver.
// Context methods pass ctx to the backend; cancellation does not suppress logs.
type Logger interface {
	Debug(string, ...any)
	Info(string, ...any)
	Warn(string, ...any)
	Error(string, ...any)
	DebugContext(context.Context, string, ...any)
	InfoContext(context.Context, string, ...any)
	WarnContext(context.Context, string, ...any)
	ErrorContext(context.Context, string, ...any)
	With(...any) Logger
	WithGroup(string) Logger
}

// Valuer supplies a log-safe representation, for example a redacted secret.
type Valuer interface{ LogValue() any }

// Field is a structured attribute. A zero Field is omitted.
type Field struct {
	Key   string
	Value any
}

func Any(key string, value any) Field     { return Field{Key: key, Value: value} }
func Group(key string, args ...any) Field { return Any(key, fields(args)) }
func Err(err error) Field                 { return Any("error", err) }

// Level selects the minimum severity; the zero value is Info.
type Level int

const (
	LevelDebug Level = -4
	LevelInfo  Level = 0
	LevelWarn  Level = 4
	LevelError Level = 8
)

type Format string

const (
	TextFormat Format = "text"
	JSONFormat Format = "json"
)

const StatementKey = "sql"
const timeLayout = time.DateTime

// Options configures the default implementation without exposing backend types.
type Options struct {
	Format     Format
	Level      Level
	AddSource  bool
	NoColor    bool
	TimeFormat string
	// ReplaceAttr rewrites resolved, non-group fields, including built-in fields.
	// Returning a zero Field drops the field. The groups slice must not be retained.
	ReplaceAttr func(groups []string, field Field) Field
}

// New writes to the injected sink. Nil options selects the defaults.
func New(w io.Writer, format Format, options *Options) Logger {
	var opts Options
	if options != nil {
		opts = *options
	}
	opts.Format = format
	return NewWithOptions(w, opts)
}

func NewWithOptions(w io.Writer, options Options) Logger {
	replace := func(groups []string, a slog.Attr) slog.Attr {
		if options.ReplaceAttr != nil {
			a = attr(options.ReplaceAttr(groups, Any(a.Key, a.Value.Any())))
		}
		if options.Format != JSONFormat && len(groups) == 0 {
			switch a.Key {
			case StatementKey:
				return tint.Attr(6, a)
			case "error":
				return tint.Attr(9, a)
			}
		}
		return a
	}
	opts := &slog.HandlerOptions{Level: slog.Level(options.Level), AddSource: options.AddSource, ReplaceAttr: replace}
	var handler slog.Handler
	if options.Format == JSONFormat {
		handler = slog.NewJSONHandler(w, opts)
	} else {
		clock := options.TimeFormat
		if clock == "" {
			clock = timeLayout
		}
		handler = tint.NewTextHandler(w, &tint.Options{
			Level: opts.Level, AddSource: opts.AddSource, ReplaceAttr: replace,
			TimeFormat: clock, NoColor: options.NoColor,
		})
	}
	return &slogLogger{handler: handler}
}

type slogLogger struct{ handler slog.Handler }

var _ Logger = (*slogLogger)(nil)

func (l *slogLogger) Debug(msg string, args ...any) {
	l.log(context.Background(), LevelDebug, msg, args)
}
func (l *slogLogger) Info(msg string, args ...any) { l.log(context.Background(), LevelInfo, msg, args) }
func (l *slogLogger) Warn(msg string, args ...any) { l.log(context.Background(), LevelWarn, msg, args) }
func (l *slogLogger) Error(msg string, args ...any) {
	l.log(context.Background(), LevelError, msg, args)
}
func (l *slogLogger) DebugContext(ctx context.Context, msg string, args ...any) {
	l.log(ctx, LevelDebug, msg, args)
}
func (l *slogLogger) InfoContext(ctx context.Context, msg string, args ...any) {
	l.log(ctx, LevelInfo, msg, args)
}
func (l *slogLogger) WarnContext(ctx context.Context, msg string, args ...any) {
	l.log(ctx, LevelWarn, msg, args)
}
func (l *slogLogger) ErrorContext(ctx context.Context, msg string, args ...any) {
	l.log(ctx, LevelError, msg, args)
}

func (l *slogLogger) log(ctx context.Context, level Level, msg string, args []any) {
	if ctx == nil {
		ctx = context.Background()
	}
	if !l.handler.Enabled(ctx, slog.Level(level)) {
		return
	}
	var pcs [1]uintptr
	runtime.Callers(3, pcs[:]) // Callers -> log -> public method -> business caller.
	record := slog.NewRecord(time.Now(), slog.Level(level), msg, pcs[0])
	for _, field := range fields(args) {
		record.AddAttrs(attr(field))
	}
	_ = l.handler.Handle(ctx, record)
}

func (l *slogLogger) With(args ...any) Logger {
	attrs := make([]slog.Attr, 0, len(args))
	for _, field := range fields(args) {
		attrs = append(attrs, attr(field))
	}
	return &slogLogger{handler: l.handler.WithAttrs(attrs)}
}
func (l *slogLogger) WithGroup(name string) Logger {
	return &slogLogger{handler: l.handler.WithGroup(name)}
}

// Malformed key/value arguments are retained under !BADKEY, matching slog.
func fields(args []any) []Field {
	var result []Field
	for i := 0; i < len(args); i++ {
		if field, ok := args[i].(Field); ok {
			result = append(result, field)
		} else if key, ok := args[i].(string); ok && i+1 < len(args) {
			i++
			result = append(result, Any(key, args[i]))
		} else {
			result = append(result, Any("!BADKEY", args[i]))
		}
	}
	return result
}

func attr(field Field) slog.Attr {
	if field.Key == "" && field.Value == nil {
		return slog.Attr{}
	}
	value := field.Value
	// Bound resolution so a buggy Valuer cannot hang logging.
	for i := 0; i < 100; i++ {
		valuer, ok := value.(Valuer)
		if !ok {
			break
		}
		value = valuer.LogValue()
		if i == 99 {
			value = "[invalid log value]"
		}
	}
	if group, ok := value.([]Field); ok {
		attrs := make([]slog.Attr, 0, len(group))
		for _, child := range group {
			attrs = append(attrs, attr(child))
		}
		return slog.Attr{Key: field.Key, Value: slog.GroupValue(attrs...)}
	}
	return slog.Any(field.Key, value)
}

func ParseLevel(name string) (Level, error) {
	switch strings.ToLower(strings.TrimSpace(name)) {
	case "", "info":
		return LevelInfo, nil
	case "debug":
		return LevelDebug, nil
	case "warn", "warning":
		return LevelWarn, nil
	case "error":
		return LevelError, nil
	default:
		return 0, &unknownLevelError{name: name}
	}
}

type unknownLevelError struct{ name string }

func (e *unknownLevelError) Error() string {
	return "unknown log level " + strconv.Quote(e.name) + " (want debug, info, warn or error)"
}

// OptionsFromEnv reads LOG_FORMAT, LOG_LEVEL, LOG_SOURCE and NO_COLOR.
// Invalid values fall back to defaults rather than failing startup.
func OptionsFromEnv(getenv func(string) string) Options {
	if getenv == nil {
		getenv = os.Getenv
	}
	options := Options{Format: TextFormat, Level: LevelInfo}
	if strings.EqualFold(strings.TrimSpace(getenv("LOG_FORMAT")), "json") {
		options.Format = JSONFormat
	}
	if level, err := ParseLevel(getenv("LOG_LEVEL")); err == nil {
		options.Level = level
	}
	if source, err := strconv.ParseBool(strings.TrimSpace(getenv("LOG_SOURCE"))); err == nil {
		options.AddSource = source
	}
	options.NoColor = getenv("NO_COLOR") != ""
	return options
}
func NewFromEnv(w io.Writer) Logger { return NewWithOptions(w, OptionsFromEnv(os.Getenv)) }

// Nop returns a logger that discards records.
func Nop() Logger { return contextFallback }

type contextKey struct{}

var contextFallback = NewWithOptions(io.Discard, Options{})

func WithContext(ctx context.Context, logger Logger) context.Context {
	if logger == nil {
		return ctx
	}
	return context.WithValue(ctx, contextKey{}, logger)
}
func FromContext(ctx context.Context) Logger {
	if ctx != nil {
		if logger, ok := ctx.Value(contextKey{}).(Logger); ok && logger != nil {
			return logger
		}
	}
	return Nop()
}
