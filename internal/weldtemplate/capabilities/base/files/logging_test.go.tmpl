// fakeWriter records how many times a logger wrote, so a test can assert on the
// injected sink without touching the process streams.
type fakeWriter struct {
	bytes.Buffer
	Writes int
}

func (w *fakeWriter) Write(p []byte) (int, error) {
	w.Writes++
	return w.Buffer.Write(p)
}

// plain returns a text logger with the colors off, so a test can read the record
// without stripping escapes.
func plain(w *fakeWriter) Logger {
	return NewWithOptions(w, Options{Format: TextFormat, NoColor: true})
}

func TestNewWritesTextRecords(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, TextFormat, nil)
	logger.Info("listening", "addr", ":8080")
	out := w.String()
	for _, want := range []string{"INF", "listening", "addr=", ":8080"} {
		if !strings.Contains(out, want) {
			t.Fatalf("text record is missing %q:\n%q", want, out)
		}
	}
	if !strings.ContainsRune(out, 0x1b) {
		t.Fatalf("the default text logger is not colored:\n%q", out)
	}
	if w.Writes == 0 {
		t.Fatal("logger did not write to the injected writer")
	}
}

// TestTextFormatCanBePlain proves NoColor turns off every escape, so a pipe or a
// file gets plain text.
func TestTextFormatCanBePlain(t *testing.T) {
	w := &fakeWriter{}
	plain(w).Info("listening", StatementKey, "SELECT 1")
	out := w.String()
	if strings.ContainsRune(out, 0x1b) {
		t.Fatalf("NoColor still emitted an escape:\n%q", out)
	}
	if !strings.Contains(out, "sql=\"SELECT 1\"") {
		t.Fatalf("the statement is missing:\n%q", out)
	}
}

func TestNewWritesJSONRecords(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, JSONFormat, nil)
	logger.Info("listening", "addr", ":8080")
	var record map[string]any
	if err := json.Unmarshal([]byte(strings.TrimSpace(w.String())), &record); err != nil {
		t.Fatalf("record is not JSON: %v\n%s", err, w.String())
	}
	if record["level"] != "INFO" || record["msg"] != "listening" || record["addr"] != ":8080" {
		t.Fatalf("record = %v", record)
	}
}

func TestNewUnknownFormatFallsBackToText(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, Format("yaml"), nil)
	logger.Info("hello")
	if out := w.String(); !strings.Contains(out, "hello") || !strings.Contains(out, "INF") {
		t.Fatalf("unknown format did not fall back to text:\n%q", out)
	}
}

func TestNewRespectsHandlerLevel(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, TextFormat, &Options{Level: LevelWarn})
	logger.Info("quiet")
	logger.Warn("loud")
	out := w.String()
	if strings.Contains(out, "quiet") {
		t.Fatalf("logger emitted a record below the configured level:\n%s", out)
	}
	if !strings.Contains(out, "loud") {
		t.Fatalf("logger filtered a record at the configured level:\n%s", out)
	}
}

func TestNewLogsErrorAttribute(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, JSONFormat, nil)
	logger.Error("command failed", "error", errors.New("boom"))
	var record map[string]any
	if err := json.Unmarshal([]byte(strings.TrimSpace(w.String())), &record); err != nil {
		t.Fatalf("record is not JSON: %v\n%s", err, w.String())
	}
	if record["level"] != "ERROR" || record["msg"] != "command failed" || record["error"] != "boom" {
		t.Fatalf("record = %v", record)
	}
}

// TestErrAttributeRendersInJSON proves the Err helper keeps the conventional
// "error" key and still resolves to the message through a non-tint handler.
func TestErrAttributeRendersInJSON(t *testing.T) {
	w := &fakeWriter{}
	New(w, JSONFormat, nil).Error("failed", Err(errors.New("boom")))
	var record map[string]any
	if err := json.Unmarshal([]byte(strings.TrimSpace(w.String())), &record); err != nil {
		t.Fatalf("record is not JSON: %v\n%s", err, w.String())
	}
	if record["error"] != "boom" {
		t.Fatalf("record = %v", record)
	}
}

// TestTextRecordTimeLayout pins the text record's time: time.DateTime, the date
// and local wall clock to the second, uncolored and with no zone offset.
func TestTextRecordTimeLayout(t *testing.T) {
	w := &fakeWriter{}
	plain(w).Info("hello")
	out := w.String()
	if len(out) < len(timeLayout) {
		t.Fatalf("record is too short:\n%q", out)
	}
	if _, err := time.Parse(timeLayout, out[:len(timeLayout)]); err != nil {
		t.Fatalf("record time %q does not match timeLayout: %v", out[:len(timeLayout)], err)
	}
}

// TestTimeFormatOverridesClock proves Options.TimeFormat replaces the clock
// without touching the rest of the record.
func TestTimeFormatOverridesClock(t *testing.T) {
	w := &fakeWriter{}
	NewWithOptions(w, Options{Format: TextFormat, NoColor: true, TimeFormat: time.TimeOnly}).Info("hi")
	out := w.String()
	if _, err := time.Parse(time.TimeOnly, out[:len(time.TimeOnly)]); err != nil {
		t.Fatalf("record time %q does not match time.TimeOnly: %v", out[:len(time.TimeOnly)], err)
	}
}

// TestNewKeepsRFC3339TimeInJSON pins the JSON handler's timestamp as RFC 3339: a
// log pipeline parses it, so the text layout stays a text-only concern.
func TestNewKeepsRFC3339TimeInJSON(t *testing.T) {
	w := &fakeWriter{}
	New(w, JSONFormat, nil).Info("hello")
	var record map[string]any
	if err := json.Unmarshal([]byte(strings.TrimSpace(w.String())), &record); err != nil {
		t.Fatalf("record is not JSON: %v\n%s", err, w.String())
	}
	ts, _ := record["time"].(string)
	if _, err := time.Parse(time.RFC3339Nano, ts); err != nil {
		t.Fatalf("json time %q is not RFC 3339: %v", ts, err)
	}
}

// TestNewTextHonoursCallerReplaceAttr proves the caller's ReplaceAttr runs: an
// attribute it drops is not resurrected, and New does not mutate the options it
// was handed.
func TestNewTextHonoursCallerReplaceAttr(t *testing.T) {
	w := &fakeWriter{}
	options := &Options{ReplaceAttr: func(_ []string, a Field) Field {
		if a.Key == "time" {
			return Field{}
		}
		return a
	}}
	New(w, TextFormat, options).Info("hello")
	out := w.String()
	if strings.Contains(out, time.Now().Format("2006-01-02")) {
		t.Fatalf("caller's ReplaceAttr did not drop the time:\n%q", out)
	}
	if !strings.Contains(out, "hello") {
		t.Fatalf("record lost its message:\n%q", out)
	}
	if options.ReplaceAttr == nil {
		t.Fatal("New mutated the caller's Options")
	}
}

// TestTextRecordPaintsTheStatement proves the statement field is painted cyan
// (tint's 2;36 faint color) while the rest of the record stays as it is.
func TestTextRecordPaintsTheStatement(t *testing.T) {
	w := &fakeWriter{}
	New(w, TextFormat, nil).Info("query", StatementKey, "SELECT * FROM items WHERE id = $1", "rows", 1)
	out := w.String()
	if !strings.Contains(out, "\x1b[2;36m"+StatementKey+"=") {
		t.Fatalf("the statement field is not painted:\n%q", out)
	}
	if !strings.Contains(out, `"SELECT * FROM items WHERE id = $1"`) {
		t.Fatalf("the statement value is missing:\n%q", out)
	}
	if !strings.Contains(out, "rows=") {
		t.Fatalf("the record lost a later attribute:\n%q", out)
	}
}

// TestTextRecordWithoutAStatementHasNoSQLColor proves the statement color is not
// paid for by every record: an ordinary record never carries the 2;36 sequence.
func TestTextRecordWithoutAStatementHasNoSQLColor(t *testing.T) {
	w := &fakeWriter{}
	New(w, TextFormat, nil).Info("listening", "addr", ":8080")
	if out := w.String(); strings.Contains(out, "\x1b[2;36m") {
		t.Fatalf("a record without a statement is painted as one:\n%q", out)
	}
}

// TestJSONRecordIsNeverPainted proves the JSON handler owns its own encoding: a
// statement field stays plain JSON.
func TestJSONRecordIsNeverPainted(t *testing.T) {
	w := &fakeWriter{}
	New(w, JSONFormat, nil).Info("query", StatementKey, "SELECT 1")
	if strings.ContainsRune(w.String(), 0x1b) {
		t.Fatalf("the JSON record carries an escape:\n%q", w.String())
	}
}

// TestTextRecordQuotesAmbiguousValues proves a value is quoted when it would
// otherwise break the key=value record. The message is written as text, not as a
// key=value field, so it is never quoted.
func TestTextRecordQuotesAmbiguousValues(t *testing.T) {
	w := &fakeWriter{}
	plain(w).Info("hello world", "note", "a=b c")
	out := w.String()
	if !strings.Contains(out, "hello world") {
		t.Errorf("the message is missing:\n%s", out)
	}
	if !strings.Contains(out, `note="a=b c"`) {
		t.Errorf("an ambiguous value is not quoted:\n%s", out)
	}
}

// TestTextRecordWritesTypedValues pins the kinds that need no quoting.
func TestTextRecordWritesTypedValues(t *testing.T) {
	w := &fakeWriter{}
	plain(w).Info("m",
		"count", 3,
		"ratio", 0.5,
		"ok", true,
		"elapsed", 1500*time.Millisecond,
	)
	out := w.String()
	for _, want := range []string{"count=3", "ratio=0.5", "ok=true", "elapsed=1.5s"} {
		if !strings.Contains(out, want) {
			t.Errorf("a typed value is missing %q:\n%s", want, out)
		}
	}
}

// TestTextRecordFlattensGroups proves WithAttrs, WithGroup and a group attribute
// flatten into dotted keys the way slog flattens them.
func TestTextRecordFlattensGroups(t *testing.T) {
	w := &fakeWriter{}
	plain(w).With("app", "weld").WithGroup("http").Info("m", "status", 200, Group("req", "id", 7))
	out := w.String()
	for _, want := range []string{"app=weld", "http.status=200", "http.req.id=7"} {
		if !strings.Contains(out, want) {
			t.Errorf("the flattened group is missing %q:\n%s", want, out)
		}
	}
}

// TestTextRecordKeepsAnAttributeInItsGroup proves WithAttrs binds an attribute to
// the group that was open when it was added, not to one opened later.
func TestTextRecordKeepsAnAttributeInItsGroup(t *testing.T) {
	w := &fakeWriter{}
	plain(w).WithGroup("a").With("x", 1).WithGroup("b").Info("m", "y", 2)
	out := w.String()
	for _, want := range []string{"a.x=1", "a.b.y=2"} {
		if !strings.Contains(out, want) {
			t.Errorf("the group path is missing %q:\n%s", want, out)
		}
	}
}

// TestTextRecordWritesSource proves AddSource is honoured, so a record can name
// its call site.
func TestTextRecordWritesSource(t *testing.T) {
	w := &fakeWriter{}
	NewWithOptions(w, Options{Format: TextFormat, NoColor: true, AddSource: true}).Info("m")
	if out := w.String(); !strings.Contains(out, "logging_test.go:") {
		t.Fatalf("AddSource did not add a source field:\n%s", out)
	}
}

// TestTextRecordWritesOneWritePerRecord proves a record reaches the sink whole:
// the handler holds its mutex across the line, so two goroutines cannot interleave
// halves of one.
func TestTextRecordWritesOneWritePerRecord(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, TextFormat, nil)
	for i := 0; i < 3; i++ {
		logger.Info("m", "i", i)
	}
	if w.Writes != 3 {
		t.Fatalf("writes = %d, want one per record (3)", w.Writes)
	}
}

func TestParseLevel(t *testing.T) {
	cases := map[string]Level{
		"":        LevelInfo,
		"info":    LevelInfo,
		"INFO":    LevelInfo,
		" debug ": LevelDebug,
		"warn":    LevelWarn,
		"warning": LevelWarn,
		"error":   LevelError,
	}
	for name, want := range cases {
		got, err := ParseLevel(name)
		if err != nil {
			t.Errorf("ParseLevel(%q): %v", name, err)
			continue
		}
		if got != want {
			t.Errorf("ParseLevel(%q) = %v, want %v", name, got, want)
		}
	}
	if _, err := ParseLevel("verbose"); err == nil {
		t.Fatal("ParseLevel accepted an unknown level")
	}
}

func TestOptionsFromEnv(t *testing.T) {
	env := map[string]string{
		"LOG_FORMAT": "json",
		"LOG_LEVEL":  "debug",
		"LOG_SOURCE": "true",
		"NO_COLOR":   "1",
	}
	options := OptionsFromEnv(func(key string) string { return env[key] })
	if options.Format != JSONFormat || options.Level != LevelDebug || !options.AddSource || !options.NoColor {
		t.Fatalf("OptionsFromEnv = %+v", options)
	}
}

// TestOptionsFromEnvIgnoresBadValues proves a bad environment degrades to the
// defaults instead of failing startup.
func TestOptionsFromEnvIgnoresBadValues(t *testing.T) {
	env := map[string]string{"LOG_FORMAT": "yaml", "LOG_LEVEL": "verbose", "LOG_SOURCE": "yes please"}
	options := OptionsFromEnv(func(key string) string { return env[key] })
	if options.Format != TextFormat || options.Level != LevelInfo || options.AddSource || options.NoColor {
		t.Fatalf("OptionsFromEnv = %+v", options)
	}
}

func TestNewFromEnvReadsTheEnvironment(t *testing.T) {
	t.Setenv("LOG_FORMAT", "json")
	t.Setenv("LOG_LEVEL", "warn")
	w := &fakeWriter{}
	logger := NewFromEnv(w)
	logger.Info("quiet")
	logger.Warn("loud", "k", "v")
	var record map[string]any
	if err := json.Unmarshal([]byte(strings.TrimSpace(w.String())), &record); err != nil {
		t.Fatalf("NewFromEnv did not build a JSON logger: %v\n%s", err, w.String())
	}
	if record["level"] != "WARN" {
		t.Fatalf("record = %v", record)
	}
}

// recordingHandler verifies that the adapter passes context and source metadata.
type recordingHandler struct {
	ctx    context.Context
	record slog.Record
}

func (*recordingHandler) Enabled(context.Context, slog.Level) bool { return true }
func (h *recordingHandler) Handle(ctx context.Context, r slog.Record) error {
	h.ctx, h.record = ctx, r.Clone()
	return nil
}
func (h *recordingHandler) WithAttrs([]slog.Attr) slog.Handler { return h }
func (h *recordingHandler) WithGroup(string) slog.Handler      { return h }

func TestContextMethodsPreserveContextLevelAndCaller(t *testing.T) {
	h := &recordingHandler{}
	logger := &slogLogger{handler: h}
	ctx, cancel := context.WithCancel(context.Background())
	cancel() // cancellation must not hide diagnostic records
	methods := []struct {
		log   func(context.Context, string, ...any)
		level slog.Level
	}{
		{logger.DebugContext, slog.LevelDebug}, {logger.InfoContext, slog.LevelInfo},
		{logger.WarnContext, slog.LevelWarn}, {logger.ErrorContext, slog.LevelError},
	}
	for _, method := range methods {
		method.log(ctx, "diagnostic", "key", "value")
		if h.ctx != ctx || h.record.Level != method.level || h.record.Message != "diagnostic" {
			t.Fatalf("context or record lost: %v", h.record)
		}
		frame, _ := runtime.CallersFrames([]uintptr{h.record.PC}).Next()
		if !strings.HasSuffix(frame.File, "logging_test.go") || !strings.Contains(frame.Function, "TestContextMethods") {
			t.Fatalf("source points to adapter instead of caller: %+v", frame)
		}
	}
}

type secretValue string

func (secretValue) LogValue() any { return "[REDACTED]" }

func TestValuerRedactsFieldsGroupsAndBoundAttributes(t *testing.T) {
	for _, format := range []Format{TextFormat, JSONFormat} {
		w := &fakeWriter{}
		logger := NewWithOptions(w, Options{Format: format, NoColor: true})
		logger.With("bound", secretValue("bound-secret")).Info("safe",
			"direct", secretValue("direct-secret"),
			Group("nested", Any("secret", secretValue("group-secret"))))
		for _, secret := range []string{"bound-secret", "direct-secret", "group-secret"} {
			if strings.Contains(w.String(), secret) {
				t.Fatalf("leaked %s: %s", secret, w.String())
			}
		}
		if strings.Count(w.String(), "[REDACTED]") != 3 {
			t.Fatalf("missing redaction: %s", w.String())
		}
	}
}

func TestDerivedLoggerDoesNotMutateParent(t *testing.T) {
	w := &fakeWriter{}
	parent := New(w, JSONFormat, nil)
	parent.WithGroup("child").With("id", 7).Info("child")
	parent.Info("parent")
	lines := strings.Split(strings.TrimSpace(w.String()), "\n")
	if len(lines) != 2 || strings.Contains(lines[1], "child") || strings.Contains(lines[1], "id") {
		t.Fatalf("derived logger modified parent: %s", w.String())
	}
}

func TestLoggerConcurrentUse(t *testing.T) {
	w := &fakeWriter{}
	logger := New(w, JSONFormat, nil)
	var wg sync.WaitGroup
	for i := 0; i < 10; i++ {
		wg.Add(1)
		go func(id int) {
			defer wg.Done()
			logger.With("worker", id).InfoContext(context.Background(), "work")
		}(i)
	}
	wg.Wait()
	if w.Writes != 10 {
		t.Fatalf("writes = %d", w.Writes)
	}
}

// A backend not based on slog can travel through the same context contract.
type alternateLogger struct {
	Logger
	message string
}

func (l *alternateLogger) Info(msg string, _ ...any) { l.message = msg }
func TestContextAcceptsAlternateImplementation(t *testing.T) {
	logger := &alternateLogger{Logger: Nop()}
	ctx := WithContext(context.Background(), logger)
	FromContext(ctx).Info("alternate")
	if logger.message != "alternate" {
		t.Fatal("context did not retain custom implementation")
	}
}

func TestContextRoundTrip(t *testing.T) {
	logger := New(&bytes.Buffer{}, TextFormat, nil)
	ctx := WithContext(context.Background(), logger)
	if got := FromContext(ctx); got != logger {
		t.Fatalf("FromContext returned %p, want the stored logger %p", got, logger)
	}
	if got := FromContext(context.Background()); got == nil {
		t.Fatal("FromContext returned nil for an empty context")
	}
	if got := WithContext(context.Background(), nil); got == nil {
		t.Fatal("WithContext(nil) returned nil")
	}
}
