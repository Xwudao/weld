// Package app wires the __name__ command line.
package app

import (
	"fmt"

	"github.com/spf13/cobra"
)

// Version is the application version.
const Version = "__version__"

// CommandFactory builds one top-level command.
//
// It is the stable contribution seam: a capability or business module lives in
// its own file in this package and registers a factory from an init function.
// weld writes that file once and never regenerates it, so the command body
// survives every later `weld add`. The base registers none, so the scaffold
// builds and runs with no capability dependencies.
type CommandFactory func() *cobra.Command

var (
	commandFactories []CommandFactory
	rootConfigurers  []func(*cobra.Command)
	// defaultRun is the action a bare invocation (no subcommand) runs. The base
	// shows help; a capability that owns a server installs its long-running
	// action through SetDefaultRun so `__name__` and `__name__ <command>` share
	// one lifecycle.
	defaultRun = func(cmd *cobra.Command, args []string) error { return cmd.Help() }
)

// RegisterCommand records a top-level command factory. It panics on a nil
// factory so a broken capability fails when the process starts rather than
// silently dropping a command; NewRootCommand panics on a duplicate name so two
// capabilities cannot silently shadow each other.
func RegisterCommand(factory CommandFactory) {
	if factory == nil {
		panic("app: command factory must not be nil")
	}
	commandFactories = append(commandFactories, factory)
}

// ConfigureRoot lets a capability add persistent flags or settings to the root
// command before it is built. A capability uses it to share one flag definition
// between a bare invocation and its own subcommand, so both parse identically.
// It panics on nil so a broken capability fails at startup.
func ConfigureRoot(configure func(*cobra.Command)) {
	if configure == nil {
		panic("app: root configurer must not be nil")
	}
	rootConfigurers = append(rootConfigurers, configure)
}

// SetDefaultRun replaces the action a bare invocation runs when no subcommand is
// given. The base shows help; the http capability installs its serve action, so
// a bare `__name__` starts the same server lifecycle as `__name__ serve`.
func SetDefaultRun(run func(cmd *cobra.Command, args []string) error) {
	if run == nil {
		panic("app: default run must not be nil")
	}
	defaultRun = run
}

// NewRootCommand builds the root command with every registered command attached.
//
// It is exported so a capability's test can assert the command tree without
// starting the process.
func NewRootCommand() *cobra.Command {
	root := &cobra.Command{
		Use:   "__name__",
		Short: "a Go CLI generated by weld",
		// main reports a failed command once, through the injected logger, so
		// the command tree stays silent here.
		SilenceErrors: true,
		SilenceUsage:  true,
		// A bare invocation falls through to defaultRun; anything else that is
		// not a known command is an unknown-command error.
		Args: cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error { return defaultRun(cmd, args) },
	}
	root.Version = Version
	root.SetVersionTemplate("__name__ {{.Version}}\n")
	// The generated CLI ships no shell-completion generator; keep the command
	// surface to the commands the project actually contributes.
	root.CompletionOptions.DisableDefaultCmd = true
	root.AddCommand(newVersionCommand())
	for _, configure := range rootConfigurers {
		configure(root)
	}
	for _, factory := range commandFactories {
		command := factory()
		if hasCommand(root, command.Name()) {
			panic("app: duplicate command " + command.Name())
		}
		root.AddCommand(command)
	}
	return root
}

// hasCommand reports whether the root already has a command with name, so a
// capability cannot silently shadow a built-in or another capability's command.
func hasCommand(root *cobra.Command, name string) bool {
	for _, command := range root.Commands() {
		if command.Name() == name {
			return true
		}
	}
	return false
}

// Run dispatches the command line arguments through the command tree.
func Run(args []string) error {
	root := NewRootCommand()
	root.SetArgs(args)
	return root.Execute()
}

// newVersionCommand returns the built-in version command.
func newVersionCommand() *cobra.Command {
	return &cobra.Command{
		Use:   "version",
		Short: "print the version",
		Args:  cobra.NoArgs,
		Run: func(cmd *cobra.Command, args []string) {
			fmt.Fprintln(cmd.OutOrStdout(), "__name__ "+Version)
		},
	}
}
