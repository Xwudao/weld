package httpserver

import (
	"context"
	"errors"
	"fmt"
	"net"
	"net/http"
	"sync"
	"time"

	"__module__/internal/logging"
)

// Server owns the HTTP runtime. Construct once, Start once, then Stop with the
// application's shutdown context. It has no dependency on a DI framework.
type Server struct {
	HTTP     *http.Server
	logger   logging.Logger
	mu       sync.Mutex
	listener net.Listener
	started  bool
	stopped  bool
	fail     chan error
	done     chan struct{}
}

// NewServer configures a server without binding a socket. handler must already
// carry the application middleware (normally built by NewHandler).
func NewServer(addr string, handler http.Handler, logger logging.Logger) *Server {
	if handler == nil {
		handler = http.NewServeMux()
	}
	return &Server{
		HTTP: &http.Server{
			Addr:              addr,
			Handler:           handler,
			ReadHeaderTimeout: 5 * time.Second,
			IdleTimeout:       60 * time.Second,
		},
		logger: logger,
		fail:   make(chan error, 1),
		done:   make(chan struct{}),
	}
}

// Start binds synchronously: an occupied port fails before a listening log.
// Failed binds may be retried; a successfully started or stopped server cannot
// be restarted. The context bounds startup, not the lifetime of the server.
func (s *Server) Start(ctx context.Context) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.started || s.stopped {
		return errors.New("httpserver: server already started or stopped")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	listener, err := (&net.ListenConfig{}).Listen(ctx, "tcp", s.HTTP.Addr)
	if err != nil {
		return fmt.Errorf("httpserver: listen on %s: %w", s.HTTP.Addr, err)
	}
	s.listener = listener
	s.started = true
	if s.logger != nil {
		s.logger.Info("__name__ listening", "url", BrowseURL(listener.Addr()))
	}
	go func() {
		defer close(s.done)
		err := s.HTTP.Serve(listener)
		if errors.Is(err, http.ErrServerClosed) {
			err = nil
		}
		if err != nil && s.logger != nil {
			s.logger.Error("__name__ serve failed", "error", err)
		}
		s.fail <- err
	}()
	return nil
}

// Addr returns the actual bound address, including the assigned port for :0.
// It is nil before Start succeeds.
func (s *Server) Addr() net.Addr {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.listener == nil {
		return nil
	}
	return s.listener.Addr()
}

// Fail delivers the serve result once: nil after graceful shutdown, an error
// after a runtime failure. Stop does not consume this result.
func (s *Server) Fail() <-chan error { return s.fail }

// Stop honors the caller's shutdown budget. If draining exceeds it, Close
// forcibly releases active connections and the shutdown error is returned.
// Hijacked connections (such as WebSockets) remain the handler's responsibility.
func (s *Server) Stop(ctx context.Context) error {
	s.mu.Lock()
	s.stopped = true
	started := s.started
	s.mu.Unlock()
	if !started {
		return nil
	}
	if s.logger != nil {
		s.logger.Info("__name__ shutting down")
	}
	err := s.HTTP.Shutdown(ctx)
	if err != nil {
		err = errors.Join(err, s.HTTP.Close())
		if s.logger != nil {
			s.logger.Error("__name__ shutdown failed", "error", err)
		}
	}
	<-s.done
	return err
}
