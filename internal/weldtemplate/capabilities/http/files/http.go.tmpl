// Package httpserver owns the HTTP surface of __name__: the server lifecycle
// and the composable handler builder.
//
// The base CLI never imports this package. The http capability installs it and
// the Loom server graph (internal/di) composes the routes — the JSON API, the
// business modules and the SPA — into the mux it serves. NewHandler and Chain
// remain the injectable seam a test uses to exercise a mux and the middleware
// chain without a socket.
package httpserver

import (
	"net"
	nethttp "net/http"

	"__module__/internal/config"
	"__module__/internal/httpx"

	"__module__/internal/logging"
)

// Route installs one capability's routes on the application mux.
type Route func(mux *nethttp.ServeMux)

// Chain applies the application middleware chain to handler.
//
// It is the single composition point for middleware: the Loom server graph
// wraps the mux it builds with it, and NewHandler uses it for injected routes,
// so every composition serves identical middleware semantics. The stack it
// applies is declared in middleware.go, the stable project-owned configuration
// file, and cfg supplies the settings that stack reads — currently the
// cross-origin policy. A nil cfg is treated as an empty configuration, so the
// chain still applies with CORS off.
func Chain(cfg *config.Config, logger logging.Logger, handler nethttp.Handler) nethttp.Handler {
	return httpx.Chain(middlewareChain(cfg, logger)...)(handler)
}

// NewHandler builds a handler from the given routes.
//
// It is the injectable seam for tests: pass routes directly to exercise the mux
// — and the real middleware chain, including the CORS policy cfg configures —
// without installing a capability or opening a socket. Production composition
// happens in the Loom server graph, which registers the business modules on its
// own mux.
func NewHandler(cfg *config.Config, logger logging.Logger, routes ...Route) nethttp.Handler {
	mux := nethttp.NewServeMux()
	for _, route := range routes {
		route(mux)
	}
	return Chain(cfg, logger, mux)
}

// BrowseURL returns the URL a developer can open for a server bound at addr.
//
// A log line should carry a link, not the wildcard the listener reports: an
// empty host, 0.0.0.0 or :: is not browsable and becomes 127.0.0.1, and a
// concrete host is kept as it is. The scheme is http. An address without a port
// (a unix socket, a bare host) is not a URL authority and is returned unchanged
// behind the scheme, rather than inventing a port.
func BrowseURL(addr net.Addr) string {
	if addr == nil {
		return ""
	}
	host, port, err := net.SplitHostPort(addr.String())
	if err != nil {
		return "http://" + addr.String()
	}
	switch host {
	case "", "0.0.0.0", "::":
		host = "127.0.0.1"
	}
	return "http://" + net.JoinHostPort(host, port)
}
