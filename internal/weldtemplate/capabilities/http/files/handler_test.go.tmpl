// testLogger is the injected logger for tests that do not assert on output.
func testLogger() logging.Logger {
	return logging.New(&bytes.Buffer{}, logging.TextFormat, &logging.Options{NoColor: true})
}

// testConfig is the configuration the injected-handler tests compose with: CORS
// off, so those tests exercise the default chain and one test enables it
// explicitly.
func testConfig() *config.Config {
	return &config.Config{HTTP: config.HTTP{Addr: ":0"}}
}

// TestBrowseURLRewritesTheWildcardHost proves a listener address becomes a URL a
// developer can open, so a startup log line is clickable rather than a wildcard.
func TestBrowseURLRewritesTheWildcardHost(t *testing.T) {
	cases := []struct {
		name string
		addr net.Addr
		want string
	}{
		{"wildcard ipv6", &net.TCPAddr{IP: net.IPv6zero, Port: 8080}, "http://127.0.0.1:8080"},
		{"wildcard ipv4", &net.TCPAddr{IP: net.IPv4zero, Port: 8080}, "http://127.0.0.1:8080"},
		{"loopback", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 8080}, "http://127.0.0.1:8080"},
		{"concrete host", &net.TCPAddr{IP: net.IPv4(192, 168, 1, 5), Port: 9000}, "http://192.168.1.5:9000"},
		{"ipv6 loopback", &net.TCPAddr{IP: net.IPv6loopback, Port: 8080}, "http://[::1]:8080"},
		{"no port", &net.UnixAddr{Name: "/tmp/app.sock", Net: "unix"}, "http:///tmp/app.sock"},
		{"nil", nil, ""},
	}
	for _, tc := range cases {
		if got := BrowseURL(tc.addr); got != tc.want {
			t.Errorf("%s: BrowseURL(%v) = %q, want %q", tc.name, tc.addr, got, tc.want)
		}
	}
}

func TestNewHandlerComposesInjectedRoutes(t *testing.T) {
	handler := NewHandler(testConfig(), testLogger(), nil, func(mux *httpx.Router) {
		mux.HandleFunc("/ping", func(w nethttp.ResponseWriter, _ *nethttp.Request) {
			w.WriteHeader(nethttp.StatusTeapot)
		})
	})
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/ping", nil))
	if recorder.Code != nethttp.StatusTeapot {
		t.Fatalf("status = %d, want %d", recorder.Code, nethttp.StatusTeapot)
	}
}

func TestNewHandlerWithoutRoutesServesNothing(t *testing.T) {
	recorder := httptest.NewRecorder()
	NewHandler(testConfig(), testLogger(), nil).ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/", nil))
	if recorder.Code != nethttp.StatusNotFound {
		t.Fatalf("status = %d, want %d", recorder.Code, nethttp.StatusNotFound)
	}
}

// TestNewHandlerAppliesMiddleware proves the composed handler carries the
// project middleware chain: the request-id middleware echoes an identifier on
// every response.
func TestNewHandlerAppliesMiddleware(t *testing.T) {
	handler := NewHandler(testConfig(), testLogger(), nil, func(mux *httpx.Router) {
		mux.HandleFunc("/ping", func(w nethttp.ResponseWriter, _ *nethttp.Request) {
			w.WriteHeader(nethttp.StatusOK)
		})
	})
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/ping", nil))
	if got := recorder.Header().Get("X-Request-Id"); got == "" {
		t.Fatal("the middleware chain did not assign a request id")
	}
}

// TestNewHandlerAppliesTheConfiguredCORSPolicy proves the chain is wired to the
// configuration: an enabled cors section answers a preflight before the mux, so
// the router never sees an OPTIONS request it registered no route for.
func TestNewHandlerAppliesTheConfiguredCORSPolicy(t *testing.T) {
	cfg := testConfig()
	cfg.CORS = config.CORS{Enabled: true, AllowedOrigins: []string{"https://app.example.com"}}
	handler := NewHandler(cfg, testLogger(), nil, func(mux *httpx.Router) {
		mux.HandleFunc("/api/items", func(nethttp.ResponseWriter, *nethttp.Request) {
			t.Error("the preflight reached the mux")
		})
	})

	request := httptest.NewRequest(nethttp.MethodOptions, "/api/items", nil)
	request.Header.Set("Origin", "https://app.example.com")
	request.Header.Set("Access-Control-Request-Method", nethttp.MethodGet)
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)

	if recorder.Code != nethttp.StatusNoContent {
		t.Fatalf("status = %d, want %d", recorder.Code, nethttp.StatusNoContent)
	}
	if got := recorder.Header().Get("Access-Control-Allow-Origin"); got != "https://app.example.com" {
		t.Fatalf("allow-origin = %q", got)
	}
}

// TestNewHandlerWithoutCORSSendsNoCORSHeader proves the default stays off: a
// disabled cors section installs no middleware and adds no header, so a
// same-origin project is unaffected.
func TestNewHandlerWithoutCORSSendsNoCORSHeader(t *testing.T) {
	handler := NewHandler(testConfig(), testLogger(), nil, func(mux *httpx.Router) {
		mux.HandleFunc("/ping", func(w nethttp.ResponseWriter, _ *nethttp.Request) {
			w.WriteHeader(nethttp.StatusOK)
		})
	})

	request := httptest.NewRequest(nethttp.MethodGet, "/ping", nil)
	request.Header.Set("Origin", "https://app.example.com")
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)

	if got := recorder.Header().Get("Access-Control-Allow-Origin"); got != "" {
		t.Fatalf("allow-origin = %q, want none while CORS is disabled", got)
	}
}

// TestNewHandlerRecoversAPanic proves a handler panic is contained: the client
// receives the internal-error envelope and never the panic detail, which is
// logged through the injected logger instead.
func TestNewHandlerRecoversAPanic(t *testing.T) {
	var sink bytes.Buffer
	logger := logging.New(&sink, logging.TextFormat, &logging.Options{NoColor: true})
	handler := NewHandler(testConfig(), logger, nil, func(mux *httpx.Router) {
		mux.HandleFunc("/boom", func(nethttp.ResponseWriter, *nethttp.Request) {
			panic("secret panic detail")
		})
	})
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/boom", nil))
	if recorder.Code != nethttp.StatusInternalServerError {
		t.Fatalf("status = %d, want %d", recorder.Code, nethttp.StatusInternalServerError)
	}
	if strings.Contains(recorder.Body.String(), "secret panic detail") {
		t.Fatalf("the panic detail leaked to the client: %s", recorder.Body)
	}
	if !strings.Contains(sink.String(), "panic") {
		t.Fatalf("the panic was not logged through the injected logger:\n%s", sink.String())
	}
}

func TestNewHandlerPoliciesAndErrorLogging(t *testing.T) {
	var sink bytes.Buffer
	logger := logging.New(&sink, logging.TextFormat, &logging.Options{NoColor: true})
	handler := NewHandler(nil, logger, []NamedPolicy{
		{Name: "deny", Middleware: func(next nethttp.Handler) nethttp.Handler {
			return nethttp.HandlerFunc(func(w nethttp.ResponseWriter, r *nethttp.Request) {
				httpx.Error(w, nethttp.StatusForbidden, "denied")
			})
		}},
	}, func(router *httpx.Router) {
		httpx.NoInput(router, nethttp.MethodGet, "/failure", func(context.Context) (string, error) {
			return "", errors.New("secret backend failure")
		})
		router.Group("/private").Require("deny").Get("/test", func(nethttp.ResponseWriter, *nethttp.Request) {
			t.Error("policy was bypassed")
		})
	})
	req := httptest.NewRequest(nethttp.MethodGet, "/failure", nil)
	req.Header.Set(httpx.RequestIDHeader, "trace-123")
	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)
	if w.Code != 500 || strings.Contains(w.Body.String(), "secret") {
		t.Fatalf("error response: %d %s", w.Code, w.Body)
	}
	if !strings.Contains(sink.String(), "secret backend failure") || !strings.Contains(sink.String(), "trace-123") {
		t.Fatalf("failure not logged with request ID: %s", sink.String())
	}
	w = httptest.NewRecorder()
	handler.ServeHTTP(w, httptest.NewRequest(nethttp.MethodGet, "/private/test", nil))
	if w.Code != 403 {
		t.Fatalf("policy status = %d", w.Code)
	}
}

func TestDevelopmentLogsTheComposedRoutes(t *testing.T) {
	for _, environment := range []config.Environment{config.EnvironmentLocal, config.EnvironmentProduction} {
		var sink bytes.Buffer
		logger := logging.New(&sink, logging.TextFormat, &logging.Options{NoColor: true})
		NewHandler(&config.Config{Environment: environment}, logger, nil, func(router *httpx.Router) {
			router.Get("/ping", func(nethttp.ResponseWriter, *nethttp.Request) {})
		})
		logged := strings.Contains(sink.String(), "/ping")
		if logged != environment.IsDevelopment() {
			t.Fatalf("%s: route log=%v", environment, logged)
		}
	}
}

func TestNewHandlerRejectsInvalidPolicies(t *testing.T) {
	pass := func(next nethttp.Handler) nethttp.Handler { return next }
	for _, policies := range [][]NamedPolicy{
		{{Name: "", Middleware: pass}},
		{{Name: "guard"}},
		{{Name: "guard", Middleware: pass}, {Name: "guard", Middleware: pass}},
	} {
		func() {
			defer func() {
				if recover() == nil {
					t.Error("invalid policies accepted")
				}
			}()
			NewHandler(nil, nil, policies)
		}()
	}
}
