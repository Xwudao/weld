package di

import (
	"net/http"

	"__module__/internal/httpserver"
	"__module__/internal/httpx"
)

// NewHTTPPolicies wires named policies. Inject authentication services here,
// replace AdminGuard with their middleware, then run make generate.
// Keep service dependencies out of httpserver to avoid package import cycles.
// This file is written once and remains project-owned.
func NewHTTPPolicies() ([]httpserver.NamedPolicy, error) {
	return []httpserver.NamedPolicy{
		{Name: httpserver.PolicyAdmin, Middleware: AdminGuard()},
	}, nil
}

// AdminGuard denies all requests until real authentication and administrator
// authorization are configured. A bearer token alone is never proof of access.
func AdminGuard() httpx.Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			httpx.Error(w, http.StatusForbidden, "administrator policy is not configured")
		})
	}
}
