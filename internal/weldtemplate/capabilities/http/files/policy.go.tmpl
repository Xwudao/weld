package httpserver

import "__module__/internal/httpx"

// APIPrefix is the default mount prefix for business modules. Change it to
// "/api/v2", for example, to version the surface in one place.
const APIPrefix = "/api"

// ModulePrefix returns each module's mount path. Return "" for a module that
// owns complete paths, or special-case a module without editing generated di.go.
func ModulePrefix(name string) string {
	return APIPrefix + "/" + name
}

// PolicyAdmin is a route policy name, not an authorization check. Business
// policy middleware is wired in internal/di/http_policies.go.
const PolicyAdmin = "admin"

// NamedPolicy binds a route policy name to its enforcing middleware.
// A route that references an undeclared name fails at startup.
type NamedPolicy struct {
	Name       string
	Middleware httpx.Middleware
}
