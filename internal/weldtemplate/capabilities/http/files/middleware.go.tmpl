package httpserver

import (
	"time"

	"__module__/internal/config"
	"__module__/internal/httpx"

	"__module__/internal/logging"
)

// middlewareChain is the project-owned middleware configuration.
//
// It is the one place the HTTP middleware stack is declared, and it is written
// once when the http capability is installed: weld never regenerates this file,
// so edits here survive every later `weld add`. Reorder the list, remove an
// entry or append your own middleware; Chain applies whatever this returns, so
// the Loom composition always serves this stack.
//
// The list is applied outer-to-inner: the first entry is the outermost wrapper,
// so it sees a request first and the response last. The default order is
//
//	CORS       answers a cross-origin preflight from cors.* in config.yml
//	RequestID  assigns and echoes X-Request-Id and stores it on the context
//	AccessLog  records one structured line per request (no bodies, no query)
//	Recover    turns a handler panic into a logged 500 error envelope
//
// CORS is first and only installed when config.yml enables it: a preflight is
// answered before the router, and the headers are already on the response when
// anything further in can refuse the request, so a browser sees the real status
// (401, 403, 500) instead of an opaque CORS failure. A preflight is
// deliberately not access-logged; it is browser bookkeeping, not application
// traffic.
//
// No authentication or rate limiting is enabled by default: add such middleware
// here when the project needs it. Authorization belongs in the named route
// policies (policy.go), which run inside this chain and are never bypassed by
// CORS. The base CLI installs none of this, because it has no HTTP server.
func middlewareChain(cfg *config.Config, logger logging.Logger) []httpx.Middleware {
	chain := make([]httpx.Middleware, 0, 4)
	if cors := corsMiddleware(cfg); cors != nil {
		chain = append(chain, cors)
	}
	return append(chain,
		httpx.RequestID(),
		httpx.AccessLog(logger),
		httpx.Recover(logger),
	)
}

// corsMiddleware translates the typed cors section into the toolkit's policy.
//
// It returns nil when the section is disabled, so a project that needs no CORS
// installs no middleware and pays nothing. The translation lives here rather
// than in internal/httpx so the toolkit stays free of the project's
// configuration types and usable by a project that configures CORS in code.
func corsMiddleware(cfg *config.Config) httpx.Middleware {
	if cfg == nil || !cfg.CORS.Enabled {
		return nil
	}
	return httpx.CORS(httpx.CORSConfig{
		AllowedOrigins:   cfg.CORS.AllowedOrigins,
		AllowedMethods:   cfg.CORS.AllowedMethods,
		AllowedHeaders:   cfg.CORS.AllowedHeaders,
		ExposedHeaders:   cfg.CORS.ExposedHeaders,
		AllowCredentials: cfg.CORS.AllowCredentials,
		MaxAge:           time.Duration(cfg.CORS.MaxAgeSeconds) * time.Second,
	})
}
