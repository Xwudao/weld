package httpx

import (
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"strings"
	"sync"
)

// Router registers routes on a *http.ServeMux under a shared path prefix,
// middleware chain and set of named policies.
//
// It is a thin wrapper, not a second router: the mux a caller composes stays the
// single routing surface, so a Router adds prefixing, middleware, named policies
// and the typed endpoint helpers without owning a global registry or a server.
// Group derives a sub-router; Handle and HandleFunc register a raw net/http
// handler for a response the typed helpers do not model, such as a file
// download, a stream or SSE. The router also records every route it registers,
// so a development build can log the composed surface and the policies guarding
// each route (see Routes and LogRoutes).
type Router struct {
	mux        *http.ServeMux
	prefix     string
	middleware []Middleware
	// policies maps a policy name to the middleware a route in that policy must
	// pass. The composition root defines them; a module only references a name.
	policies map[string][]Middleware
	// required is the mount's baseline: every route registered under this router
	// runs these policies unless it opts out with Open. It makes the default
	// fail-closed, so forgetting a Policy on a sensitive route still runs the
	// baseline rather than serving it unguarded.
	required []string
	// routes is the composition-wide route table. Every router derived from the
	// same NewRouter shares this one table because they all register on the same
	// mux, so Routes reports the whole composed surface regardless of which group
	// registered a route.
	routes *routeTable
}

// Route describes one route registered on the composition's mux. It is what
// Router.Routes returns so a development build can print the composed surface.
type Route struct {
	// Method is the HTTP method, or "*" when the pattern carried no method.
	Method string
	// Pattern is the full path pattern registered on the mux, including any
	// group prefix.
	Pattern string
	// Policies lists the named policies that guard the route, mount baseline
	// first. An empty slice means the route is public.
	Policies []string
}

// routeTable is the shared, append-only record of the routes registered on one
// mux. A mutex guards it because registration and a route dump need not share a
// goroutine.
type routeTable struct {
	mu     sync.Mutex
	routes []Route
}

func (t *routeTable) add(route Route) {
	t.mu.Lock()
	t.routes = append(t.routes, route)
	t.mu.Unlock()
}

func (t *routeTable) all() []Route {
	t.mu.Lock()
	defer t.mu.Unlock()
	return append([]Route(nil), t.routes...)
}

// NewRouter returns a Router that registers routes on mux.
func NewRouter(mux *http.ServeMux) *Router {
	return &Router{mux: mux, routes: &routeTable{}}
}

// WithPolicy defines a named policy as a middleware chain, outermost first.
//
// The composition root declares policies here once; a module references one by
// name with the Policy option. Redefining a name replaces it. The receiver is
// unchanged, so a caller can build a base and derive mounts from it.
func (r *Router) WithPolicy(name string, middleware ...Middleware) *Router {
	next := r.clone()
	next.policies[name] = append([]Middleware(nil), middleware...)
	return next
}

// Require sets the mount's baseline policies: every route registered under the
// returned router runs them, in order, unless the route opts out with Open.
//
// It is what makes policy coverage fail-closed: a new route under the mount is
// guarded by the baseline even when its author forgets to add a Policy. A route
// that must be reachable without the baseline declares it explicitly with Open.
func (r *Router) Require(names ...string) *Router {
	next := r.clone()
	next.required = append(next.required, names...)
	return next
}

// Group returns a sub-router whose routes share prefix and additionally run
// middleware, outermost first.
//
// The receiver is unchanged, so deriving and discarding a group never affects
// routes registered elsewhere. An empty prefix keeps the parent's path and adds
// only the middleware. Policies and the baseline are inherited.
func (r *Router) Group(prefix string, middleware ...Middleware) *Router {
	next := r.clone()
	next.prefix = joinPath(r.prefix, prefix)
	next.middleware = append(next.middleware, middleware...)
	return next
}

// Handle registers a raw handler under the router's prefix.
//
// It is the escape hatch for a response the typed helpers do not express, such
// as a file download, a stream or a body in another envelope. The pattern may
// carry an explicit method ("GET /items") or be a plain path. A raw route still
// runs the router's baseline policies and any Policy it is given, exactly like a
// typed route, so a guarded surface cannot be bypassed through a raw handler;
// pass Open() for a raw route that must skip the baseline.
func (r *Router) Handle(pattern string, handler http.Handler, opts ...Option) {
	cfg := resolveEndpoint(opts)
	names := r.routePolicyNames(cfg)
	full := r.fullPattern(pattern)
	r.record(full, names)
	r.mux.Handle(full, r.wrap(Chain(r.resolvePolicies(names)...)(handler)))
}

// HandleFunc registers a raw handler function under the router's prefix.
func (r *Router) HandleFunc(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Handle(pattern, handler, opts...)
}

// Raw registers a raw handler for one method at pattern.
//
// Get, Delete, Post, Put and Patch cover the common verbs; Raw is for a method
// they do not (HEAD, OPTIONS). All of them take the method and the path as
// separate arguments, so a route built from a path constant does not assemble a
// "METHOD /path" string by hand. The handler writes its own response, while the
// router still applies the mount baseline and any Policy, exactly like
// HandleFunc.
func (r *Router) Raw(method, pattern string, handler http.HandlerFunc, opts ...Option) {
	r.HandleFunc(method+" "+pattern, handler, opts...)
}

// Get registers a raw GET handler at pattern.
//
// It is the raw counterpart of the package-level Get: the handler receives the
// *http.Request and writes the response itself — a legacy envelope, a download, a
// stream — while the router still applies the mount's baseline and any Policy. Go
// has no generic methods, so the typed endpoint helpers are package functions
// (httpx.Get[Req, Resp]) and these raw verb methods live on the Router:
//
//	router.Get(RoutePrefix+"/all", handleAll(service))
func (r *Router) Get(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Raw(http.MethodGet, pattern, handler, opts...)
}

// Delete registers a raw DELETE handler at pattern; see Get.
func (r *Router) Delete(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Raw(http.MethodDelete, pattern, handler, opts...)
}

// Post registers a raw POST handler at pattern; see Get.
func (r *Router) Post(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Raw(http.MethodPost, pattern, handler, opts...)
}

// Put registers a raw PUT handler at pattern; see Get.
func (r *Router) Put(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Raw(http.MethodPut, pattern, handler, opts...)
}

// Patch registers a raw PATCH handler at pattern; see Get.
func (r *Router) Patch(pattern string, handler http.HandlerFunc, opts ...Option) {
	r.Raw(http.MethodPatch, pattern, handler, opts...)
}

// clone returns a copy that shares the mux but owns its own configuration, so a
// derived router never mutates its parent.
func (r *Router) clone() *Router {
	policies := make(map[string][]Middleware, len(r.policies)+1)
	for name, chain := range r.policies {
		policies[name] = chain
	}
	return &Router{
		mux:        r.mux,
		prefix:     r.prefix,
		middleware: append([]Middleware(nil), r.middleware...),
		policies:   policies,
		required:   append([]string(nil), r.required...),
		routes:     r.routes,
	}
}

// wrap applies the router's middleware to one handler, outermost first.
func (r *Router) wrap(handler http.Handler) http.Handler {
	return Chain(r.middleware...)(handler)
}

// routePolicyNames lists the policies a route runs: the mount baseline unless
// the route opts out with Open, followed by the route's own policies, with
// duplicates removed so a route that repeats a baseline policy runs it once.
func (r *Router) routePolicyNames(cfg *endpoint) []string {
	names := make([]string, 0, len(r.required)+len(cfg.policy))
	if !cfg.open {
		names = append(names, r.required...)
	}
	names = append(names, cfg.policy...)
	return dedupePolicies(names)
}

// dedupePolicies removes repeated policy names, keeping the first occurrence.
func dedupePolicies(names []string) []string {
	if len(names) < 2 {
		return names
	}
	seen := make(map[string]bool, len(names))
	unique := make([]string, 0, len(names))
	for _, name := range names {
		if seen[name] {
			continue
		}
		seen[name] = true
		unique = append(unique, name)
	}
	return unique
}

// resolvePolicies turns route policy names into one ordered middleware chain.
//
// An unknown name is a startup error, not a silent pass-through: a policy the
// composition never defined must fail loudly rather than serve the route
// unguarded.
func (r *Router) resolvePolicies(names []string) []Middleware {
	if len(names) == 0 {
		return nil
	}
	chain := make([]Middleware, 0, len(names))
	for _, name := range names {
		middleware, ok := r.policies[name]
		if !ok {
			panic(fmt.Sprintf("httpx: route references undefined policy %q", name))
		}
		chain = append(chain, middleware...)
	}
	return chain
}

// fullPattern returns the ServeMux pattern for one route, keeping an explicit
// method in front of the joined path.
func (r *Router) fullPattern(pattern string) string {
	if method, path, ok := splitMethod(pattern); ok {
		return method + " " + joinPath(r.prefix, path)
	}
	return joinPath(r.prefix, pattern)
}

// splitMethod splits a ServeMux pattern that names a method ("GET /items") into
// its method and path. A pattern without a space is a plain path.
func splitMethod(pattern string) (method, path string, ok bool) {
	index := strings.IndexByte(pattern, ' ')
	if index < 0 {
		return "", pattern, false
	}
	return pattern[:index], strings.TrimSpace(pattern[index+1:]), true
}

// joinPath joins a router prefix and a route path with exactly one slash. An
// empty path keeps the prefix; an explicit trailing slash on the path is kept,
// so a subtree pattern still ends in a slash.
func joinPath(prefix, path string) string {
	prefix = strings.TrimSuffix(prefix, "/")
	if prefix != "" && !strings.HasPrefix(prefix, "/") {
		prefix = "/" + prefix
	}
	if path == "" {
		if prefix == "" {
			return "/"
		}
		return prefix
	}
	return prefix + "/" + strings.TrimPrefix(path, "/")
}

// record adds one registered route to the shared table.
func (r *Router) record(pattern string, policies []string) {
	if r.routes == nil {
		return
	}
	method, path, ok := splitMethod(pattern)
	if !ok {
		method = "*"
	}
	r.routes.add(Route{Method: method, Pattern: path, Policies: append([]string(nil), policies...)})
}

// Routes returns the routes registered on the composition's mux, in
// registration order. Every router derived from the same NewRouter shares one
// table, so it reports the whole composed surface regardless of which group
// registered a route. The result is a copy the caller may keep.
func (r *Router) Routes() []Route {
	if r.routes == nil {
		return nil
	}
	return r.routes.all()
}

// LogRoutes logs one line per registered route with its full pattern and the
// policies that guard it. The composition calls it in a development
// environment, so the composed surface and its coverage are visible at startup
// without a request. A nil logger is a no-op.
func (r *Router) LogRoutes(logger *slog.Logger) {
	if logger == nil {
		return
	}
	for _, route := range r.Routes() {
		logger.Info("route", "method", route.Method, "path", route.Pattern, "policies", policyLabel(route.Policies))
	}
}

// PrintRoutes writes the registered routes to w as a plain table, for a command
// or a test. It is the writer form of LogRoutes. A nil writer is a no-op.
func (r *Router) PrintRoutes(w io.Writer) {
	if w == nil {
		return
	}
	for _, route := range r.Routes() {
		fmt.Fprintf(w, "%-7s %-40s %s\n", route.Method, route.Pattern, policyLabel(route.Policies))
	}
}

// policyLabel renders a route's guarding policies for the route dump: the names
// joined, or "public" when the route runs none.
func policyLabel(policies []string) string {
	if len(policies) == 0 {
		return "public"
	}
	return strings.Join(policies, ",")
}
