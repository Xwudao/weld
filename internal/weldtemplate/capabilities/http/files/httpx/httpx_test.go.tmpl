package httpx

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

// This file covers the response writers: the default envelope and the raw
// writers that must stay unwrapped.

func TestJSONWrapsDataInTheEnvelope(t *testing.T) {
	recorder := httptest.NewRecorder()
	JSON(recorder, http.StatusCreated, map[string]any{"id": "item-1"})

	if recorder.Code != http.StatusCreated {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusCreated)
	}
	if got := recorder.Header().Get("Content-Type"); !strings.Contains(got, "application/json") {
		t.Fatalf("content-type = %q, want application/json", got)
	}
	var envelope struct {
		Code int            `json:"code"`
		Msg  string         `json:"msg"`
		Data map[string]any `json:"data"`
	}
	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	if envelope.Code != http.StatusCreated {
		t.Errorf("code = %d, want the transport status %d", envelope.Code, http.StatusCreated)
	}
	if envelope.Msg != SuccessMsg {
		t.Errorf("msg = %q, want %q", envelope.Msg, SuccessMsg)
	}
	if envelope.Data["id"] != "item-1" {
		t.Errorf("data = %v", envelope.Data)
	}
}

func TestErrorEnvelopeHasNullData(t *testing.T) {
	recorder := httptest.NewRecorder()
	Error(recorder, http.StatusNotFound, "item not found")

	if recorder.Code != http.StatusNotFound {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusNotFound)
	}
	var envelope struct {
		Code int             `json:"code"`
		Msg  string          `json:"msg"`
		Data json.RawMessage `json:"data"`
	}
	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	if envelope.Code != http.StatusNotFound || envelope.Msg != "item not found" {
		t.Errorf("envelope = %+v", envelope)
	}
	if string(envelope.Data) != "null" {
		t.Errorf("data = %s, want null", envelope.Data)
	}
}

// TestJSONMarshalsBeforeWritingHeaders proves a marshal failure cannot emit a
// success status with a partial or broken body: the response is a complete
// internal-error envelope instead.
func TestJSONMarshalsBeforeWritingHeaders(t *testing.T) {
	recorder := httptest.NewRecorder()
	JSON(recorder, http.StatusOK, make(chan int))

	if recorder.Code != http.StatusInternalServerError {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusInternalServerError)
	}
	var envelope Envelope
	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	if envelope.Code != http.StatusInternalServerError || envelope.Msg != ErrorMsg {
		t.Fatalf("envelope = %+v", envelope)
	}
}

func TestWriteErrorMapsDecodeErrorAndRedactsOthers(t *testing.T) {
	recorder := httptest.NewRecorder()
	WriteError(recorder, &DecodeError{Status: http.StatusUnsupportedMediaType, Message: "Content-Type must be application/json"})
	if recorder.Code != http.StatusUnsupportedMediaType {
		t.Fatalf("decode error status = %d, want 415", recorder.Code)
	}

	recorder = httptest.NewRecorder()
	WriteError(recorder, errSentinel{})
	if recorder.Code != http.StatusInternalServerError {
		t.Fatalf("unexpected error status = %d, want 500", recorder.Code)
	}
	if strings.Contains(recorder.Body.String(), "sentinel") {
		t.Fatalf("an unexpected error leaked its message: %s", recorder.Body)
	}
}

type errSentinel struct{}

func (errSentinel) Error() string { return "sentinel internal detail" }

func TestRawWritersStayUnwrapped(t *testing.T) {
	t.Run("raw json", func(t *testing.T) {
		recorder := httptest.NewRecorder()
		RawJSON(recorder, http.StatusOK, map[string]any{"openapi": "3.1.0"})
		var document map[string]any
		if err := json.Unmarshal(recorder.Body.Bytes(), &document); err != nil {
			t.Fatalf("decode: %v", err)
		}
		if document["openapi"] != "3.1.0" {
			t.Fatalf("document = %v, want the raw document", document)
		}
		if _, wrapped := document["code"]; wrapped {
			t.Fatalf("the raw document was wrapped: %v", document)
		}
	})

	t.Run("raw text", func(t *testing.T) {
		recorder := httptest.NewRecorder()
		RawText(recorder, http.StatusOK, "plain")
		if got := recorder.Header().Get("Content-Type"); !strings.HasPrefix(got, "text/plain") {
			t.Fatalf("content-type = %q, want text/plain", got)
		}
		if recorder.Body.String() != "plain" {
			t.Fatalf("body = %q, want the raw text", recorder.Body.String())
		}
	})

	t.Run("bytes", func(t *testing.T) {
		recorder := httptest.NewRecorder()
		Bytes(recorder, http.StatusOK, "application/octet-stream", []byte{0x1, 0x2})
		if recorder.Body.Len() != 2 {
			t.Fatalf("body length = %d, want the raw bytes", recorder.Body.Len())
		}
	})

	t.Run("no content", func(t *testing.T) {
		recorder := httptest.NewRecorder()
		NoContent(recorder, http.StatusNoContent)
		if recorder.Code != http.StatusNoContent || recorder.Body.Len() != 0 {
			t.Fatalf("no-content response = %d %q", recorder.Code, recorder.Body.String())
		}
	})
}
