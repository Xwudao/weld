package httpx

import (
	"errors"
	"net/http"
	"net/http/httptest"
	"testing"
)

// bindTarget exercises the supported field kinds, including an untagged field
// that must stay untouched and an optional pointer.
type bindTarget struct {
	Name    string   `query:"name"`
	Count   int      `query:"count"`
	Ratio   float64  `query:"ratio"`
	Enabled bool     `query:"enabled"`
	Labels  []string `query:"label"`
	Page    *int     `query:"page"`
	Ignored string
}

func TestBindQueryParsesEveryKind(t *testing.T) {
	request := httptest.NewRequest(http.MethodGet, "/x?name=Ada&count=3&ratio=0.5&enabled=true&label=a&label=b&page=4", nil)
	got, err := BindQuery[bindTarget](request)
	if err != nil {
		t.Fatalf("BindQuery: %v", err)
	}
	if got.Name != "Ada" || got.Count != 3 || got.Ratio != 0.5 || !got.Enabled {
		t.Fatalf("bound = %+v", got)
	}
	if len(got.Labels) != 2 || got.Labels[0] != "a" || got.Labels[1] != "b" {
		t.Fatalf("labels = %v", got.Labels)
	}
	if got.Page == nil || *got.Page != 4 {
		t.Fatalf("page = %v, want 4", got.Page)
	}
	if got.Ignored != "" {
		t.Fatalf("an untagged field was bound: %q", got.Ignored)
	}
}

func TestBindQueryLeavesAbsentOptionalNil(t *testing.T) {
	got, err := BindQuery[bindTarget](httptest.NewRequest(http.MethodGet, "/x", nil))
	if err != nil {
		t.Fatalf("BindQuery: %v", err)
	}
	if got.Page != nil {
		t.Fatalf("page = %v, want nil", got.Page)
	}
}

func TestBindQueryRejectsMalformedValue(t *testing.T) {
	_, err := BindQuery[bindTarget](httptest.NewRequest(http.MethodGet, "/x?count=abc", nil))
	var decodeErr *DecodeError
	if !errors.As(err, &decodeErr) || decodeErr.Status != http.StatusBadRequest {
		t.Fatalf("err = %v, want a 400 *DecodeError", err)
	}
}

// pathTarget reads a path parameter, so a field can be bound from the matched
// route rather than the query string.
type pathTarget struct {
	ID   string `path:"id"`
	Name string `query:"name"`
}

func TestBindQueryReadsPathValues(t *testing.T) {
	request := httptest.NewRequest(http.MethodGet, "/items/item-9?name=Ada", nil)
	request.SetPathValue("id", "item-9")
	got, err := BindQuery[pathTarget](request)
	if err != nil {
		t.Fatalf("BindQuery: %v", err)
	}
	if got.ID != "item-9" || got.Name != "Ada" {
		t.Fatalf("bound = %+v, want id item-9 and name Ada", got)
	}
}

func TestBindQueryPointerStructAndSlice(t *testing.T) {
	type names []string
	type input struct {
		Labels *names  `query:"label"`
		Name   *string `query:"name"`
	}
	got, err := BindQuery[*input](httptest.NewRequest("GET", "/?label=a&label=b&name=", nil))
	if err != nil {
		t.Fatal(err)
	}
	if got == nil || got.Labels == nil || len(*got.Labels) != 2 || got.Name == nil || *got.Name != "" {
		t.Fatalf("bound = %+v", got)
	}
}

func TestBindQueryRejectsUnsupportedDTO(t *testing.T) {
	if _, err := BindQuery[int](httptest.NewRequest("GET", "/", nil)); err == nil {
		t.Fatal("unsupported target silently accepted")
	}
}

func TestPresentEmptyScalarIsNotMissing(t *testing.T) {
	type input struct {
		Count    int  `query:"count"`
		Optional *int `query:"optional"`
	}
	for _, path := range []string{"/?count=", "/?optional="} {
		_, err := BindQuery[input](httptest.NewRequest("GET", path, nil))
		var decode *DecodeError
		if !errors.As(err, &decode) || decode.Status != 400 {
			t.Fatalf("%s: %v", path, err)
		}
	}
	_, present, err := QueryInt(httptest.NewRequest("GET", "/?count=", nil), "count")
	if !present || err == nil {
		t.Fatalf("present=%v err=%v", present, err)
	}
	_, present, err = QueryInt(httptest.NewRequest("GET", "/", nil), "count")
	if present || err != nil {
		t.Fatalf("present=%v err=%v", present, err)
	}
}

func TestQueryIntDistinguishesAbsentFromValue(t *testing.T) {
	if value, present, err := QueryInt(httptest.NewRequest(http.MethodGet, "/?limit=5", nil), "limit"); err != nil || !present || value != 5 {
		t.Fatalf("present limit = %d, %v, %v", value, present, err)
	}
	if value, present, err := QueryInt(httptest.NewRequest(http.MethodGet, "/", nil), "limit"); err != nil || present || value != 0 {
		t.Fatalf("absent limit = %d, %v, %v", value, present, err)
	}
	_, present, err := QueryInt(httptest.NewRequest(http.MethodGet, "/?limit=abc", nil), "limit")
	var decodeErr *DecodeError
	if !present || !errors.As(err, &decodeErr) || decodeErr.Status != http.StatusBadRequest {
		t.Fatalf("non-integer limit = present %v, err %v", present, err)
	}
}
