# weld:db:installed __version__
# PostgreSQL connection. The password may live here for local development;
# production should override DB_PASSWORD or DATABASE_URL in the environment.
# There is no default credential: set user, password and name, or a dsn.
database:
  host: localhost
  port: 5432
  user: ""
  password: ""
  name: ""
  dsn: ""

# The PostgreSQL integration tests use a dedicated database, never the one
# above. Set database_test.name to run them (for example app_test); the other
# fields inherit from the database section. PG_TEST_DSN (or TEST_DATABASE_URL)
# overrides this section in CI. schema_only reuses the application database in a
# throwaway schema and is refused outside local/development/test. See
# internal/data/README.md.
database_test:
  name: ""
  # host: ""
  # port: 0
  # user: ""
  # password: ""
  # dsn: ""
  # schema_only: false
