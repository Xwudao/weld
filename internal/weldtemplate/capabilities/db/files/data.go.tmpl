// Package data is the PostgreSQL persistence layer of __name__.
//
// The SQL is the source of truth: db/migrations owns the schema, db/query owns
// the statements, and sqlc generates internal/data/sqlc from both. This package
// wraps the generated queries behind a small Repository interface, translates
// generated rows into a domain Item and exposes the connection pool as an
// injected dependency.
//
// It is independent of the HTTP layer: it imports pgx, not net/http, and its
// model carries no JSON tags, so the HTTP DTOs in internal/api never see a sqlc
// row and a schema change cannot silently alter the wire contract.
package data

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	sqlc "__module__/internal/data/sqlc"
	"__module__/internal/logging"
)

// ErrNotFound is returned when a requested row does not exist.
var ErrNotFound = errors.New("data: item not found")

// Item is the persistence model of an item.
//
// It deliberately has no JSON tags: the HTTP layer owns its own DTOs, so the
// storage shape and the wire shape stay independent.
type Item struct {
	ID        string
	Name      string
	Quantity  int
	Status    string
	CreatedAt time.Time
}

// Repository is the persistence contract the application depends on.
//
// It is expressed in domain types rather than sqlc rows, and every method takes
// a context first. PostgresRepository is the generated PostgreSQL
// implementation; a consumer that needs less can declare a narrower interface
// of its own against the same methods.
type Repository interface {
	CreateItem(ctx context.Context, item Item) (Item, error)
	GetItem(ctx context.Context, id string) (Item, error)
	ListItems(ctx context.Context, limit int) ([]Item, error)
}

// PoolOption configures the pool NewPool opens.
type PoolOption func(*pgxpool.Config)

// WithQueryLog attaches a tracer that logs every statement pgx runs, one record
// per statement. The caller decides whether to attach it — the composition root
// attaches it only in a development environment — so this package never reads the
// environment and a production pool logs no statement.
//
// The record carries logging.StatementKey, then "args", "duration" and either
// "rows" or "error", so the text handler paints the statement and the rest reads
// as an ordinary record. It is logged at info level, like the other
// development-only diagnostics (see the route log in internal/di), because the
// graph's logger is built at the default level. The arguments are recorded
// verbatim, so a development pool is the only place to attach it: a production
// statement's arguments can hold a credential.
func WithQueryLog(logger *slog.Logger) PoolOption {
	return func(config *pgxpool.Config) {
		config.ConnConfig.Tracer = queryLogger{logger: logger}
	}
}

// NewPool opens a PostgreSQL connection pool from dsn.
//
// The pool is created lazily: NewPool parses the dsn but never connects or
// pings, so it succeeds with a well-formed dsn even while the database is down.
// Call pool.Ping(ctx) to verify connectivity and pool.Close() when done. The
// dsn is a caller-supplied value (for example from an environment variable) and
// is never read or logged here, so no credential enters this package. options
// configures the pool; WithQueryLog is the one this package defines.
//
// A dsn that does not parse reports a fixed error rather than the parser's own:
// the parser error can quote the dsn and its password, and the caller logs the
// error it gets back, so this boundary must not carry a credential into a log
// record.
func NewPool(ctx context.Context, dsn string, options ...PoolOption) (*pgxpool.Pool, error) {
	config, err := pgxpool.ParseConfig(dsn)
	if err != nil {
		// Do not echo the dsn or the parser error: either may carry a credential.
		return nil, errors.New("data: invalid PostgreSQL dsn")
	}
	for _, option := range options {
		option(config)
	}
	pool, err := pgxpool.NewWithConfig(ctx, config)
	if err != nil {
		return nil, fmt.Errorf("data: create connection pool: %w", err)
	}
	return pool, nil
}

// PostgresRepository is the pgx-backed Repository.
type PostgresRepository struct {
	queries *sqlc.Queries
}

// NewRepository returns the PostgreSQL Repository backed by pool.
//
// The pool is injected, so the application owns its lifecycle and a test can
// supply its own.
func NewRepository(pool *pgxpool.Pool) *PostgresRepository {
	return &PostgresRepository{queries: sqlc.New(pool)}
}

// itemFromSQLC converts a generated row into the domain model. It is the only
// place that knows the shape of a sqlc row, so generated detail does not leak
// past this package.
func itemFromSQLC(row sqlc.Item) Item {
	return Item{
		ID:        row.ID,
		Name:      row.Name,
		Quantity:  int(row.Quantity),
		Status:    row.Status,
		CreatedAt: row.CreatedAt.Time.UTC(),
	}
}

// CreateItem inserts item and returns it as stored, including created_at.
func (r *PostgresRepository) CreateItem(ctx context.Context, item Item) (Item, error) {
	row, err := r.queries.CreateItem(ctx, sqlc.CreateItemParams{
		ID:       item.ID,
		Name:     item.Name,
		Quantity: int32(item.Quantity),
		Status:   item.Status,
	})
	if err != nil {
		return Item{}, fmt.Errorf("data: create item: %w", err)
	}
	return itemFromSQLC(row), nil
}

// GetItem returns the item with id, or ErrNotFound when it does not exist.
func (r *PostgresRepository) GetItem(ctx context.Context, id string) (Item, error) {
	row, err := r.queries.GetItem(ctx, id)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Item{}, ErrNotFound
		}
		return Item{}, fmt.Errorf("data: get item %q: %w", id, err)
	}
	return itemFromSQLC(row), nil
}

// ListItems returns up to limit items, oldest first.
func (r *PostgresRepository) ListItems(ctx context.Context, limit int) ([]Item, error) {
	rows, err := r.queries.ListItems(ctx, int32(limit))
	if err != nil {
		return nil, fmt.Errorf("data: list items: %w", err)
	}
	items := make([]Item, len(rows))
	for i, row := range rows {
		items[i] = itemFromSQLC(row)
	}
	return items, nil
}

// WithTx runs fn inside a transaction, committing on success and rolling back
// when fn returns an error or panics.
//
// It is the narrow transaction seam: fn receives a Repository bound to the
// transaction, so several calls share one connection and commit or roll back
// together without the caller handling pgx.Tx.
func WithTx(ctx context.Context, pool *pgxpool.Pool, fn func(repo *PostgresRepository) error) error {
	return pgx.BeginFunc(ctx, pool, func(tx pgx.Tx) error {
		return fn(&PostgresRepository{queries: sqlc.New(tx)})
	})
}

// queryLogger logs every statement the pool runs. It is attached only through
// WithQueryLog, so a pool without one pays nothing for it.
type queryLogger struct{ logger *slog.Logger }

// queryTrace is a statement in flight: TraceQueryStart records it on the context
// that pgx hands back to TraceQueryEnd.
type queryTrace struct {
	sql   string
	args  []any
	start time.Time
}

// queryTraceKey is the context key a queryTrace travels under.
type queryTraceKey struct{}

// TraceQueryStart is part of pgx.QueryTracer. It cannot fail, so the statement,
// its arguments and the start time are the only state it carries forward.
func (l queryLogger) TraceQueryStart(ctx context.Context, _ *pgx.Conn, data pgx.TraceQueryStartData) context.Context {
	return context.WithValue(ctx, queryTraceKey{}, queryTrace{sql: data.SQL, args: data.Args, start: time.Now()})
}

// TraceQueryEnd is part of pgx.QueryTracer. It writes one record — the statement,
// the arguments, the elapsed time and the outcome — so a statement is one line in
// the log rather than two.
func (l queryLogger) TraceQueryEnd(ctx context.Context, _ *pgx.Conn, data pgx.TraceQueryEndData) {
	trace, _ := ctx.Value(queryTraceKey{}).(queryTrace)
	fields := []any{
		logging.StatementKey, trace.sql,
		"args", trace.args,
		"duration", time.Since(trace.start),
	}
	if data.Err != nil {
		l.logger.Info("query failed", append(fields, "error", data.Err)...)
		return
	}
	l.logger.Info("query", append(fields, "rows", data.CommandTag.RowsAffected())...)
}
