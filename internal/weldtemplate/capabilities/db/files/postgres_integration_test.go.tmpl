package data

import (
	"context"
	"errors"
	"testing"

	"__module__/internal/testdb"
)

// TestPostgresRepositoryIntegration exercises the generated SQL against a real
// PostgreSQL server. It runs only when a test database is configured: set
// database_test.name in config.yml (for example app_test) or PG_TEST_DSN.
//
// testdb.Pool(t) owns the details: it creates a unique throwaway schema, points
// the pool's search_path at it, applies db/migrations there, and drops only that
// schema when the test finishes. The application database is never touched
// unless database_test.schema_only is set on purpose, and no credential is ever
// logged. See internal/testdb and internal/data/README.md.
func TestPostgresRepositoryIntegration(t *testing.T) {
	pool := testdb.Pool(t)
	ctx := context.Background()

	repository := NewRepository(pool)
	item := Item{ID: "item-1", Name: "widget", Quantity: 3, Status: "active"}

	created, err := repository.CreateItem(ctx, item)
	if err != nil {
		t.Fatalf("CreateItem: %v", err)
	}
	if created.ID != item.ID || created.Name != item.Name || created.Quantity != item.Quantity ||
		created.Status != item.Status || created.CreatedAt.IsZero() {
		t.Fatalf("CreateItem returned %+v", created)
	}

	got, err := repository.GetItem(ctx, item.ID)
	if err != nil {
		t.Fatalf("GetItem: %v", err)
	}
	if got != created {
		t.Fatalf("GetItem = %+v, want %+v", got, created)
	}

	if _, err := repository.GetItem(ctx, "missing"); !errors.Is(err, ErrNotFound) {
		t.Fatalf("GetItem(missing) error = %v, want ErrNotFound", err)
	}

	items, err := repository.ListItems(ctx, 10)
	if err != nil {
		t.Fatalf("ListItems: %v", err)
	}
	if len(items) != 1 || items[0] != created {
		t.Fatalf("ListItems = %+v, want [%+v]", items, created)
	}

	// A committed transaction persists.
	if err := WithTx(ctx, pool, func(repo *PostgresRepository) error {
		_, err := repo.CreateItem(ctx, Item{ID: "item-2", Name: "gadget", Quantity: 1, Status: "draft"})
		return err
	}); err != nil {
		t.Fatalf("WithTx commit: %v", err)
	}
	if _, err := repository.GetItem(ctx, "item-2"); err != nil {
		t.Fatalf("committed item is missing: %v", err)
	}

	// A failed transaction rolls back and reports the original error.
	rollbackCause := errors.New("rollback on purpose")
	err = WithTx(ctx, pool, func(repo *PostgresRepository) error {
		if _, err := repo.CreateItem(ctx, Item{ID: "item-3", Name: "gizmo", Quantity: 2, Status: "draft"}); err != nil {
			return err
		}
		return rollbackCause
	})
	if !errors.Is(err, rollbackCause) {
		t.Fatalf("WithTx error = %v, want %v", err, rollbackCause)
	}
	if _, err := repository.GetItem(ctx, "item-3"); !errors.Is(err, ErrNotFound) {
		t.Fatalf("rolled-back item error = %v, want ErrNotFound", err)
	}
}
