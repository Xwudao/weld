// TestItemFromSQLC pins the row-to-domain conversion. The generated row is the
// part that changes when the schema changes, so the mapping is the unit worth
// testing without a database; the SQL itself is exercised by the gated
// PostgreSQL integration test.
func TestItemFromSQLC(t *testing.T) {
	created := time.Date(2024, 5, 1, 12, 30, 0, 0, time.UTC)
	row := sqlc.Item{
		ID:        "item-1",
		Name:      "widget",
		Quantity:  3,
		Status:    "active",
		CreatedAt: pgtype.Timestamptz{Time: created, Valid: true},
	}
	got := itemFromSQLC(row)
	want := Item{ID: "item-1", Name: "widget", Quantity: 3, Status: "active", CreatedAt: created}
	if got != want {
		t.Fatalf("itemFromSQLC = %+v, want %+v", got, want)
	}
}

// TestNewPoolRejectsMalformedDSN covers the only failure NewPool can report
// without a server: a dsn that does not parse. It never connects, so it runs
// without PostgreSQL.
func TestNewPoolRejectsMalformedDSN(t *testing.T) {
	if _, err := NewPool(context.Background(), "://not-a-dsn"); err == nil {
		t.Fatal("expected an error for a malformed dsn")
	}
}

// TestNewPoolDoesNotEchoDSN guards the credential leak this boundary must never
// open: a malformed dsn can carry a password, and the caller (the top-level
// logger) logs the error NewPool returns, so that error must not quote the dsn
// or the parser detail. Every dsn embeds a sentinel password and is malformed in
// a way the pgx parser error quotes (a colon or fragment inside the password, or
// a bad port), so a regression to passing the parser error through fails here.
func TestNewPoolDoesNotEchoDSN(t *testing.T) {
	const password = "sentinel-do-not-log"
	dsns := []string{
		"postgres://user:" + password + "@host:notaport/db",
		"postgres://user:" + password + ":extra@host:notaport/db",
		"postgres://user:" + password + "#fragment@host:notaport/db",
		"host=host password=" + password + " user=user port=notaport",
	}
	for _, dsn := range dsns {
		_, err := NewPool(context.Background(), dsn)
		if err == nil {
			t.Fatalf("NewPool(%q) succeeded, want an error", dsn)
		}
		if strings.Contains(err.Error(), password) {
			t.Errorf("NewPool(%q) error echoes the credential: %v", dsn, err)
		}
	}
}

// TestWithQueryLogAttachesATracer proves statement logging is opt-in: a pool
// configured without the option carries no tracer and logs nothing.
func TestWithQueryLogAttachesATracer(t *testing.T) {
	config, err := pgxpool.ParseConfig("postgres://user:pw@localhost:5432/app")
	if err != nil {
		t.Fatalf("ParseConfig: %v", err)
	}
	if config.ConnConfig.Tracer != nil {
		t.Fatal("a pool config without WithQueryLog already has a tracer")
	}
	WithQueryLog(slog.New(slog.NewTextHandler(io.Discard, nil)))(config)
	if config.ConnConfig.Tracer == nil {
		t.Fatal("WithQueryLog did not attach a tracer")
	}
}

// TestQueryLoggerLogsTheStatementAndResult drives the tracer directly, so the
// record it writes is pinned without a database.
func TestQueryLoggerLogsTheStatementAndResult(t *testing.T) {
	var buf bytes.Buffer
	tracer := queryLogger{logger: slog.New(slog.NewTextHandler(&buf, nil))}
	ctx := tracer.TraceQueryStart(context.Background(), nil, pgx.TraceQueryStartData{SQL: "select 1", Args: []any{7}})
	tracer.TraceQueryEnd(ctx, nil, pgx.TraceQueryEndData{CommandTag: pgconn.NewCommandTag("SELECT 1")})
	out := buf.String()
	for _, want := range []string{"level=INFO", `sql="select 1"`, "args=[7]", "duration=", "rows=1"} {
		if !strings.Contains(out, want) {
			t.Errorf("a query record is missing %q:\n%s", want, out)
		}
	}
}

// TestQueryLoggerLogsAFailure proves a failed statement is still one record, with
// the error where the row count would be.
func TestQueryLoggerLogsAFailure(t *testing.T) {
	var buf bytes.Buffer
	tracer := queryLogger{logger: slog.New(slog.NewTextHandler(&buf, nil))}
	ctx := tracer.TraceQueryStart(context.Background(), nil, pgx.TraceQueryStartData{SQL: "select 1"})
	tracer.TraceQueryEnd(ctx, nil, pgx.TraceQueryEndData{Err: errors.New("boom")})
	out := buf.String()
	if !strings.Contains(out, "error=boom") {
		t.Fatalf("a failed statement was not logged with its error:\n%s", out)
	}
	if strings.Contains(out, "rows=") {
		t.Fatalf("a failed statement logged a row count:\n%s", out)
	}
}
