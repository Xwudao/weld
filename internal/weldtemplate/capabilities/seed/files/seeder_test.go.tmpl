package seeder

import (
	"context"
	"errors"
	"strings"
	"testing"
)

func TestRegistryRunsSeedersInOrder(t *testing.T) {
	var order []string
	registry := NewRegistry()
	registry.Register("first", func(context.Context, *Deps) error {
		order = append(order, "first")
		return nil
	})
	registry.Register("second", func(context.Context, *Deps) error {
		order = append(order, "second")
		return nil
	})

	if err := NewRunner(registry, &Deps{}).Run(context.Background(), ""); err != nil {
		t.Fatalf("Run: %v", err)
	}
	if got, want := strings.Join(order, ","), "first,second"; got != want {
		t.Fatalf("execution order = %q, want %q", got, want)
	}
}

func TestRegistryStopsAtFirstError(t *testing.T) {
	ran := false
	registry := NewRegistry()
	registry.Register("boom", func(context.Context, *Deps) error {
		return errors.New("boom")
	})
	registry.Register("never", func(context.Context, *Deps) error {
		ran = true
		return nil
	})

	err := NewRunner(registry, &Deps{}).Run(context.Background(), "")
	if err == nil || !strings.Contains(err.Error(), "boom") {
		t.Fatalf("Run error = %v, want the failing seeder's error", err)
	}
	if ran {
		t.Fatal("a seeder after the failing one ran; seed must stop at the first error")
	}
}

func TestRunnerRunsASingleSeeder(t *testing.T) {
	ran := map[string]bool{}
	registry := NewRegistry()
	registry.Register("first", func(context.Context, *Deps) error {
		ran["first"] = true
		return nil
	})
	registry.Register("second", func(context.Context, *Deps) error {
		ran["second"] = true
		return nil
	})

	if err := NewRunner(registry, &Deps{}).Run(context.Background(), "second"); err != nil {
		t.Fatalf("Run(second): %v", err)
	}
	if ran["first"] || !ran["second"] {
		t.Fatalf("ran = %+v, want only second", ran)
	}
}

func TestRunnerRejectsUnknownSeeder(t *testing.T) {
	registry := NewRegistry()
	registry.Register("items", func(context.Context, *Deps) error { return nil })

	err := NewRunner(registry, &Deps{}).Run(context.Background(), "missing")
	if err == nil || !strings.Contains(err.Error(), "items") {
		t.Fatalf("Run(missing) error = %v, want an error naming the registered seeders", err)
	}
}

func TestRegisterRejectsBlankName(t *testing.T) {
	assertPanics(t, func() {
		NewRegistry().Register("  ", func(context.Context, *Deps) error { return nil })
	})
}

func TestRegisterRejectsNilSeeder(t *testing.T) {
	assertPanics(t, func() { NewRegistry().Register("items", nil) })
}

func TestRegisterRejectsDuplicate(t *testing.T) {
	assertPanics(t, func() {
		registry := NewRegistry()
		registry.Register("items", func(context.Context, *Deps) error { return nil })
		registry.Register("items", func(context.Context, *Deps) error { return nil })
	})
}

func assertPanics(t *testing.T, fn func()) {
	t.Helper()
	defer func() {
		if recover() == nil {
			t.Fatal("expected a panic")
		}
	}()
	fn()
}
