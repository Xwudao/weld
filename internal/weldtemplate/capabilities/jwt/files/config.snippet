# weld:jwt:installed __version__
# JWT bearer-token settings. The secret is required when the application builds
# a token manager; use at least 32 random bytes, keep it out of git, and
# override it in production with JWT_SECRET. The issuer is written into every
# token and required on verification. An empty audience disables the audience
# check. ttl is the token lifetime as a duration such as 15m or 120h;
# leeway_seconds tolerates small clock differences between services.
jwt:
  secret: ""
  issuer: "__name__"
  audience: ""
  ttl: 15m
  leeway_seconds: 30
