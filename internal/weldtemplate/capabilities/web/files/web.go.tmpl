// Package web serves the __name__ frontend: the Vite build output embedded at
// compile time and delivered over HTTP.
//
// The package owns no command and opens no socket. internal/httpserver wires
// Handler into the application mux, and the "serve" command (owned by the http
// capability) serves that mux.
package web

import (
	"bytes"
	"io"
	"io/fs"
	"mime"
	"net/http"
	"path"
	"strconv"
	"strings"
)

// indexFile is the SPA shell served at "/" and for client-side routes.
const indexFile = "index.html"

// encodingSidecar is one precompressed copy the build may write next to an
// asset. ext is the filename suffix, encoding the Content-Encoding it carries.
type encodingSidecar struct {
	ext      string
	encoding string
}

// sidecars lists the precompressed sidecars the build can emit, in preference
// order: when a client accepts several, the earlier entry wins a quality tie
// because brotli compresses better than gzip for the same level of effort.
var sidecars = []encodingSidecar{
	{ext: ".br", encoding: "br"},
	{ext: ".gz", encoding: "gzip"},
}

// Handler returns the HTTP handler for the embedded frontend.
//
// The handler serves the build output and falls back to index.html so that
// client-side routes keep working. reservedPrefix — the API mount, normally
// httpserver.APIPrefix — is reserved for the API and the business modules:
// unknown paths under it return 404 instead of the SPA, and only browser
// navigations (GET/HEAD that accept text/html) fall back, so a fetch to a
// missing endpoint never receives the HTML shell. Passing the prefix keeps the
// reservation correct when the surface is versioned or mounted elsewhere.
//
// The frontend build writes a precompressed ".br" and ".gz" sidecar next to
// every compressible asset, and all files are embedded in the binary. A request
// for the plain path negotiates: a client that accepts brotli or gzip receives
// the matching sidecar with the right Content-Encoding and no per-request
// compression happens.
func Handler(reservedPrefix string) http.Handler {
	return handler(dist, reservedPrefix)
}

func handler(assets fs.FS, reservedPrefix string) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if isAPIPath(r.URL.Path, reservedPrefix) {
			http.NotFound(w, r)
			return
		}
		name := strings.TrimPrefix(r.URL.Path, "/")
		if name == "" {
			name = indexFile
		}
		// A client never asks for a sidecar: only the plain path negotiates an
		// encoding, so a direct request for a compressed copy is a 404 rather
		// than a second, misleading URL for the same asset.
		if hasSidecarSuffix(name) {
			http.NotFound(w, r)
			return
		}
		if fs.ValidPath(name) && serveAsset(assets, w, r, name) {
			return
		}
		if !isBrowserNavigation(r) || !hasIndex(assets) {
			http.NotFound(w, r)
			return
		}
		if !serveAsset(assets, w, r, indexFile) {
			http.NotFound(w, r)
		}
	})
}

// serveAsset writes the embedded file name, preferring the best precompressed
// sidecar the client accepts. It reports whether it wrote a response.
func serveAsset(assets fs.FS, w http.ResponseWriter, r *http.Request, name string) bool {
	// The content type comes from the plain name; a sidecar's own extension
	// would report application/gzip or application/octet-stream instead of the
	// real media type.
	contentType := mime.TypeByExtension(path.Ext(name))
	if contentType != "" {
		explicit, wildcard := acceptedEncodings(r)
		var chosen fs.File
		var chosenInfo fs.FileInfo
		var chosenEncoding string
		best := 0.0
		for _, sidecar := range sidecars {
			f, info, ok := openAsset(assets, name+sidecar.ext)
			if !ok {
				continue
			}
			// A precompressed copy exists, so the body depends on Accept-Encoding
			// and a shared cache must key on it whether or not this request takes
			// the compressed copy.
			w.Header().Set("Vary", "Accept-Encoding")
			quality := encodingQuality(explicit, wildcard, sidecar.encoding)
			if quality <= 0 || quality <= best {
				_ = f.Close()
				continue
			}
			if chosen != nil {
				_ = chosen.Close()
			}
			best, chosen, chosenInfo, chosenEncoding = quality, f, info, sidecar.encoding
		}
		if chosen != nil {
			defer chosen.Close()
			w.Header().Set("Content-Type", contentType)
			w.Header().Set("Content-Encoding", chosenEncoding)
			serveContent(w, r, name, chosen, chosenInfo)
			return true
		}
	}
	f, info, ok := openAsset(assets, name)
	if !ok {
		return false
	}
	defer f.Close()
	serveContent(w, r, name, f, info)
	return true
}

// serveContent writes f with the standard-library file semantics: ranges,
// If-Modified-Since and HEAD. The embedded FS is seekable, so the buffering
// fallback only covers a generic fs.FS (such as a test double) that is not.
func serveContent(w http.ResponseWriter, r *http.Request, name string, f fs.File, info fs.FileInfo) {
	base := path.Base(name)
	if seeker, ok := f.(io.ReadSeeker); ok {
		http.ServeContent(w, r, base, info.ModTime(), seeker)
		return
	}
	content, err := io.ReadAll(f)
	if err != nil {
		http.Error(w, "read embedded asset", http.StatusInternalServerError)
		return
	}
	http.ServeContent(w, r, base, info.ModTime(), bytes.NewReader(content))
}

// openAsset opens one embedded file, rejecting directories and a missing entry.
func openAsset(assets fs.FS, name string) (fs.File, fs.FileInfo, bool) {
	f, err := assets.Open(name)
	if err != nil {
		return nil, nil, false
	}
	info, err := f.Stat()
	if err != nil || info.IsDir() {
		_ = f.Close()
		return nil, nil, false
	}
	return f, info, true
}

// hasIndex reports whether the SPA shell is present. Without it the fallback
// must 404 rather than serve an unrelated asset.
func hasIndex(assets fs.FS) bool {
	_, err := fs.Stat(assets, indexFile)
	return err == nil
}

// isAPIPath reports whether path belongs to the reserved API namespace. An
// empty prefix reserves nothing, so a caller can disable the reservation.
func isAPIPath(path, reservedPrefix string) bool {
	reservedPrefix = strings.TrimSuffix(reservedPrefix, "/")
	if reservedPrefix == "" {
		return false
	}
	return path == reservedPrefix || strings.HasPrefix(path, reservedPrefix+"/")
}

// isBrowserNavigation reports whether r is a top-level browser request that
// should receive the SPA shell for an unknown path.
func isBrowserNavigation(r *http.Request) bool {
	if r.Method != http.MethodGet && r.Method != http.MethodHead {
		return false
	}
	return strings.Contains(r.Header.Get("Accept"), "text/html")
}

// hasSidecarSuffix reports whether name is a precompressed sidecar rather than
// an asset the SPA build is meant to reference.
func hasSidecarSuffix(name string) bool {
	for _, sidecar := range sidecars {
		if strings.HasSuffix(name, sidecar.ext) {
			return true
		}
	}
	return false
}

// acceptedEncodings parses the request's Accept-Encoding header into the
// explicit quality of each named coding plus the wildcard quality. A coding that
// is neither named nor covered by the wildcard is not acceptable.
func acceptedEncodings(r *http.Request) (map[string]float64, *float64) {
	explicit := make(map[string]float64)
	var wildcard *float64
	for _, value := range r.Header.Values("Accept-Encoding") {
		for _, item := range strings.Split(value, ",") {
			parts := strings.Split(item, ";")
			name := strings.TrimSpace(parts[0])
			if name == "" {
				continue
			}

			quality := 1.0
			for _, parameter := range parts[1:] {
				key, parameterValue, ok := strings.Cut(strings.TrimSpace(parameter), "=")
				if !ok || !strings.EqualFold(strings.TrimSpace(key), "q") {
					continue
				}
				parsed, err := strconv.ParseFloat(strings.TrimSpace(parameterValue), 64)
				if err != nil || parsed < 0 || parsed > 1 {
					quality = 0
					break
				}
				quality = parsed
			}

			if name == "*" {
				wildcard = &quality
				continue
			}
			explicit[strings.ToLower(name)] = quality
		}
	}
	return explicit, wildcard
}

// encodingQuality reports how much the request wants one coding: its explicit
// quality, else the wildcard's, else zero. "gzip;q=0" and "*;q=0" must not
// receive compressed content, which a plain substring check would get wrong.
func encodingQuality(explicit map[string]float64, wildcard *float64, encoding string) float64 {
	if quality, ok := explicit[encoding]; ok {
		return quality
	}
	if wildcard != nil {
		return *wildcard
	}
	return 0
}
