// fakeLoader builds a loader over in-memory files and environment, so every
// test exercises the real loader without touching the filesystem or the process
// environment.
func fakeLoader(files, env map[string]string) *Loader {
	readFile := func(name string) ([]byte, error) {
		content, ok := files[name]
		if !ok {
			return nil, fs.ErrNotExist
		}
		return []byte(content), nil
	}
	lookupEnv := func(key string) (string, bool) {
		value, ok := env[key]
		return value, ok
	}
	return NewLoader(readFile, lookupEnv)
}

func TestLoadAppliesDefaultsWhenFileOmitsValues(t *testing.T) {
	cfg, err := fakeLoader(map[string]string{DefaultPath: ""}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.HTTP.Addr != DefaultHTTPAddr {
		t.Fatalf("HTTP.Addr = %q, want %q", cfg.HTTP.Addr, DefaultHTTPAddr)
	}
}

// TestLoadMissingFileIsAnError proves an absent config.yml is not silently
// replaced with defaults, whether the path is the default or explicit.
func TestLoadMissingFileIsAnError(t *testing.T) {
	if _, err := fakeLoader(nil, nil).Load(""); err == nil {
		t.Fatal("expected an error for a missing default config.yml")
	}
	if _, err := fakeLoader(nil, nil).Load("explicit.yml"); err == nil {
		t.Fatal("expected an error for a missing explicit config file")
	}
}

// TestLoadInvalidYAMLIsAnErrorWithoutEchoingContent proves an invalid file is an
// error distinct from an absent one, and that the error never quotes the file
// content (which may hold a password).
func TestLoadInvalidYAMLIsAnErrorWithoutEchoingContent(t *testing.T) {
	const sentinel = "sentinel-do-not-log"
	loader := fakeLoader(map[string]string{
		DefaultPath: "database:\n  password: [unterminated\n  note: " + sentinel + "\n",
	}, nil)
	_, err := loader.Load("")
	if err == nil {
		t.Fatal("expected an error for invalid YAML")
	}
	if strings.Contains(err.Error(), sentinel) {
		t.Fatalf("error echoed file content: %v", err)
	}
	if !strings.Contains(err.Error(), "invalid YAML") {
		t.Fatalf("error = %v, want it to name invalid YAML", err)
	}
}

// TestBlankHTTPAddrEnvIsAnError proves an explicitly set but blank HTTP_ADDR is
// an error rather than a silent fallback to the default address.
func TestBlankHTTPAddrEnvIsAnError(t *testing.T) {
	loader := fakeLoader(map[string]string{DefaultPath: ""}, map[string]string{EnvHTTPAddr: ""})
	if _, err := loader.Load(""); err == nil {
		t.Fatal("expected an error for an explicit blank HTTP_ADDR")
	}
}

// TestEnvironmentOverridesFile pins the file < environment precedence.
func TestEnvironmentOverridesFile(t *testing.T) {
	loader := fakeLoader(
		map[string]string{DefaultPath: "http:\n  addr: \":1111\"\n"},
		map[string]string{EnvHTTPAddr: ":2222"},
	)
	cfg, err := loader.Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.HTTP.Addr != ":2222" {
		t.Fatalf("HTTP.Addr = %q, want the environment value", cfg.HTTP.Addr)
	}
}

// TestEnvironmentDefaultsToProductionAndGatesDevelopment proves the environment
// is production unless the file or APP_ENV says otherwise, and that only local
// and development enable the development conveniences.
func TestEnvironmentDefaultsToProductionAndGatesDevelopment(t *testing.T) {
	cfg, err := fakeLoader(map[string]string{DefaultPath: ""}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Environment != EnvironmentProduction || cfg.Environment.IsDevelopment() {
		t.Fatalf("default environment = %q, want production and not development", cfg.Environment)
	}

	cfg, err = fakeLoader(map[string]string{DefaultPath: "environment: Local\n"}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Environment != EnvironmentLocal || !cfg.Environment.IsDevelopment() {
		t.Fatalf("environment = %q, want the normalized local and development", cfg.Environment)
	}

	loader := fakeLoader(map[string]string{DefaultPath: "environment: \"production\"\n"}, map[string]string{EnvEnvironment: "development"})
	cfg, err = loader.Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Environment != EnvironmentDevelopment || !cfg.Environment.IsDevelopment() {
		t.Fatalf("environment = %q, want the APP_ENV value development", cfg.Environment)
	}
}

// TestUnknownEnvironmentIsNotDevelopment proves an unrecognized value never
// enables the development conveniences.
func TestUnknownEnvironmentIsNotDevelopment(t *testing.T) {
	for _, value := range []Environment{"", "staging", "prod", EnvironmentTest} {
		if value.IsDevelopment() {
			t.Fatalf("environment %q enabled development", value)
		}
	}
}

func TestLoadReadsDatabaseFromFile(t *testing.T) {
	loader := fakeLoader(map[string]string{
		DefaultPath: "database:\n  host: db.example\n  port: 6543\n  user: app\n  password: file-secret\n  name: appdb\n",
	}, nil)
	cfg, err := loader.Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Database.Host != "db.example" || cfg.Database.Port != 6543 || cfg.Database.User != "app" || cfg.Database.Name != "appdb" {
		t.Fatalf("database = %+v", cfg.Database)
	}
	if cfg.Database.Password.Value() != "file-secret" {
		t.Fatal("the password was not loaded")
	}
	if err := cfg.ValidateDatabase(); err != nil {
		t.Fatalf("ValidateDatabase: %v", err)
	}
}

// TestAutoMigrateLoadsFromFileAndEnvironment proves the startup migration toggle
// is typed and that DB_AUTO_MIGRATE outranks the file, so a deployment can turn
// it on without rebuilding the config file. A malformed value is an error rather
// than a silent false.
func TestAutoMigrateLoadsFromFileAndEnvironment(t *testing.T) {
	cfg, err := fakeLoader(map[string]string{
		DefaultPath: "database:\n  auto_migrate: true\n",
	}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if !cfg.Database.AutoMigrate {
		t.Fatal("database.auto_migrate was not loaded from the file")
	}

	cfg, err = fakeLoader(
		map[string]string{DefaultPath: "database:\n  auto_migrate: true\n"},
		map[string]string{EnvDBAutoMigrate: "false"},
	).Load("")
	if err != nil {
		t.Fatalf("Load with environment override: %v", err)
	}
	if cfg.Database.AutoMigrate {
		t.Fatal("DB_AUTO_MIGRATE=false did not override the file")
	}

	if _, err := fakeLoader(
		map[string]string{DefaultPath: ""},
		map[string]string{EnvDBAutoMigrate: "maybe"},
	).Load(""); err == nil {
		t.Fatal("expected an error for a malformed DB_AUTO_MIGRATE")
	}
}

// TestValidateDatabaseRequiresCredentials proves the loader never invents a
// credential: an empty database section is invalid only when the database is
// used.
func TestValidateDatabaseRequiresCredentials(t *testing.T) {
	cfg, err := fakeLoader(map[string]string{DefaultPath: ""}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if err := cfg.ValidateDatabase(); err == nil {
		t.Fatal("expected an error when the database has no credentials")
	}
}

func TestDSNUsesFieldsOrExplicitValue(t *testing.T) {
	cfg := &Config{Database: Database{Host: "db", Port: 5432, User: "app", Password: "pw", Name: "appdb"}}
	dsn := cfg.DSN()
	if !strings.HasPrefix(dsn, "postgres://app:") || !strings.Contains(dsn, "@db:5432/appdb") {
		t.Fatalf("DSN = %q", dsn)
	}
	cfg.Database.DSN = "postgres://explicit"
	if dsn := cfg.DSN(); dsn != "postgres://explicit" {
		t.Fatalf("DSN = %q, want the explicit value", dsn)
	}
}

// TestSecretRedactsEverywhere is the credential-safety sentinel: the secret must
// not survive fmt, logging, JSON or YAML.
func TestSecretRedactsEverywhere(t *testing.T) {
	const sentinel = "sentinel-do-not-log"
	secret := Secret(sentinel)

	for _, got := range []string{
		fmt.Sprintf("%v", secret),
		fmt.Sprintf("%s", secret),
		fmt.Sprintf("%#v", secret),
		secret.String(),
	} {
		if strings.Contains(got, sentinel) {
			t.Fatalf("fmt leaked the secret: %q", got)
		}
	}

	var buf bytes.Buffer
	logging.New(&buf, logging.TextFormat, &logging.Options{NoColor: true}).Info("config", "secret", secret)
	if strings.Contains(buf.String(), sentinel) {
		t.Fatalf("logging leaked the secret:\n%s", buf.String())
	}

	encoded, err := json.Marshal(secret)
	if err != nil {
		t.Fatalf("json.Marshal: %v", err)
	}
	if strings.Contains(string(encoded), sentinel) {
		t.Fatalf("JSON leaked the secret: %s", encoded)
	}

	yamlEncoded, err := yaml.Marshal(secret)
	if err != nil {
		t.Fatalf("yaml.Marshal: %v", err)
	}
	if strings.Contains(string(yamlEncoded), sentinel) {
		t.Fatalf("YAML leaked the secret: %s", yamlEncoded)
	}
}

// TestConfigFormattingRedactsSecret proves dumping the whole config does not
// leak the password either.
func TestConfigFormattingRedactsSecret(t *testing.T) {
	const sentinel = "sentinel-do-not-log"
	cfg := &Config{Database: Database{User: "app", Password: Secret(sentinel)}}
	if got := fmt.Sprintf("%+v", cfg); strings.Contains(got, sentinel) {
		t.Fatalf("formatting the config leaked the secret: %s", got)
	}
	encoded, err := json.Marshal(cfg)
	if err != nil {
		t.Fatalf("json.Marshal: %v", err)
	}
	if strings.Contains(string(encoded), sentinel) {
		t.Fatalf("marshalling the config leaked the secret: %s", encoded)
	}
}

// TestCORSOmitsSectionSafely proves an omitted cors section is off, still carries
// the defaults the middleware needs, and validates: a project that never
// configures CORS is unaffected.
func TestCORSOmitsSectionSafely(t *testing.T) {
	cfg, err := fakeLoader(map[string]string{DefaultPath: ""}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.CORS.Enabled {
		t.Fatal("an omitted cors section enabled CORS")
	}
	if len(cfg.CORS.AllowedMethods) == 0 || len(cfg.CORS.AllowedHeaders) == 0 {
		t.Fatalf("cors defaults were not applied: %+v", cfg.CORS)
	}
	if cfg.CORS.MaxAgeSeconds != DefaultCORSMaxAgeSeconds {
		t.Fatalf("cors.max_age_seconds = %d, want %d", cfg.CORS.MaxAgeSeconds, DefaultCORSMaxAgeSeconds)
	}
	if err := cfg.Validate(); err != nil {
		t.Fatalf("Validate: %v", err)
	}
}

// TestCORSLoadsFromFileAndEnvironment proves the cors section is typed and that
// the environment overrides the file, which is how a deployment sets its origin
// list without rebuilding the image.
func TestCORSLoadsFromFileAndEnvironment(t *testing.T) {
	file := "cors:\n" +
		"  enabled: true\n" +
		"  allowed_origins: [\"https://from-file.example.com\"]\n" +
		"  allowed_headers: [X-Custom]\n" +
		"  allow_credentials: true\n" +
		"  max_age_seconds: 120\n"
	cfg, err := fakeLoader(map[string]string{DefaultPath: file}, nil).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if !cfg.CORS.Enabled || !cfg.CORS.AllowCredentials || cfg.CORS.MaxAgeSeconds != 120 {
		t.Fatalf("cors section was not loaded: %+v", cfg.CORS)
	}
	if len(cfg.CORS.AllowedOrigins) != 1 || cfg.CORS.AllowedOrigins[0] != "https://from-file.example.com" {
		t.Fatalf("cors.allowed_origins = %v", cfg.CORS.AllowedOrigins)
	}

	env := map[string]string{
		EnvCORSAllowedOrigins: "https://one.example.com, https://two.example.com",
		EnvCORSExposedHeaders: "X-Request-Id",
		EnvCORSCredentials:    "false",
	}
	cfg, err = fakeLoader(map[string]string{DefaultPath: file}, env).Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if len(cfg.CORS.AllowedOrigins) != 2 || cfg.CORS.AllowedOrigins[1] != "https://two.example.com" {
		t.Fatalf("CORS_ALLOWED_ORIGINS was not parsed as a trimmed list: %v", cfg.CORS.AllowedOrigins)
	}
	if len(cfg.CORS.ExposedHeaders) != 1 || cfg.CORS.ExposedHeaders[0] != "X-Request-Id" {
		t.Fatalf("cors.exposed_headers = %v", cfg.CORS.ExposedHeaders)
	}
	if cfg.CORS.AllowCredentials {
		t.Fatal("CORS_ALLOW_CREDENTIALS=false did not override the file")
	}
}

// TestCORSInvalidEnvironmentIsAnError proves a malformed override is an error
// rather than a silent fallback, matching every other setting.
func TestCORSInvalidEnvironmentIsAnError(t *testing.T) {
	for name, env := range map[string]map[string]string{
		"boolean": {EnvCORSEnabled: "maybe"},
		"number":  {EnvCORSMaxAgeSeconds: "soon"},
	} {
		if _, err := fakeLoader(map[string]string{DefaultPath: ""}, env).Load(""); err == nil {
			t.Errorf("%s: expected an error", name)
		}
	}
}

// TestValidateCORSRejectsAnUnsafePolicy proves the fail-closed validation: an
// enabled policy with no origin, an entry that is not an origin, the invalid
// wildcard-with-credentials pair and a negative max age all fail, while a
// disabled section ignores its contents and a valid policy passes.
func TestValidateCORSRejectsAnUnsafePolicy(t *testing.T) {
	cases := []struct {
		name    string
		cors    CORS
		wantErr bool
	}{
		{"disabled ignores contents", CORS{AllowedOrigins: []string{"not an origin"}}, false},
		{"enabled without origins", CORS{Enabled: true}, true},
		{"trailing slash", CORS{Enabled: true, AllowedOrigins: []string{"https://app.example.com/"}}, true},
		{"missing scheme", CORS{Enabled: true, AllowedOrigins: []string{"app.example.com"}}, true},
		{"with a path", CORS{Enabled: true, AllowedOrigins: []string{"https://app.example.com/api"}}, true},
		{"wildcard with credentials", CORS{Enabled: true, AllowedOrigins: []string{"*"}, AllowCredentials: true}, true},
		{"negative max age", CORS{Enabled: true, AllowedOrigins: []string{"https://app.example.com"}, MaxAgeSeconds: -1}, true},
		{"exact origin", CORS{Enabled: true, AllowedOrigins: []string{"https://app.example.com"}}, false},
		{"wildcard", CORS{Enabled: true, AllowedOrigins: []string{"*"}}, false},
		{"local development origin", CORS{Enabled: true, AllowedOrigins: []string{"http://localhost:5173"}}, false},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			cfg := &Config{HTTP: HTTP{Addr: DefaultHTTPAddr}, CORS: tc.cors}
			err := cfg.Validate()
			if tc.wantErr && err == nil {
				t.Fatal("expected an error")
			}
			if !tc.wantErr && err != nil {
				t.Fatalf("unexpected error: %v", err)
			}
		})
	}
}
