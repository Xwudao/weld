// Package config loads the __name__ configuration.
//
// Configuration is a typed Go struct read from a YAML file (config.yml in the
// working directory by default) and overridden by the environment. Precedence,
// highest first, is: command-line flag, environment variable, YAML file, then
// the built-in defaults. The loader takes its file reader and environment
// lookup as dependencies, so a test exercises every branch without touching the
// filesystem or the process environment; every Loom graph shares this one
// loader.
//
// The database section is optional and is validated only when the database is
// actually used, so an http-only project never needs a database setting. A
// database password may live in the local, git-ignored config.yml for
// development; the Secret type keeps it out of logs and formatted output, and a
// production environment overrides it through DB_PASSWORD or DATABASE_URL.
//
// The environment setting gates development conveniences only — for example,
// logging the composed route table at startup — and carries no security weight,
// so an unrecognized value simply is not development. See
// Environment.IsDevelopment.
//
// The cors section is off by default and is validated at load time only when it
// is enabled, so a same-origin SPA needs no configuration and a mistake — an
// empty origin list, a URL with a trailing slash, a wildcard with credentials —
// fails startup with a readable error instead of serving a policy no browser
// honors. See CORS and ValidateCORS.
//
// The typed sections are closed but extensible: three marker regions
// (weld:configfields, weld:configenv, weld:configdefaults) let a later
// capability add its own field, environment overrides and defaults through a
// marker patch without weld rewriting anything outside the region. A capability
// that needs a new section adds the field, the redacting type and the accessor
// in the same package (for example internal/config/redis.go).
package config

import (
	"errors"
	"fmt"
	"io/fs"
	"log/slog"
	"net"
	"net/url"
	"os"
	"strconv"
	"strings"

	"gopkg.in/yaml.v3"
)

// DefaultPath is the configuration file the loader reads when no explicit path
// is given. It is resolved relative to the working directory.
const DefaultPath = "config.yml"

// DefaultHTTPAddr is the listen address used when neither the file, the
// environment nor a flag sets one.
const DefaultHTTPAddr = ":8080"

// DefaultDBHost and DefaultDBPort are the connection defaults for an omitted
// host or port. They are not credentials: the user, password and name have no
// default, so a database-backed app can never silently reach a local database.
const (
	DefaultDBHost = "localhost"
	DefaultDBPort = 5432
)

// Environment variable names. A production environment overrides the YAML file
// through these; none is required when the corresponding setting is in the file.
const (
	EnvEnvironment = "APP_ENV"
	EnvHTTPAddr    = "HTTP_ADDR"
	EnvDBHost      = "DB_HOST"
	EnvDBPort      = "DB_PORT"
	EnvDBUser      = "DB_USER"
	EnvDBPassword  = "DB_PASSWORD"
	EnvDBName      = "DB_NAME"
	EnvDatabaseURL = "DATABASE_URL"

	// CORS environment names. They exist so a deployed origin list is not baked
	// into the image: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
	// overrides the file, and CORS_ENABLED=false turns the policy off entirely.
	EnvCORSEnabled        = "CORS_ENABLED"
	EnvCORSAllowedOrigins = "CORS_ALLOWED_ORIGINS"
	EnvCORSAllowedMethods = "CORS_ALLOWED_METHODS"
	EnvCORSAllowedHeaders = "CORS_ALLOWED_HEADERS"
	EnvCORSExposedHeaders = "CORS_EXPOSED_HEADERS"
	EnvCORSCredentials    = "CORS_ALLOW_CREDENTIALS"
	EnvCORSMaxAgeSeconds  = "CORS_MAX_AGE_SECONDS"
)

// DefaultCORSMaxAgeSeconds is how long a browser may cache a preflight result
// when the cors section omits max_age_seconds. Ten minutes matches the shortest
// browser cap, so a policy change takes effect promptly.
const DefaultCORSMaxAgeSeconds = 600

// defaultCORSMethods and defaultCORSHeaders are the lists an omitted (or empty)
// cors section uses. The headers are the ones the generated JSON API actually
// needs: a JSON body, a bearer token and the request id the middleware echoes.
// They are copied into the configuration rather than assigned, so a caller
// editing the configuration cannot mutate the package default.
var (
	defaultCORSMethods = []string{"GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"}
	defaultCORSHeaders = []string{"Content-Type", "Authorization", "X-Request-Id"}
)

// Secret is a string that must never be printed.
//
// It redacts itself in fmt, log/slog, JSON and YAML output, so a configuration
// value can be logged or marshalled without leaking a credential. Value is the
// one accessor that reveals the underlying string.
type Secret string

// Value returns the underlying secret. It is the only accessor that reveals it.
func (s Secret) Value() string { return string(s) }

// String redacts the secret for fmt.
func (Secret) String() string { return "[REDACTED]" }

// GoString redacts the secret for the %#v verb.
func (Secret) GoString() string { return "[REDACTED]" }

// LogValue redacts the secret for log/slog.
func (Secret) LogValue() slog.Value { return slog.StringValue("[REDACTED]") }

// MarshalJSON redacts the secret in JSON output.
func (Secret) MarshalJSON() ([]byte, error) { return []byte(`"[REDACTED]"`), nil }

// MarshalYAML redacts the secret in YAML output.
func (Secret) MarshalYAML() (interface{}, error) { return "[REDACTED]", nil }

// UnmarshalYAML reads the secret from a YAML scalar. Loading is the one place
// the plaintext is accepted.
func (s *Secret) UnmarshalYAML(value *yaml.Node) error {
	var raw string
	if err := value.Decode(&raw); err != nil {
		return err
	}
	*s = Secret(raw)
	return nil
}

// Environment names the deployment environment.
//
// It gates development conveniences only — currently, logging the composed
// route table at startup — and carries no security weight: authorization is
// enforced by named policies, never by the environment name. An empty or
// unknown value is production, so a development surface is never enabled by
// accident. Set APP_ENV to override the file.
type Environment string

const (
	// EnvironmentLocal and EnvironmentDevelopment both enable the development
	// conveniences; they differ only in the operator's intent.
	EnvironmentLocal       Environment = "local"
	EnvironmentDevelopment Environment = "development"
	// EnvironmentTest is the test environment. It does not enable the
	// development conveniences, so a test asserts the production code path
	// unless it opts in explicitly.
	EnvironmentTest Environment = "test"
	// EnvironmentProduction is the default, used when the setting is empty or
	// unrecognized.
	EnvironmentProduction Environment = "production"
)

// UnmarshalYAML reads the environment from a YAML scalar, normalizing case and
// surrounding space so "Local" and "production " still compare.
func (e *Environment) UnmarshalYAML(value *yaml.Node) error {
	var raw string
	if err := value.Decode(&raw); err != nil {
		return err
	}
	*e = Environment(strings.ToLower(strings.TrimSpace(raw)))
	return nil
}

// IsDevelopment reports whether the development conveniences are enabled: the
// environment is local or development. Every other value, including empty and
// unknown, is not development.
func (e Environment) IsDevelopment() bool {
	switch e {
	case EnvironmentLocal, EnvironmentDevelopment:
		return true
	default:
		return false
	}
}

// Config is the typed application configuration.
type Config struct {
	// Environment gates development conveniences only; it carries no security
	// weight. See Environment.IsDevelopment.
	Environment Environment `yaml:"environment"`
	HTTP        HTTP        `yaml:"http"`
	CORS        CORS        `yaml:"cors"`
	Database    Database    `yaml:"database"`
	// weld:configfields:begin
	// A capability that extends the typed configuration appends its field here
	// through a marker patch; weld never rewrites the region's owner. The base
	// scaffold keeps it empty.
	// weld:configfields:end
}

// HTTP holds the HTTP server settings.
type HTTP struct {
	Addr string `yaml:"addr"`
}

// CORS holds the cross-origin resource sharing policy.
//
// It is off by default: a browser frontend served from the same origin — which
// the generated project is, because the SPA is embedded and the Vite dev server
// proxies the API — needs no CORS header at all. Enable it only when a browser
// page is served from a different origin than this server, and list the exact
// origins you trust.
//
// It is a browser policy, not an authorization mechanism: it decides which
// origins may *read* a response. Who may perform the request is decided by the
// named route policies, which CORS never bypasses.
type CORS struct {
	// Enabled turns the policy on. While it is false the middleware is not
	// installed and the server sends no CORS header, whatever the lists below
	// say.
	Enabled bool `yaml:"enabled"`
	// AllowedOrigins lists the origins a browser may call from, each as
	// scheme://host[:port] with no path and no trailing slash, or the single
	// literal "*". It must not be empty while Enabled is true, and "*" is
	// rejected together with AllowCredentials, because a browser refuses that
	// pair.
	AllowedOrigins []string `yaml:"allowed_origins"`
	// AllowedMethods lists the methods a preflight may ask for. An empty list
	// selects the standard set.
	AllowedMethods []string `yaml:"allowed_methods"`
	// AllowedHeaders lists the request headers a preflight may ask for,
	// case-insensitively; the CORS-safelisted headers are always allowed. An
	// empty list selects Content-Type, Authorization and X-Request-Id. The single
	// literal "*" allows any requested header.
	AllowedHeaders []string `yaml:"allowed_headers"`
	// ExposedHeaders lists the response headers a browser script may read. An
	// empty list exposes none beyond the CORS-safelisted response headers.
	ExposedHeaders []string `yaml:"exposed_headers"`
	// AllowCredentials permits cookies and other credentials on a cross-origin
	// request. With it an allowed origin is echoed rather than answered with "*".
	AllowCredentials bool `yaml:"allow_credentials"`
	// MaxAgeSeconds is how long a browser may cache a preflight result. Zero
	// leaves the browser default in place; the middleware clamps it to 24h.
	MaxAgeSeconds int `yaml:"max_age_seconds"`
}

// Database holds the PostgreSQL connection settings.
//
// It is validated only when the database is actually used, so an http-only
// project may leave the section empty. DSN, when set, is used verbatim instead
// of the individual fields.
type Database struct {
	Host     string `yaml:"host"`
	Port     int    `yaml:"port"`
	User     string `yaml:"user"`
	Password Secret `yaml:"password"`
	Name     string `yaml:"name"`
	DSN      Secret `yaml:"dsn"`
}

// ReadFileFunc reads a file. It is a dependency so a test can supply content
// without touching the filesystem.
type ReadFileFunc func(name string) ([]byte, error)

// LookupEnvFunc reads an environment variable. It is a dependency so a test can
// supply values without touching the process environment.
type LookupEnvFunc func(key string) (value string, ok bool)

// Loader loads configuration from a YAML file and the environment.
type Loader struct {
	readFile  ReadFileFunc
	lookupEnv LookupEnvFunc
}

// NewLoader builds a loader with explicit dependencies.
func NewLoader(readFile ReadFileFunc, lookupEnv LookupEnvFunc) *Loader {
	return &Loader{readFile: readFile, lookupEnv: lookupEnv}
}

// NewOsLoader builds the loader ordinary endpoints use: the filesystem and the
// process environment. Every Loom graph uses it, so there is one
// configuration path.
func NewOsLoader() *Loader {
	return NewLoader(os.ReadFile, os.LookupEnv)
}

// Load reads configuration. path is the explicit --config value; an empty path
// means DefaultPath in the working directory.
//
// A missing or unreadable file and an invalid file are both errors: an absent
// config.yml is never silently replaced with defaults, and a malformed file is
// never partially applied. The error never quotes the file content, so a
// malformed secret cannot reach a log record. Environment variables then
// override the file, and the caller applies command-line flags last.
func (l *Loader) Load(path string) (*Config, error) {
	if l == nil || l.readFile == nil || l.lookupEnv == nil {
		return nil, errors.New("config: loader needs a file reader and an environment lookup")
	}
	if strings.TrimSpace(path) == "" {
		path = DefaultPath
	}
	raw, err := l.readFile(path)
	switch {
	case err == nil:
	case errors.Is(err, fs.ErrNotExist):
		return nil, fmt.Errorf("config: %s: file not found", path)
	default:
		return nil, fmt.Errorf("config: read %s: %w", path, err)
	}
	cfg := &Config{}
	if err := yaml.Unmarshal(raw, cfg); err != nil {
		// The parser error can quote the offending line, so it is not included.
		return nil, fmt.Errorf("config: %s: invalid YAML", path)
	}
	if err := l.applyEnv(cfg); err != nil {
		return nil, err
	}
	l.applyDefaults(cfg)
	return cfg, nil
}

// applyEnv overrides the file with environment variables. A variable that
// cannot be parsed is an error rather than a silent fallback.
func (l *Loader) applyEnv(cfg *Config) error {
	if value, ok := l.lookupEnv(EnvEnvironment); ok {
		// A blank or unknown value is not an error: it simply is not a
		// development environment, so no development convenience turns on.
		cfg.Environment = Environment(strings.ToLower(strings.TrimSpace(value)))
	}
	if value, ok := l.lookupEnv(EnvHTTPAddr); ok {
		addr := strings.TrimSpace(value)
		if addr == "" {
			// An explicitly set but blank variable must not silently fall back to
			// the default: the operator set it and the value is invalid.
			return fmt.Errorf("config: %s is set but blank", EnvHTTPAddr)
		}
		cfg.HTTP.Addr = addr
	}
	if value, ok := l.lookupEnv(EnvDBHost); ok {
		cfg.Database.Host = strings.TrimSpace(value)
	}
	if value, ok := l.lookupEnv(EnvDBPort); ok {
		port, err := strconv.Atoi(strings.TrimSpace(value))
		if err != nil {
			return fmt.Errorf("config: %s is not a number", EnvDBPort)
		}
		cfg.Database.Port = port
	}
	if value, ok := l.lookupEnv(EnvDBUser); ok {
		cfg.Database.User = strings.TrimSpace(value)
	}
	if value, ok := l.lookupEnv(EnvDBPassword); ok {
		cfg.Database.Password = Secret(value)
	}
	if value, ok := l.lookupEnv(EnvDBName); ok {
		cfg.Database.Name = strings.TrimSpace(value)
	}
	if value, ok := l.lookupEnv(EnvDatabaseURL); ok {
		cfg.Database.DSN = Secret(strings.TrimSpace(value))
	}
	if value, ok := l.lookupEnv(EnvCORSEnabled); ok {
		enabled, err := strconv.ParseBool(strings.TrimSpace(value))
		if err != nil {
			return fmt.Errorf("config: %s is not a boolean", EnvCORSEnabled)
		}
		cfg.CORS.Enabled = enabled
	}
	if value, ok := l.lookupEnv(EnvCORSAllowedOrigins); ok {
		cfg.CORS.AllowedOrigins = splitEnvList(value)
	}
	if value, ok := l.lookupEnv(EnvCORSAllowedMethods); ok {
		cfg.CORS.AllowedMethods = splitEnvList(value)
	}
	if value, ok := l.lookupEnv(EnvCORSAllowedHeaders); ok {
		cfg.CORS.AllowedHeaders = splitEnvList(value)
	}
	if value, ok := l.lookupEnv(EnvCORSExposedHeaders); ok {
		cfg.CORS.ExposedHeaders = splitEnvList(value)
	}
	if value, ok := l.lookupEnv(EnvCORSCredentials); ok {
		credentials, err := strconv.ParseBool(strings.TrimSpace(value))
		if err != nil {
			return fmt.Errorf("config: %s is not a boolean", EnvCORSCredentials)
		}
		cfg.CORS.AllowCredentials = credentials
	}
	if value, ok := l.lookupEnv(EnvCORSMaxAgeSeconds); ok {
		seconds, err := strconv.Atoi(strings.TrimSpace(value))
		if err != nil {
			return fmt.Errorf("config: %s is not a number", EnvCORSMaxAgeSeconds)
		}
		cfg.CORS.MaxAgeSeconds = seconds
	}
	// weld:configenv:begin
	// A capability that extends the typed configuration applies its environment
	// overrides here through a marker patch.
	// weld:configenv:end
	return nil
}

// applyDefaults fills the explicit code defaults, after the file and the
// environment. It never invents a database credential.
func (l *Loader) applyDefaults(cfg *Config) {
	if cfg.Environment == "" {
		cfg.Environment = EnvironmentProduction
	}
	if strings.TrimSpace(cfg.HTTP.Addr) == "" {
		cfg.HTTP.Addr = DefaultHTTPAddr
	}
	if strings.TrimSpace(cfg.Database.Host) == "" {
		cfg.Database.Host = DefaultDBHost
	}
	if cfg.Database.Port == 0 {
		cfg.Database.Port = DefaultDBPort
	}
	if len(cfg.CORS.AllowedMethods) == 0 {
		cfg.CORS.AllowedMethods = append([]string(nil), defaultCORSMethods...)
	}
	if len(cfg.CORS.AllowedHeaders) == 0 {
		cfg.CORS.AllowedHeaders = append([]string(nil), defaultCORSHeaders...)
	}
	if cfg.CORS.MaxAgeSeconds == 0 {
		cfg.CORS.MaxAgeSeconds = DefaultCORSMaxAgeSeconds
	}
	// weld:configdefaults:begin
	// A capability that extends the typed configuration applies its defaults
	// here through a marker patch.
	// weld:configdefaults:end
}

// Validate reports whether the always-loaded settings are usable: the HTTP
// listen address and, when it is enabled, the cross-origin policy. The database
// section is validated separately, by ValidateDatabase, because it is only
// needed where the database is actually used.
func (c *Config) Validate() error {
	if strings.TrimSpace(c.HTTP.Addr) == "" {
		return errors.New("config: http.addr must not be blank")
	}
	return c.ValidateCORS()
}

// ValidateCORS reports whether the cross-origin policy is usable.
//
// It is strict on purpose: an enabled policy must name at least one origin, every
// entry must be a real origin rather than a URL with a path, and the wildcard is
// refused together with credentials because a browser rejects that pair. A
// project that gets this wrong fails at startup with a readable message instead
// of serving a policy no browser will honor.
func (c *Config) ValidateCORS() error {
	if !c.CORS.Enabled {
		return nil
	}
	if len(c.CORS.AllowedOrigins) == 0 {
		return errors.New("config: cors.allowed_origins must list at least one origin when cors.enabled is true (set it in config.yml or " + EnvCORSAllowedOrigins + ")")
	}
	wildcard := false
	for _, origin := range c.CORS.AllowedOrigins {
		origin = strings.TrimSpace(origin)
		if !validCORSOrigin(origin) {
			return fmt.Errorf("config: cors.allowed_origins entry %q is not an origin; use scheme://host[:port] with no path and no trailing slash, or \"*\"", origin)
		}
		if origin == "*" {
			wildcard = true
		}
	}
	if wildcard && c.CORS.AllowCredentials {
		return errors.New("config: cors.allow_credentials cannot be true while cors.allowed_origins contains \"*\"; list the origins explicitly")
	}
	if c.CORS.MaxAgeSeconds < 0 {
		return errors.New("config: cors.max_age_seconds must not be negative")
	}
	return nil
}

// validCORSOrigin reports whether origin is a usable allowed origin: the literal
// wildcard, or an absolute origin with a scheme and a host and no path, query,
// fragment or user info. The strictness catches the common mistakes — a trailing
// slash, a missing scheme, a pasted URL with a path — that a browser would
// silently refuse to match.
func validCORSOrigin(origin string) bool {
	if origin == "*" {
		return true
	}
	parsed, err := url.Parse(origin)
	if err != nil {
		return false
	}
	return parsed.Scheme != "" && parsed.Host != "" &&
		parsed.Path == "" && parsed.RawQuery == "" && parsed.Fragment == "" && parsed.User == nil
}

// splitEnvList parses a comma-separated environment value into a list, trimming
// each entry and dropping the empty ones so a trailing comma is harmless. An
// explicitly empty variable clears the list rather than leaving the file's value
// in place.
func splitEnvList(raw string) []string {
	parts := strings.Split(raw, ",")
	list := make([]string, 0, len(parts))
	for _, part := range parts {
		if part = strings.TrimSpace(part); part != "" {
			list = append(list, part)
		}
	}
	return list
}

// ValidateDatabase reports whether the database settings are usable.
//
// It is called only where the database is actually used, so a project that
// installs the db capability but never opens a pool does not need a database
// setting. It never invents a credential.
func (c *Config) ValidateDatabase() error {
	if strings.TrimSpace(c.Database.DSN.Value()) != "" {
		return nil
	}
	switch {
	case strings.TrimSpace(c.Database.Host) == "":
		return errors.New("config: database.host is required")
	case c.Database.Port <= 0:
		return errors.New("config: database.port is required")
	case strings.TrimSpace(c.Database.User) == "":
		return errors.New("config: database.user is required (set it in config.yml, " + EnvDBUser + " or " + EnvDatabaseURL + ")")
	case strings.TrimSpace(c.Database.Name) == "":
		return errors.New("config: database.name is required (set it in config.yml or " + EnvDBName + ")")
	}
	return nil
}

// DSN returns the PostgreSQL connection string: the explicit dsn when set,
// otherwise one built from the individual fields. It is the one place the
// password is read, and the caller must not log the result.
func (c *Config) DSN() string {
	if dsn := strings.TrimSpace(c.Database.DSN.Value()); dsn != "" {
		return dsn
	}
	return (&url.URL{
		Scheme: "postgres",
		User:   url.UserPassword(c.Database.User, c.Database.Password.Value()),
		Host:   net.JoinHostPort(c.Database.Host, strconv.Itoa(c.Database.Port)),
		Path:   c.Database.Name,
	}).String()
}
