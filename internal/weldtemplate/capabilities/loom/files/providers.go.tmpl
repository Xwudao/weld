package di

import "github.com/Xwudao/loom"

// projectModule is the application's provider extension point. Declare custom
// services, repositories and third-party clients here, then run make generate.
// Every graph includes it; unused providers are pruned, so merely declaring a
// provider does not connect a client, construct a database pool or start workers.
//
// For example:
//
//	var projectModule = loom.Module(
//		loom.Provide(NewPaymentClient),
//		loom.As[data.Repository](NewRepository), // after weld add db
//	)
//
// Keep HTTP policies, event listeners and cron jobs in their dedicated DI
// wiring files. Keep service constructors free of registration side effects.
// This file is written once and never regenerated by weld add.
var projectModule = loom.Module()
