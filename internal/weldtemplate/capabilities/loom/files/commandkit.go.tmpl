// Package commandkit is the shared seam between a generated Cobra command group
// and the Loom dependency graph behind it.
//
// A command group resolves its dependencies lazily: it holds a Build function
// and calls Run from a subcommand's RunE, so building the root command, showing
// help or running an unrelated command never constructs the graph. Run starts
// the graph, hands the resolved dependencies to the subcommand and stops the
// graph within a bounded deadline, so a provider's cleanup always runs and a
// teardown failure is joined onto the subcommand's error.
//
// A command package depends on this file, not on the Loom runtime, so it never
// imports github.com/Xwudao/loom and its tests can supply a stub Build.
package commandkit

import (
	"context"
	"errors"
	"time"
)

// stopTimeout bounds lifecycle teardown after a subcommand has run, so a
// provider that registers an OnStop hook or a cleanup cannot hang the command.
const stopTimeout = 10 * time.Second

// Lifecycle is the start/stop contract of the resolved dependency graph. The
// generated graph's *loom.Lifecycle satisfies it; this package deliberately does
// not import Loom, so a command depends only on Start and Stop.
type Lifecycle interface {
	Start(context.Context) error
	Stop(context.Context) error
}

// Build resolves a group's dependencies on demand. internal/app delegates it to
// the generated internal/di initializer, so nothing a command package writes
// constructs the graph.
type Build[D any] func(context.Context) (D, Lifecycle, error)

// Run resolves the graph, starts it, runs fn with the resolved dependencies and
// stops it within a bounded deadline, joining any teardown failure onto fn's
// error. Call it once per subcommand, from RunE:
//
//	func newWidgetCommand(build commandkit.Build[*Deps]) *cobra.Command {
//		return &cobra.Command{
//			Use: "widget",
//			RunE: func(cmd *cobra.Command, args []string) error {
//				return commandkit.Run(cmd.Context(), build, func(ctx context.Context, deps *Deps) error {
//					// use deps, then return nil
//					return nil
//				})
//			},
//		}
//	}
func Run[D any](ctx context.Context, build Build[D], fn func(context.Context, D) error) (err error) {
	deps, lifecycle, err := build(ctx)
	if err != nil {
		return err
	}
	// Start the resolved graph before use. A failed start still gets a bounded
	// stop of whatever started, and both errors are preserved.
	if err := lifecycle.Start(ctx); err != nil {
		stopCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), stopTimeout)
		defer cancel()
		return errors.Join(err, lifecycle.Stop(stopCtx))
	}
	// Stop within a bounded deadline and join any stop failure onto the
	// subcommand's own error, so a failed teardown is never swallowed.
	defer func() {
		stopCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), stopTimeout)
		defer cancel()
		err = errors.Join(err, lifecycle.Stop(stopCtx))
	}()
	return fn(ctx, deps)
}
