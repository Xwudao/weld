// The tests here exercise the generated composition without PostgreSQL: the pool
// is only parsed (never connected) and only when a consumer asks for it, the
// lifecycle's bind, serve-failure and graceful-stop behavior is checked on
// loopback sockets.
//
// This file is regenerated with the installed capability set and is deliberately
// independent of the installed business modules: it never names a module, a
// module Service or a module fake. Each module package tests its own routes
// (internal/modules/<name>/module_test.go), so installing a module refreshes
// di.go and loom_gen.go but leaves this file unchanged. Keep module-specific
// assertions in the module's own test file, not here.
// fakeLoader builds a config.Loader over in-memory files and environment, so
// configuration tests never touch the filesystem or the process environment.
func fakeLoader(files, env map[string]string) *config.Loader {
	readFile := func(name string) ([]byte, error) {
		content, ok := files[name]
		if !ok {
			return nil, fs.ErrNotExist
		}
		return []byte(content), nil
	}
	lookupEnv := func(key string) (string, bool) {
		value, ok := env[key]
		return value, ok
	}
	return config.NewLoader(readFile, lookupEnv)
}

// baseLoader is a loader that satisfies NewConfig for the installed
// capabilities: an empty file and no environment, so the built-in defaults
// apply. Installing db does not change what NewConfig requires.
func baseLoader() *config.Loader {
	return fakeLoader(map[string]string{config.DefaultPath: ""}, nil)
}

func TestNewConfigDefaultsToLoopbackPort(t *testing.T) {
	cfg, err := NewConfig(context.Background(), baseLoader())
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.HTTP.Addr != ":8080" {
		t.Fatalf("HTTP.Addr = %q, want :8080", cfg.HTTP.Addr)
	}
}
