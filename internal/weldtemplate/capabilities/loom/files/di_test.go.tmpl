// TestNewConfigReadsDatabaseFromFile proves the database settings, including the
// password, come from the file when the environment does not override them.
func TestNewConfigReadsDatabaseFromFile(t *testing.T) {
	loader := fakeLoader(map[string]string{
		config.DefaultPath: "database:\n  host: db.example\n  port: 6543\n  user: app\n  password: file-secret\n  name: appdb\n",
	}, nil)
	cfg, err := NewConfig(context.Background(), loader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.Database.Host != "db.example" || cfg.Database.Port != 6543 {
		t.Fatalf("database = %+v", cfg.Database)
	}
	if cfg.Database.Password.Value() != "file-secret" {
		t.Fatal("the file password was not loaded")
	}
}

// TestNewConfigEnvironmentOverridesFile proves the environment outranks the file
// for the database settings too.
func TestNewConfigEnvironmentOverridesFile(t *testing.T) {
	loader := fakeLoader(
		map[string]string{config.DefaultPath: "database:\n  host: file-host\n  port: 5432\n  user: file-user\n  name: filedb\n"},
		map[string]string{config.EnvDBHost: "env-host", config.EnvDBUser: "env-user", config.EnvDBName: "envdb"},
	)
	cfg, err := NewConfig(context.Background(), loader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.Database.Host != "env-host" || cfg.Database.User != "env-user" || cfg.Database.Name != "envdb" {
		t.Fatalf("database = %+v, want the environment values", cfg.Database)
	}
}

// TestNewConfigNeedsNoDatabase proves installing db does not require a database
// credential to load configuration: NewPool validates the database section, not
// the graph root, so an unrelated command starts with no settings.
func TestNewConfigNeedsNoDatabase(t *testing.T) {
	cfg, err := NewConfig(context.Background(), fakeLoader(map[string]string{config.DefaultPath: ""}, nil))
	if err != nil {
		t.Fatalf("NewConfig without database settings: %v", err)
	}
	if cfg.HTTP.Addr != config.DefaultHTTPAddr {
		t.Fatalf("HTTP.Addr = %q, want %q", cfg.HTTP.Addr, config.DefaultHTTPAddr)
	}
}

// TestNewPoolRequiresDatabaseCredentials proves the credential check guards the
// pool, the one constructor that needs a database: constructing it without a
// database setting fails loudly rather than inventing a dsn.
func TestNewPoolRequiresDatabaseCredentials(t *testing.T) {
	pool, cleanup, err := NewPool(context.Background(), &config.Config{})
	if err == nil {
		t.Fatal("expected an error when the database has no credentials")
	}
	if pool != nil || cleanup != nil {
		t.Fatal("NewPool returned a pool or cleanup alongside an error")
	}
}

// TestNewPoolParsesWithoutConnecting proves the graph builds the pool without a
// running database (pgxpool parses the dsn lazily) and returns a cleanup that
// closes it exactly once.
func TestNewPoolParsesWithoutConnecting(t *testing.T) {
	cfg := &config.Config{Database: config.Database{
		Host: "localhost", Port: 5432, User: "app", Password: "pw", Name: "{{.Name}}",
	}}
	pool, cleanup, err := NewPool(context.Background(), cfg)
	if err != nil {
		t.Fatalf("NewPool: %v", err)
	}
	if pool == nil {
		t.Fatal("NewPool returned a nil pool")
	}
	if cleanup == nil {
		t.Fatal("NewPool returned no cleanup")
	}
	if err := cleanup(context.Background()); err != nil {
		t.Fatalf("cleanup: %v", err)
	}
	// The lifecycle calls a cleanup once, and it must stay safe if called again.
	if err := cleanup(context.Background()); err != nil {
		t.Fatalf("second cleanup: %v", err)
	}
}
