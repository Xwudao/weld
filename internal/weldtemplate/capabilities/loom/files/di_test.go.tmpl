// TestDocumentIncludesBusinessModules proves the module OpenAPI contract is
// merged into the composed document: each installed module's registered route
// appears with its method and its response schema, without hand-written
// documentation. It is the module-then-api and api-then-module acceptance path.
func TestDocumentIncludesBusinessModules(t *testing.T) {
	mux := newMuxWithAPI(&config.Config{Environment: config.EnvironmentDevelopment, OpenAPI: config.OpenAPI{Enabled: true}}, api.NewService(){{range .Modules}}, {{.Name}}FakeService{}{{end}})
	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/openapi.json", nil))
	if !api.OpenAPIBuildEnabled {
		if recorder.Code != nethttp.StatusNotFound {
			t.Fatalf("default build leaked document: HTTP %d", recorder.Code)
		}
		return
	}
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET /api/openapi.json = %d: %s", recorder.Code, recorder.Body)
	}
	var document struct {
		OpenAPI string `json:"openapi"`
		Paths   map[string]map[string]struct {
			OperationID string `json:"operationId"`
			Responses   map[string]struct {
				Content map[string]struct {
					Schema struct {
						Properties map[string]struct {
							Properties map[string]any `json:"properties"`
						} `json:"properties"`
					} `json:"schema"`
				} `json:"content"`
			} `json:"responses"`
		} `json:"paths"`
	}
	if err := json.Unmarshal(recorder.Body.Bytes(), &document); err != nil {
		t.Fatalf("decode document: %v", err)
	}
	if document.OpenAPI != "3.1.0" {
		t.Fatalf("openapi = %q, want 3.1.0", document.OpenAPI)
	}
	parsed, err := openapi3.NewLoader().LoadFromData(recorder.Body.Bytes())
	if err != nil {
		t.Fatalf("parse composed OpenAPI: %v", err)
	}
	if err := parsed.Validate(t.Context()); err != nil {
		t.Fatalf("validate composed OpenAPI: %v", err)
	}
	{{- range .Modules}}
	{
	module := document.Paths[{{.Name}}.RoutePrefix]
	operation, ok := module["get"]
	if !ok {
		t.Fatalf("%s is served by module {{.Name}} but is not documented", {{.Name}}.RoutePrefix)
	}
	if operation.OperationID == "" {
		t.Fatalf("%s has no operationId in the document", {{.Name}}.RoutePrefix)
	}
	data := operation.Responses["200"].Content["application/json"].Schema.Properties["data"].Properties
	if data["module"] == nil || data["message"] == nil {
		t.Fatalf("%s success data = %+v, want the module response fields", {{.Name}}.RoutePrefix, data)
	}
	}
	{{- end}}
}
{{- end}}
