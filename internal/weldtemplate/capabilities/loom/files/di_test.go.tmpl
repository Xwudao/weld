// newServerForTest builds a server against the installed graph providers,
// injecting a logger so the bind/serve lifecycle is exercised without
// PostgreSQL and without a global logger.{{if .Caps.Has "api"}}
// The API service is built through api.NewService rather than the graph's
// NewAPIService provider, so a user who edits that provider (for example to
// consume data.Repository) does not break this regenerated test.{{end}}{{if .Modules}}
// Each module is served through a fake built here, not its NewService, for the
// same reason.{{end}}
func newServerForTest(t *testing.T, lifecycle *loom.Lifecycle, addr string, logger *slog.Logger) *Server {
	t.Helper()
	server, err := NewServer(lifecycle, &config.Config{HTTP: config.HTTP{Addr: addr}}, logger{{if .Caps.Has "api"}}, api.NewService(){{end}}{{range .Modules}}, {{.Name}}FakeService{}{{end}})
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	return server
}

// discardLogger is the injected logger for lifecycle tests that do not assert
// on output.
func discardLogger() *slog.Logger {
	return logging.New(io.Discard, logging.TextFormat, nil)
}

// TestComposedServerAppliesMiddleware proves the Loom graph serves the project
// middleware chain: the graph wraps its mux with httpserver.Chain, so even a
// not-found response carries a request id. It needs no socket.
func TestComposedServerAppliesMiddleware(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	recorder := httptest.NewRecorder()
	server.HTTP.Handler.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/does-not-exist", nil))
	if recorder.Header().Get("X-Request-Id") == "" {
		t.Fatal("the Loom composition did not apply the middleware chain")
	}
}

// TestServerBindFailureFailsStart proves a port already in use fails Start
// instead of being swallowed by a background goroutine.
func TestServerBindFailureFailsStart(t *testing.T) {
	occupied, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listen: %v", err)
	}
	defer occupied.Close()

	lifecycle := loom.NewLifecycle()
	newServerForTest(t, lifecycle, occupied.Addr().String(), discardLogger())
	if err := lifecycle.Start(context.Background()); err == nil {
		t.Fatal("Start succeeded on an occupied port")
	}
}

// TestServerReportsRuntimeFailure proves a serve failure reaches the command
// instead of leaving it waiting forever.
func TestServerReportsRuntimeFailure(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	defer func() { _ = lifecycle.Stop(ctx) }()

	// Closing the bound listener directly is not a graceful shutdown, so Serve
	// returns an error rather than net/http.ErrServerClosed.
	if err := server.listener.Close(); err != nil {
		t.Fatalf("close listener: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err == nil {
			t.Fatal("expected a serve error, got nil")
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the serve failure")
	}
}

// TestServerStopsGracefully proves a normal stop ends the serving goroutine
// without reporting a failure.
func TestServerStopsGracefully(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err != nil {
			t.Fatalf("serve ended with %v, want nil after graceful shutdown", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
}

// TestServerLogsLifecycle proves the server logs through the injected logger:
// a buffer as the sink records the startup and shutdown transitions, and no
// global logger is involved.
func TestServerLogsLifecycle(t *testing.T) {
	var buf bytes.Buffer
	logger := logging.New(&buf, logging.TextFormat, nil)
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", logger)
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case <-server.Fail():
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
	out := buf.String()
	if !strings.Contains(out, "listening") {
		t.Fatalf("startup was not logged through the injected logger:\n%s", out)
	}
	if !strings.Contains(out, "shutting down") {
		t.Fatalf("shutdown was not logged through the injected logger:\n%s", out)
	}
{{- if .Caps.Has "api"}}
	if !strings.Contains(out, "in-memory") {
		t.Fatalf("the in-memory demo was not logged through the injected logger:\n%s", out)
	}
{{- end}}
}

{{- if .Caps.Has "api"}}
func TestComposedMuxServesAPIWithoutSocket(t *testing.T) {
	mux := newMux(api.NewService(){{range .Modules}}, {{.Name}}.NewService(){{end}})
	body := `{"name":"widget","quantity":2,"status":"active"}`
	request := httptest.NewRequest(nethttp.MethodPost, "/api/items", strings.NewReader(body))
	request.Header.Set("Content-Type", "application/json")
	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, request)
	if recorder.Code != nethttp.StatusCreated {
		t.Fatalf("POST /api/items = %d: %s", recorder.Code, recorder.Body)
	}
	var created api.ItemResponse
	if err := json.Unmarshal(envelopeData(t, recorder.Body.Bytes()), &created); err != nil {
		t.Fatalf("decode response data: %v", err)
	}
	recorder = httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/items/"+created.ID, nil))
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET /api/items/%s = %d", created.ID, recorder.Code)
	}
}

// envelopeData returns the data member of a {code,msg,data} response body, so a
// test can decode the payload the shared httpx envelope wraps.
func envelopeData(t *testing.T, raw []byte) json.RawMessage {
	t.Helper()
	var envelope struct {
		Data json.RawMessage `json:"data"`
	}
	if err := json.Unmarshal(raw, &envelope); err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	return envelope.Data
}

// TestComposedServerServesInMemoryAPI proves serving needs no database: the
// lifecycle binds a real loopback socket, a POST persists into the in-memory
// service and a GET reads it back. The address is ephemeral (:0), so the test
// never depends on a fixed port.
func TestComposedServerServesInMemoryAPI(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	defer func() { _ = lifecycle.Stop(ctx) }()

	base := "http://" + server.listener.Addr().String()
	created := postJSON(t, base+"/api/items", `{"name":"widget","quantity":2,"status":"active"}`)
	var item api.ItemResponse
	if err := json.Unmarshal(envelopeData(t, created), &item); err != nil {
		t.Fatalf("decode create response data: %v", err)
	}
	if item.ID == "" || item.Name != "widget" {
		t.Fatalf("created = %+v", item)
	}
	got := getJSON(t, base+"/api/items/"+item.ID)
	if !strings.Contains(string(got), item.ID) {
		t.Fatalf("GET did not return the created item: %s", got)
	}
}

func postJSON(t *testing.T, url, body string) []byte {
	t.Helper()
	resp, err := nethttp.Post(url, "application/json", strings.NewReader(body))
	if err != nil {
		t.Fatalf("POST %s: %v", url, err)
	}
	defer resp.Body.Close()
	raw, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatalf("read POST %s: %v", url, err)
	}
	if resp.StatusCode != nethttp.StatusCreated {
		t.Fatalf("POST %s = %d: %s", url, resp.StatusCode, raw)
	}
	return raw
}

func getJSON(t *testing.T, url string) []byte {
	t.Helper()
	resp, err := nethttp.Get(url)
	if err != nil {
		t.Fatalf("GET %s: %v", url, err)
	}
	defer resp.Body.Close()
	raw, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatalf("read GET %s: %v", url, err)
	}
	if resp.StatusCode != nethttp.StatusOK {
		t.Fatalf("GET %s = %d: %s", url, resp.StatusCode, raw)
	}
	return raw
}
