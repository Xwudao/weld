// TestComposedMuxOpenAPIDocumentGate pins the OpenAPI gate on the real
// composition the server serves: configuration in, HTTP decision out. The
// document is served only for an explicit development environment with the
// switch enabled; every other configuration — including a production
// environment mistakenly switched on and an unrecognized environment — answers
// 404 and leaks nothing.
func TestComposedMuxOpenAPIDocumentGate(t *testing.T) {
	enabled := config.OpenAPI{Enabled: true}
	cases := []struct {
		name    string
		cfg     *config.Config
		wantDoc bool
	}{
		{name: "unconfigured", cfg: &config.Config{}, wantDoc: false},
		{name: "development without the enable switch", cfg: &config.Config{Environment: config.EnvironmentDevelopment}, wantDoc: false},
		{name: "enabled without an environment", cfg: &config.Config{OpenAPI: enabled}, wantDoc: false},
		{name: "development opt-in", cfg: &config.Config{Environment: config.EnvironmentDevelopment, OpenAPI: enabled}, wantDoc: true},
		{name: "local opt-in", cfg: &config.Config{Environment: config.EnvironmentLocal, OpenAPI: enabled}, wantDoc: true},
		{name: "production misconfigured on is refused", cfg: &config.Config{Environment: config.EnvironmentProduction, OpenAPI: enabled}, wantDoc: false},
		{name: "unknown environment opt-in is refused", cfg: &config.Config{Environment: config.Environment("staging"), OpenAPI: enabled}, wantDoc: false},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			mux := newMuxWithAPI(tc.cfg, api.NewService(){{range .Modules}}, {{.Name}}FakeService{}{{end}})
			recorder := httptest.NewRecorder()
			mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/openapi.json", nil))
			if !tc.wantDoc || !api.OpenAPIBuildEnabled {
				if recorder.Code != nethttp.StatusNotFound {
					t.Fatalf("GET /api/openapi.json = %d, want 404: %s", recorder.Code, recorder.Body)
				}
				for _, marker := range []string{"openapi", "paths", "operationId"} {
					if strings.Contains(recorder.Body.String(), marker) {
						t.Fatalf("the refused endpoint leaked %q: %s", marker, recorder.Body)
					}
				}
				return
			}
			if recorder.Code != nethttp.StatusOK {
				t.Fatalf("GET /api/openapi.json = %d, want 200: %s", recorder.Code, recorder.Body)
			}
			var document struct {
				OpenAPI string `json:"openapi"`
			}
			if err := json.Unmarshal(recorder.Body.Bytes(), &document); err != nil {
				t.Fatalf("document is not JSON: %v", err)
			}
			if document.OpenAPI != "3.1.0" {
				t.Fatalf("openapi = %q, want 3.1.0", document.OpenAPI)
			}
		})
	}
}

// TestComposedMuxBusinessRoutesUnaffectedByOpenAPIGate proves the gate never
// touches the business routes: with a production configuration that refuses the
// document, the items API still serves.
func TestComposedMuxBusinessRoutesUnaffectedByOpenAPIGate(t *testing.T) {
	cfg := &config.Config{Environment: config.EnvironmentProduction, OpenAPI: config.OpenAPI{Enabled: true}}
	mux := newMuxWithAPI(cfg, api.NewService(){{range .Modules}}, {{.Name}}FakeService{}{{end}})
	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/items", nil))
	if recorder.Code != nethttp.StatusOK {
		t.Fatalf("GET /api/items = %d, want 200: %s", recorder.Code, recorder.Body)
	}
}

// TestComposedMuxOpenAPIGateUsesRealConfiguration proves the mux decision comes
// from the real loader path, not a parallel read: a development file with the
// switch on serves the document, and an environment override to production
// refuses it.
func TestComposedMuxOpenAPIGateUsesRealConfiguration(t *testing.T) {
	devLoader := fakeLoader(map[string]string{
		config.DefaultPath: "environment: development\nopenapi:\n  enabled: true\n",
	}, nil)
	devCfg, err := NewConfig(context.Background(), devLoader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	mux := newMuxWithAPI(devCfg, api.NewService(){{range .Modules}}, {{.Name}}FakeService{}{{end}})
	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/openapi.json", nil))
	wantStatus := nethttp.StatusNotFound
	if api.OpenAPIBuildEnabled {
		wantStatus = nethttp.StatusOK
	}
	if recorder.Code != wantStatus {
		t.Fatalf("development opt-in = %d, want %d: %s", recorder.Code, wantStatus, recorder.Body)
	}

	prodLoader := fakeLoader(
		map[string]string{config.DefaultPath: "environment: development\nopenapi:\n  enabled: true\n"},
		map[string]string{config.EnvAppEnv: "production"},
	)
	prodCfg, err := NewConfig(context.Background(), prodLoader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	mux = newMuxWithAPI(prodCfg, api.NewService(){{range .Modules}}, {{.Name}}FakeService{}{{end}})
	recorder = httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/api/openapi.json", nil))
	if recorder.Code != nethttp.StatusNotFound {
		t.Fatalf("production override = %d, want 404: %s", recorder.Code, recorder.Body)
	}
}
