// TestWithAddrOverridesConfig proves the command-line flag outranks the file.
func TestWithAddrOverridesConfig(t *testing.T) {
	loader := fakeLoader(map[string]string{config.DefaultPath: "http:\n  addr: \":9999\"\n"}, nil)
	cfg, err := NewConfig(WithAddr(context.Background(), "127.0.0.1:0"), loader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.HTTP.Addr != "127.0.0.1:0" {
		t.Fatalf("HTTP.Addr = %q, want 127.0.0.1:0", cfg.HTTP.Addr)
	}
}

func TestNewConfigRejectsBlankAddr(t *testing.T) {
	if _, err := NewConfig(WithAddr(context.Background(), "  "), baseLoader()); err == nil {
		t.Fatal("expected an error for a blank listen address")
	}
}

// newServerForTest builds the managed server through the generated seam with an
// injected logger and an empty handler, so the bind, serve-failure and
// graceful-stop lifecycle is exercised without a database, without a global
// logger and without any installed business module.
func newServerForTest(t *testing.T, lifecycle *loom.Lifecycle, addr string, logger logging.Logger) *Server {
	t.Helper()
	server, err := newServer(lifecycle, &config.Config{HTTP: config.HTTP{Addr: addr}}, logger, nethttp.NewServeMux())
	if err != nil {
		t.Fatalf("newServer: %v", err)
	}
	return server
}

// TestDevelopmentLogsTheComposedRoutes proves logRoutes logs every registered
// route in a development environment and stays silent in production. It builds
// the router directly, so it needs no module.
func TestDevelopmentLogsTheComposedRoutes(t *testing.T) {
	var buf bytes.Buffer
	logger := logging.New(&buf, logging.TextFormat, &logging.Options{NoColor: true})
	router := httpx.NewRouter(nethttp.NewServeMux())
	router.Get("/ping", func(nethttp.ResponseWriter, *nethttp.Request) {})

	logRoutes(&config.Config{Environment: config.EnvironmentLocal}, logger, router)
	out := buf.String()
	if !strings.Contains(out, "registered routes") || !strings.Contains(out, "/ping") {
		t.Fatalf("a development composition did not log its routes:\n%s", out)
	}

	buf.Reset()
	logRoutes(&config.Config{Environment: config.EnvironmentProduction}, logger, router)
	if buf.Len() != 0 {
		t.Fatalf("a production composition logged its routes:\n%s", buf.String())
	}
}

// TestComposedServerAppliesMiddleware proves the generated server serves the
// project middleware chain: newServer wraps its handler with httpserver.Chain,
// so even a not-found response carries a request id. It needs no socket.
func TestComposedServerAppliesMiddleware(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	recorder := httptest.NewRecorder()
	server.HTTP.Handler.ServeHTTP(recorder, httptest.NewRequest(nethttp.MethodGet, "/does-not-exist", nil))
	if recorder.Header().Get("X-Request-Id") == "" {
		t.Fatal("the generated server did not apply the middleware chain")
	}
}

// TestServerBindFailureFailsStart proves a port already in use fails Start
// instead of being swallowed by a background goroutine.
func TestServerBindFailureFailsStart(t *testing.T) {
	occupied, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listen: %v", err)
	}
	defer occupied.Close()

	lifecycle := loom.NewLifecycle()
	newServerForTest(t, lifecycle, occupied.Addr().String(), discardLogger())
	if err := lifecycle.Start(context.Background()); err == nil {
		t.Fatal("Start succeeded on an occupied port")
	}
}

// TestServerReportsRuntimeFailure proves a serve failure reaches the command
// instead of leaving it waiting forever.
func TestServerReportsRuntimeFailure(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	defer func() { _ = lifecycle.Stop(ctx) }()

	// Closing the bound listener directly is not a graceful shutdown, so Serve
	// returns an error rather than net/http.ErrServerClosed.
	if err := server.listener.Close(); err != nil {
		t.Fatalf("close listener: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err == nil {
			t.Fatal("expected a serve error, got nil")
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the serve failure")
	}
}

// TestServerStopsGracefully proves a normal stop ends the serving goroutine
// without reporting a failure.
func TestServerStopsGracefully(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err != nil {
			t.Fatalf("serve ended with %v, want nil after graceful shutdown", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
}

// TestServerLogsLifecycle proves the server logs through the injected logger:
// a buffer as the sink records the startup and shutdown transitions, and no
// global logger is involved.
func TestServerLogsLifecycle(t *testing.T) {
	var buf bytes.Buffer
	logger := logging.New(&buf, logging.TextFormat, &logging.Options{NoColor: true})
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", logger)
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case <-server.Fail():
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
	out := buf.String()
	if !strings.Contains(out, "listening") {
		t.Fatalf("startup was not logged through the injected logger:\n%s", out)
	}
	if !strings.Contains(out, "shutting down") {
		t.Fatalf("shutdown was not logged through the injected logger:\n%s", out)
	}
}
{{if .Caps.Has "cron"}}
// TestSchedulerStartsAfterTheServerAndStopsFirst proves the graph wiring: the
// server binds its socket before the scheduler starts, and the scheduler stops
// before the server shuts down. Both transitions are read from the injected
// logger, so the ordering is the real hook order rather than an assumption.
func TestSchedulerStartsAfterTheServerAndStopsFirst(t *testing.T) {
	var buf bytes.Buffer
	logger := logging.New(&buf, logging.TextFormat, &logging.Options{NoColor: true})
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", logger)
	cfg := &config.Config{
		HTTP: config.HTTP{Addr: "127.0.0.1:0"},
		Cron: config.Cron{Timezone: "UTC"},
	}
	if _, err := NewScheduler(lifecycle, cfg, logger, server, nil); err != nil {
		t.Fatalf("NewScheduler: %v", err)
	}

	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}

	out := buf.String()
	listen := strings.Index(out, "listening")
	started := strings.Index(out, "cron scheduler started")
	stopped := strings.Index(out, "cron scheduler stopped")
	shutting := strings.Index(out, "shutting down")
	if listen < 0 || started < 0 || stopped < 0 || shutting < 0 {
		t.Fatalf("the lifecycle was not logged through the injected logger:\n%s", out)
	}
	if listen > started {
		t.Fatalf("the scheduler started before the server bound its socket:\n%s", out)
	}
	if stopped > shutting {
		t.Fatalf("the scheduler did not stop before the server shut down:\n%s", out)
	}
}
