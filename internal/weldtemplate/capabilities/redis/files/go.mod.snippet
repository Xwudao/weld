	// weld:redis:installed __version__
	// go-redis is the Redis client the generated redisclient package builds.
	// miniredis is an in-process RESP server used only by tests, so building and
	// testing the project needs no external Redis.
	require github.com/redis/go-redis/v9 v9.17.1
	require github.com/alicebob/miniredis/v2 v2.39.0
