{
  "name": "storage",
  "version": "0.1.0",
  "kind": "add",
  "summary": "Opt-in S3-compatible object-storage client: typed connection configuration and an explicit streaming client the caller owns. Installing it creates no bucket and uploads nothing.",
  "requires": ["loom"],
  "files": [
    { "path": "internal/config/storage.go", "source": "files/storage_config.go.tmpl" },
    { "path": "internal/config/storage_test.go", "source": "files/storage_config_test.go.tmpl" },
    { "path": "internal/objectstore/objectstore.go", "source": "files/objectstore.go.tmpl" },
    { "path": "internal/objectstore/objectstore_test.go", "source": "files/objectstore_test.go.tmpl" },
    { "path": "internal/objectstore/README.md", "source": "files/README.md" },
    { "path": "internal/di/storage_provider.go", "source": "files/storage_provider.go.tmpl", "when": ["loom"] }
  ],
  "patches": [
    { "path": "go.mod", "marker": "deps", "source": "files/go.mod.snippet" },
    { "path": "go.mod", "marker": "goversion", "mode": "replace", "source": "files/goversion.snippet" },
    { "path": "config.yml", "marker": "config", "source": "files/config.snippet", "bootstrap": "config.example.yml" },
    { "path": "config.example.yml", "marker": "config", "source": "files/config.snippet" },
    { "path": "internal/config/config.go", "marker": "configfields", "source": "files/config_fields.snippet" },
    { "path": "internal/config/config.go", "marker": "configenv", "source": "files/config_env.snippet" },
    { "path": "internal/config/config.go", "marker": "configdefaults", "source": "files/config_defaults.snippet" }
  ]
}
