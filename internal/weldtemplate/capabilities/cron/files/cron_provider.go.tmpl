package di

import (
	"context"
	"errors"
	"log/slog"

	"github.com/Xwudao/loom"

	"__module__/internal/config"
	"__module__/internal/cron"
)

// This file is the stable integration seam for wiring the cron scheduler into
// the Loom application. weld writes it once, when both the cron and loom
// capabilities are installed, and never rewrites it while it regenerates the
// graph (di.go, loom_gen.go): edits below survive every later `weld add`.
//
// It has two providers. NewCronDeps builds the dependency bundle every job
// receives; NewScheduler builds the scheduler itself.

// NewCronDeps constructs the dependency bundle the server graph binds and hands
// to every scheduled job, and this is the seam for wiring dependencies into
// jobs.
//
// Add a field to cron.Deps (internal/cron/deps.go) for each dependency your jobs
// use, and consume it here so Loom constructs it:
//
//	func NewCronDeps(logger *slog.Logger, publisher events.Publisher) *cron.Deps {
//		return &cron.Deps{Logger: logger, Publisher: publisher}
//	}
//
// The parameters are deliberate: Loom resolves each one only because this
// provider consumes it, so a job that publishes makes the graph construct
// events.Publisher, and a job that needs nothing adds no dependency at all.
// internal/cron/register.go reads the bundle from its job's second parameter.
func NewCronDeps(logger *slog.Logger) *cron.Deps {
	return &cron.Deps{Logger: logger}
}

// NewScheduler is the cron scheduler provider the Loom graph binds.
//
// The graph's root consumes the returned *cron.Scheduler, so Loom constructs
// this provider and its lifecycle hooks are registered; without that consumer
// Loom would prune the provider and nothing would start.
//
// server is a deliberate dependency, not an unused parameter: Loom constructs
// providers in dependency order and appends each lifecycle hook as it
// constructs the provider, so taking the server here makes the graph bind the
// HTTP socket before the scheduler starts and stop the scheduler before the
// server shuts down. Hooks run in registration order on start and reverse order
// on stop.
//
// deps is passed through to every job (cron.WithDeps), so jobs receive the
// bundle NewCronDeps built. The scheduler starts no work by itself:
// internal/cron/register.go is the stable, user-editable file where the
// application's jobs are registered, and it registers none by default. The
// scheduler takes no database or Redis lock, so several replicas each run their
// own copy of every job.
func NewScheduler(lc *loom.Lifecycle, cfg *config.Config, logger *slog.Logger, server *Server, deps *cron.Deps) (*cron.Scheduler, error) {
	location, err := cfg.Cron.Location()
	if err != nil {
		return nil, err
	}
	scheduler := cron.New(logger, cron.WithLocation(location), cron.WithDeps(deps))
	if err := cron.Register(scheduler); err != nil {
		return nil, err
	}
	lc.Append(loom.Hook{
		OnStart: func(ctx context.Context) error {
			scheduler.Start(ctx)
			logger.Info("__name__ cron scheduler started")
			return nil
		},
		OnStop: func(ctx context.Context) error {
			if err := scheduler.Stop(ctx); err != nil && !errors.Is(err, context.Canceled) {
				return err
			}
			logger.Info("__name__ cron scheduler stopped")
			return nil
		},
	})
	return scheduler, nil
}
