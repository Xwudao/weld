{
  "name": "cron",
  "version": "0.3.0",
  "kind": "add",
  "summary": "Opt-in in-process scheduler: a named job registry with explicit Start/Stop, five-field cron specs or fixed intervals (Every, DailyAt, WeeklyOn, MonthlyOn), overlap skipping, panic recovery and a UTC-default timezone. Jobs receive a Deps bundle, the seam for injecting application dependencies. Installing it schedules nothing on its own; the scheduler starts and stops with the serve command through the Loom graph and jobs are declared in a stable registration file.",
  "requires": ["http"],
  "files": [
    { "path": "internal/cron/cron.go", "source": "files/cron.go.tmpl" },
    { "path": "internal/cron/deps.go", "source": "files/deps.go.tmpl", "role": "seam" },
    { "path": "internal/cron/cron_test.go", "source": "files/cron_test.go.tmpl" },
    { "path": "internal/cron/register.go", "source": "files/register.go.tmpl", "role": "seam" },
    { "path": "internal/cron/README.md", "source": "files/README.md" },
    { "path": "internal/config/cron.go", "source": "files/cron_config.go.tmpl" },
    { "path": "internal/config/cron_test.go", "source": "files/cron_config_test.go.tmpl" },
    { "path": "internal/di/cron_provider.go", "source": "files/cron_provider.go.tmpl", "role": "seam", "when": ["loom"] }
  ],
  "patches": [
    { "path": "go.mod", "marker": "deps", "source": "files/go.mod.snippet" },
    { "path": "config.yml", "marker": "config", "source": "files/config.snippet", "bootstrap": "config.example.yml" },
    { "path": "config.example.yml", "marker": "config", "source": "files/config.snippet" },
    { "path": "internal/config/config.go", "marker": "configfields", "source": "files/config_fields.snippet" },
    { "path": "internal/config/config.go", "marker": "configenv", "source": "files/config_env.snippet" },
    { "path": "internal/config/config.go", "marker": "configdefaults", "source": "files/config_defaults.snippet" }
  ]
}
