	// weld:sqlcx:installed __version__
	// go-sqlcx is the runtime of the generated internal/data/sqlc/dynamic
	// package: type-safe dynamic SELECT/UPDATE/INSERT/DELETE over the models
	// sqlc generates. It requires pgx v5.9.2, so the toolchain raises the pgx
	// requirement the db capability pinned for an older Go floor in place.
	require github.com/Xwudao/go-sqlcx v0.2.0
