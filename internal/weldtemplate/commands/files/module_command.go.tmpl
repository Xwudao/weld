// Package __modname__ is a generated command group for __name__.
//
// `weld add module __modname__ --command` exposes the __modname__ business
// module on the command line. It receives the same Service interface the HTTP
// handler uses, so the command and the HTTP handler share one business layer.
// weld writes this file once; later adds never overwrite your subcommands.
package __modname__

import (
	"context"
	"fmt"
	"log/slog"

	"github.com/spf13/cobra"

	"__module__/internal/commandkit"
	module "__module__/internal/modules/__modname__"
)

// Deps is the dependency set the group's subcommands consume and the root of the
// command's Loom graph.
//
// Service is the module's business layer, the same interface the HTTP handler
// uses, so a subcommand and a route share one implementation. Add one field for
// each further dependency a subcommand needs and the matching parameter to
// NewDeps. There are two cases:
//
//   - A dependency the shared commonModule already provides needs nothing else.
//     That covers *config.Config, *slog.Logger and, when installed,
//     data.Repository and the Redis, mail and storage bindings: Loom injects
//     them and prunes them until a subcommand consumes them.
//   - A dependency no provider declares needs a provider in
//     internal/di/__modname___graph.go, for example loom.Provide(NewThing), with
//     the same field here and the same parameter on NewDeps.
//
// Logger is the worked example: the status subcommand below reads it, so it
// shows how a second field is added. Drop it if the group does not need it.
type Deps struct {
	Service module.Service
	Logger  *slog.Logger
}

// NewDeps builds the dependency set from the dependencies the graph injects.
// module.NewService is provided by the command graph; the logger comes from the
// shared commonModule. Add one parameter per field added to Deps.
func NewDeps(service module.Service, logger *slog.Logger) *Deps {
	return &Deps{Service: service, Logger: logger}
}

// NewCommand builds the module's Cobra command group from a lazy dependency
// builder. A subcommand resolves it through commandkit.Run on execution, so
// building the root command (or showing help) never constructs the module's
// dependencies.
func NewCommand(build commandkit.Build[*Deps]) *cobra.Command {
	root := &cobra.Command{
		Use:   "__modname__",
		Short: "the __modname__ business module on the command line",
		Args:  cobra.NoArgs,
		RunE:  func(cmd *cobra.Command, args []string) error { return cmd.Help() },
	}
	root.AddCommand(newGreetCommand(build), newStatusCommand(build))
	return root
}

// newGreetCommand is the focused example that demonstrates the seam: it calls
// the module's Greet through the lazily resolved graph, so the command and the
// HTTP handler share one Service. Replace or extend it with real subcommands.
func newGreetCommand(build commandkit.Build[*Deps]) *cobra.Command {
	return &cobra.Command{
		Use:   "greet [name]",
		Short: "greet someone through the module's service",
		Args:  cobra.MaximumNArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			name := ""
			if len(args) > 0 {
				name = args[0]
			}
			return commandkit.Run(cmd.Context(), build, func(ctx context.Context, deps *Deps) error {
				response, err := deps.Service.Greet(ctx, module.Request{Name: name})
				if err != nil {
					return err
				}
				fmt.Fprintln(cmd.OutOrStdout(), response.Message)
				return nil
			})
		},
	}
}

// newStatusCommand is the worked example for adding a dependency: it reads
// Deps.Logger, so it shows how a field added to Deps above flows from the graph
// through NewDeps into a subcommand. Copy it (adding the field) to use your own
// dependency.
func newStatusCommand(build commandkit.Build[*Deps]) *cobra.Command {
	return &cobra.Command{
		Use:   "status",
		Short: "report through the resolved dependency graph",
		Args:  cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
			return commandkit.Run(cmd.Context(), build, func(ctx context.Context, deps *Deps) error {
				deps.Logger.Info("__modname__ status", "module", "__modname__")
				fmt.Fprintln(cmd.OutOrStdout(), "__modname__ ok")
				return nil
			})
		},
	}
}
