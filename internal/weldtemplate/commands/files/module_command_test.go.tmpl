package __modname__
{{if .Caps.Has "loom"}}

import (
	"bytes"
	"context"
	"strings"
	"testing"

	"github.com/spf13/cobra"

	module "__module__/internal/modules/__modname__"
)

// stubLifecycle records that the resolved graph was started and stopped.
type stubLifecycle struct {
	started bool
	stopped bool
}

func (l *stubLifecycle) Start(context.Context) error { l.started = true; return nil }
func (l *stubLifecycle) Stop(context.Context) error  { l.stopped = true; return nil }

// TestNewCommandBuildsGroup checks the generated factory builds the command
// group from the module's Service, exposes the focused greet seam, and rejects
// an unknown subcommand.
func TestNewCommandBuildsGroup(t *testing.T) {
	cmd := NewCommand(func(context.Context) (*Deps, Lifecycle, error) {
		return NewDeps(module.NewDemoService()), &stubLifecycle{}, nil
	})
	if cmd.Name() != "__modname__" {
		t.Fatalf("command name = %q, want %q", cmd.Name(), "__modname__")
	}
	if findCommand(cmd, "greet") == nil {
		t.Fatal("the focused greet seam is missing")
	}
	cmd.SilenceErrors = true
	cmd.SilenceUsage = true
	cmd.SetArgs([]string{"definitely-not-a-subcommand"})
	if err := cmd.Execute(); err == nil {
		t.Fatal("an unknown subcommand unexpectedly succeeded")
	}
}

// TestGreetUsesTheResolvedSeam proves a real subcommand resolves the graph,
// calls the module's Service through it, and stops the lifecycle afterwards.
func TestGreetUsesTheResolvedSeam(t *testing.T) {
	lifecycle := &stubLifecycle{}
	cmd := NewCommand(func(context.Context) (*Deps, Lifecycle, error) {
		return NewDeps(module.NewDemoService()), lifecycle, nil
	})
	var out bytes.Buffer
	cmd.SetOut(&out)
	cmd.SetArgs([]string{"greet", "Ada"})
	if err := cmd.Execute(); err != nil {
		t.Fatalf("greet: %v", err)
	}
	if !lifecycle.started || !lifecycle.stopped {
		t.Fatalf("lifecycle started/stopped = %v/%v, want true/true", lifecycle.started, lifecycle.stopped)
	}
	if !strings.Contains(out.String(), "Ada") {
		t.Fatalf("greet output = %q, want it to greet Ada", out.String())
	}
}

// findCommand returns the named direct subcommand, or nil.
func findCommand(cmd *cobra.Command, name string) *cobra.Command {
	for _, sub := range cmd.Commands() {
		if sub.Name() == name {
			return sub
		}
	}
	return nil
}
