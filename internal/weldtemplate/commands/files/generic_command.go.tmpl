// Package __modname__ is a generated command group for __name__.
//
// `weld add command __modname__` generated this package once and recorded every
// file in weld.json. weld never regenerates it, so your edits survive later
// `weld add` commands.
//
// It is an independent root command: it needs no HTTP server and starts no
// long-running work. A bare invocation shows help rather than constructing its
// dependencies. Add subcommands with cmd.AddCommand to give the group real
// behaviour.
//
// internal/app/__modname___command.go supplies Build from the command-specific
// Loom graph (internal/di/__modname___graph.go). A real subcommand resolves the
// graph lazily through internal/commandkit, so a bare `__modname__`, `help`,
// `version` and every unrelated command never construct the group's
// dependencies.
package __modname__

import (
	"context"
	"fmt"
	"log/slog"

	"github.com/spf13/cobra"

	"__module__/internal/commandkit"
)

// Deps is the dependency set the group's subcommands consume and the root of the
// command's Loom graph.
//
// Add one field for each dependency a subcommand needs and the matching
// parameter to NewDeps. There are two cases:
//
//   - A dependency the shared commonModule already provides needs nothing else.
//     That covers *config.Config, *slog.Logger and, when installed,
//     data.Repository and the Redis, mail and storage bindings: Loom injects
//     them and prunes them until a subcommand consumes them.
//   - A dependency no provider declares needs a provider in
//     internal/di/__modname___graph.go, for example loom.Provide(NewThing), with
//     the same field here and the same parameter on NewDeps.
//
// Logger is the worked example: the status subcommand below reads it, so
// resolving the graph constructs the shared logger and nothing else. Replace it
// with your own dependency, or delete it and its subcommand.
type Deps struct {
	Logger *slog.Logger
}

// NewDeps builds the dependency set from the dependencies the graph injects. Add
// one parameter per field added to Deps; the graph follows the signature
// automatically, so no other file changes.
func NewDeps(logger *slog.Logger) *Deps { return &Deps{Logger: logger} }

// NewCommand builds the __modname__ command group from a lazy dependency
// builder. The builder is not called here: a subcommand resolves it through
// commandkit.Run on execution, so building the root command (or showing help)
// never constructs the group's dependencies.
func NewCommand(build commandkit.Build[*Deps]) *cobra.Command {
	root := &cobra.Command{
		Use:   "__modname__",
		Short: "the __modname__ command group",
		Args:  cobra.NoArgs,
		RunE:  func(cmd *cobra.Command, args []string) error { return cmd.Help() },
	}
	root.AddCommand(newStatusCommand(build))
	return root
}

// newStatusCommand is the worked example for talking to a dependency: it reads
// Deps.Logger, so it shows how a field added to Deps above flows from the graph
// through NewDeps into a subcommand. Copy it (and the field) to use your own
// dependency:
//
//	func newExampleCommand(build commandkit.Build[*Deps]) *cobra.Command {
//		return &cobra.Command{
//			Use: "example",
//			RunE: func(cmd *cobra.Command, args []string) error {
//				return commandkit.Run(cmd.Context(), build, func(ctx context.Context, deps *Deps) error {
//					// use ctx and deps, then return nil
//					return nil
//				})
//			},
//		}
//	}
func newStatusCommand(build commandkit.Build[*Deps]) *cobra.Command {
	return &cobra.Command{
		Use:   "status",
		Short: "report through the resolved dependency graph",
		Args:  cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
			return commandkit.Run(cmd.Context(), build, func(ctx context.Context, deps *Deps) error {
				deps.Logger.Info("__modname__ status", "graph", "resolved")
				fmt.Fprintln(cmd.OutOrStdout(), "__modname__ ok")
				return nil
			})
		},
	}
}
